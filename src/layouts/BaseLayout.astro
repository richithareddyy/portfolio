---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-400-italic.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
import serif from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import serifItalic from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-italic.woff2?url';
import sans from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  /** Path the header nav links resolve against. Home uses in-page anchors. */
  isHome?: boolean;
  noindex?: boolean;
}

const { title, description = profile.description, isHome = false, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name} · Data Science and Applied AI`;
const path = Astro.url.pathname.length > 1 ? Astro.url.pathname.replace(/\/$/, '') : '/';
const canonical = new URL(path, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: Astro.site?.href,
  image: ogImage.href,
  email: `mailto:${profile.email}`,
  jobTitle: 'Zoom Fellow',
  worksFor: { '@type': 'Organization', name: 'ASU Next Lab' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Arizona State University' },
    { '@type': 'CollegeOrUniversity', name: 'Anurag University' },
  ],
  address: { '@type': 'PostalAddress', addressLocality: 'Tempe', addressRegion: 'AZ', addressCountry: 'US' },
  knowsAbout: ['Data science', 'Machine learning', 'Causal inference', 'Time series forecasting', 'Applied AI'],
  sameAs: [profile.links.github, profile.links.linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={isHome ? 'website' : 'article'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}: data science and applied AI`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f3ecdf" />
    <!-- The hero is set in these three; fetching them early keeps the text from reflowing when they arrive. -->
    <link rel="preload" href={serif} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifItalic} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sans} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
    <script is:inline>
      // Apply the saved pen color before the first paint, and let the marks animate only when scripts run.
      document.documentElement.classList.add('js');
      try {
        const pen = localStorage.getItem('pen');
        if (pen && pen !== 'blue') document.documentElement.dataset.pen = pen;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader isHome={isHome} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import '../scripts/interactions';
    </script>

  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: -100px;
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    background: var(--color-ink);
    color: var(--color-bg);
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .skip-link:focus {
    top: var(--space-3);
  }

  main:focus {
    outline: none;
  }
</style>
