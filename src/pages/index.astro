---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import ProjectRow from '../components/ProjectRow.astro';
import ProjectMap from '../components/ProjectMap.astro';
import Experience from '../components/Experience.astro';
import Skills from '../components/Skills.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import { featured, more } from '../data/projects';
---

<BaseLayout isHome>
  <div data-page="home">
    <Hero />

    <section id="work" class="wrap" aria-labelledby="work-title">
      <SectionHeading id="work">Featured work</SectionHeading>

      {featured.map((p, i) => <FeaturedProject project={p} eager={i === 0} />)}

      <div class="more">
        <div class="more-head">
          <h3 class="more-title">Additional work</h3>
          <p class="more-note">Smaller projects across ML, NLP, and web systems. Case studies where there is more to say.</p>
        </div>
        <div class="cards">
          {more.map((p) => <ProjectRow project={p} />)}
        </div>
      </div>

      <div class="explore">
        <div class="explore-head">
          <h3 class="more-title">Explore all projects</h3>
          <p class="more-note">All eight projects on one map. Select a point to see its stack and jump to it.</p>
        </div>
        <ProjectMap />
      </div>
    </section>

    <Experience />
    <Skills />
    <About />
    <Contact />
  </div>
</BaseLayout>

<style>
  .more,
  .explore {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .explore :global(.project-map) {
    max-width: 52rem;
  }

  .more-title {
    font-size: var(--text-xl);
    font-weight: 500;
  }

  .more-note {
    max-width: 60ch;
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: var(--space-7);
    border-bottom: var(--border-hairline);
  }

  @media (min-width: 48rem) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
