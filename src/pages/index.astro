---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import ProjectRow from '../components/ProjectRow.astro';
import Experience from '../components/Experience.astro';
import Skills from '../components/Skills.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import { featured, more } from '../data/projects';
---

<BaseLayout isHome>
  <div data-page="home">
    <Hero />

    <section id="work" class="wrap" aria-labelledby="work-title">
      <SectionHeading id="work" note="each one starts with the problem, then the engineering. limits are in the case studies.">
        Things I’ve <em>built</em>
      </SectionHeading>

      {featured.map((p, i) => <FeaturedProject project={p} index={i} eager={i === 0} />)}

      <div class="more">
        <div class="more-head">
          <h3 class="more-title">Also in the notebook</h3>
          <p class="note">smaller projects. still real code, still measured where I could.</p>
        </div>
        <div class="rows">
          {more.map((p) => <ProjectRow project={p} />)}
        </div>
      </div>
    </section>

    <Experience />
    <Skills />
    <About />
    <Contact />
  </div>
</BaseLayout>

<style>
  .more {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-9);
  }

  .more-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-5);
  }

  .more-title {
    font-size: var(--text-2xl);
    font-weight: 450;
  }

  .rows {
    border-top: var(--border-ink);
  }
</style>
