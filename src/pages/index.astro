---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import ProjectRow from '../components/ProjectRow.astro';
import Experience from '../components/Experience.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import { featured, more } from '../data/projects';
import { profile } from '../data/profile';
---

<BaseLayout isHome>
  <div data-page="home">
    <Hero />

    <section id="work" class="wrap" aria-labelledby="work-title">
      <SectionHeading id="work" note="three I’d show first. each opens with the problem; the limits are in the case studies.">
        Selected <em>work</em>
      </SectionHeading>

      {featured.map((p, i) => <FeaturedProject project={p} index={i} eager={i === 0} />)}

      <div class="more">
        <div class="more-head">
          <h3 class="more-title">Also in the notebook</h3>
          <p class="note">smaller, still measured.</p>
        </div>
        <div class="rows">
          {more.map((p) => <ProjectRow project={p} />)}
        </div>
        <a class="elsewhere arrow-link" href={profile.links.github} target="_blank" rel="me noopener">
          View everything on GitHub <span class="arrow" aria-hidden="true">→</span><span class="visually-hidden"> (opens in a new tab)</span>
        </a>
      </div>
    </section>

    <Experience />
    <About />
    <Contact />
  </div>
</BaseLayout>

<style>
  .more {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-9);
  }

  .more-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-5);
  }

  .more-title {
    font-size: var(--text-2xl);
    font-weight: 450;
  }

  .rows {
    border-top: var(--border-ink);
  }

  .elsewhere {
    justify-self: start;
    font-size: var(--text-sm);
  }
</style>
