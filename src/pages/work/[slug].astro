---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseHeader from '../../components/CaseHeader.astro';
import CaseSection from '../../components/CaseSection.astro';
import BulletList from '../../components/BulletList.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import Metrics from '../../components/Metrics.astro';
import DecisionList from '../../components/DecisionList.astro';
import EvidenceLinks from '../../components/EvidenceLinks.astro';
import NextProject from '../../components/NextProject.astro';
import { caseStudies, type Project } from '../../data/projects';

export function getStaticPaths() {
  // Zoom Lens has its own page.
  return caseStudies
    .filter((p) => p.slug !== 'zoom-lens')
    .map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const sections = [
  { id: 'problem', label: 'Problem' },
  { id: 'contribution', label: 'My contribution' },
  { id: 'decisions', label: 'Decisions' },
  { id: 'evaluation', label: 'Evaluation' },
  { id: 'limitations', label: project.next ? 'Limitations and next steps' : 'Limitations' },
];
---

<BaseLayout title={project.title} description={project.summary}>
  <div data-page="project">
    <CaseHeader project={project} sections={sections} />

    <div class="wrap">
      <div class="lead-visual">
        <ProjectVisual visual={project.visual} size="full" eager />
      </div>

      <CaseSection title="Problem and constraints" id="problem">
        <p>{project.problem}</p>
        {project.constraints && <BulletList items={project.constraints} />}
      </CaseSection>

      <CaseSection title="My contribution" id="contribution">
        <p>{project.contribution}</p>
        {project.built && <BulletList items={project.built} />}
        {project.stack && (
          <ul class="stack" aria-label="Full stack">
            {project.stack.map((s) => <li>{s}</li>)}
          </ul>
        )}
      </CaseSection>

      {
        project.decisions && (
          <CaseSection title="Decisions and tradeoffs" id="decisions">
            <DecisionList items={project.decisions} />
          </CaseSection>
        )
      }

      {
        project.evaluation && (
          <CaseSection title="Evaluation" id="evaluation">
            <h3>Method</h3>
            <BulletList items={project.evaluation.method} />
            <Metrics metrics={project.evaluation.metrics} />
            <EvidenceLinks links={project.evaluation.evidence} />
          </CaseSection>
        )
      }

      <CaseSection title={project.next ? 'Limitations and next steps' : 'Limitations'} id="limitations">
        {project.limitations && <BulletList items={project.limitations} />}
        {project.next && (
          <>
            <h3>Next steps</h3>
            <BulletList items={project.next} />
          </>
        )}
      </CaseSection>

      {
        project.gallery && (
          <CaseSection title="More screens" id="gallery">
            <div class="gallery">
              {project.gallery.map((v) => (
                <ProjectVisual visual={v} size="full" />
              ))}
            </div>
          </CaseSection>
        )
      }
    </div>

    <NextProject slug={project.slug} />
  </div>
</BaseLayout>

<style>
  .lead-visual {
    max-width: 60rem;
    padding-bottom: var(--space-6);
  }

  .gallery {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
  }

  @media (min-width: 60rem) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
