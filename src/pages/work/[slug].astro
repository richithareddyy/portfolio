---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseHeader from '../../components/CaseHeader.astro';
import CaseSection from '../../components/CaseSection.astro';
import BulletList from '../../components/BulletList.astro';
import Metrics from '../../components/Metrics.astro';
import NextProject from '../../components/NextProject.astro';
import CodeAtlasFigure from '../../components/CodeAtlasFigure.astro';
import PipelineFigure from '../../components/PipelineFigure.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const figures: Record<string, typeof CodeAtlasFigure> = {
  codeatlas: CodeAtlasFigure,
  'reddit-data-pipeline': PipelineFigure,
};
const Figure = figures[project.slug];
---

<BaseLayout title={project.title} description={project.summary}>
  <div data-page="project">
    <CaseHeader
      slug={project.slug}
      kicker={project.kicker}
      title={project.title}
      summary={project.summary}
      meta={[{ label: 'Year', value: project.year }]}
      links={project.links}
      stack={project.stack}
    />

    <div class="wrap">
      <CaseSection title="The problem" id="problem">
        <p>{project.problem}</p>
      </CaseSection>

      <CaseSection title="What I built" id="built">
        <BulletList items={project.built} />
      </CaseSection>

      {
        Figure && (
          <CaseSection title="Overview" id="overview">
            <Figure />
          </CaseSection>
        )
      }

      <CaseSection title="Technical approach" id="approach">
        <div class="approach">
          {
            project.approach.map((a) => (
              <div>
                <h3>{a.heading}</h3>
                {a.body.map((p) => <p>{p}</p>)}
              </div>
            ))
          }
        </div>
      </CaseSection>

      {
        project.metrics && (
          <CaseSection title="Results" id="results">
            <Metrics metrics={project.metrics} note={project.metricsNote} columns={4} />
          </CaseSection>
        )
      }

      <CaseSection title="Why it's interesting" id="interesting">
        <p>{project.interesting}</p>
      </CaseSection>

      {
        project.limitations && (
          <CaseSection title="Known limitations" id="limitations">
            <BulletList items={project.limitations} />
          </CaseSection>
        )
      }
    </div>

    <NextProject slug={project.slug} />
  </div>
</BaseLayout>

<style>
  .approach {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5) var(--space-7);
  }

  @media (min-width: 48rem) {
    .approach {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .approach > div {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding-top: var(--space-3);
    border-top: var(--border-hairline);
  }
</style>
