---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseHeader from '../../components/CaseHeader.astro';
import CaseSection from '../../components/CaseSection.astro';
import BulletList from '../../components/BulletList.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import Metrics from '../../components/Metrics.astro';
import DecisionList from '../../components/DecisionList.astro';
import EvidenceLinks from '../../components/EvidenceLinks.astro';
import DataTable from '../../components/DataTable.astro';
import PerfCompare from '../../components/PerfCompare.astro';
import NextProject from '../../components/NextProject.astro';
import { caseStudies, type Project } from '../../data/projects';
import { techId } from '../../data/graph';
import CodeAtlasGraph from '../../components/visuals/CodeAtlasGraph.astro';
import EtlPipeline from '../../components/visuals/EtlPipeline.astro';
import StreamBoxFlow from '../../components/visuals/StreamBoxFlow.astro';

export function getStaticPaths() {
  // Zoom Lens has its own page.
  return caseStudies
    .filter((p) => p.slug !== 'zoom-lens')
    .map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;

type Key = 'problem' | 'challenges' | 'contribution' | 'decisions' | 'evaluation' | 'limitations';
// Each case study follows the order that tells its story best.
const layouts: Record<string, [Key, string][]> = {
  codeatlas: [
    ['problem', 'The engineering problem'],
    ['contribution', 'Architecture'],
    ['challenges', 'What makes it hard'],
    ['evaluation', 'Benchmarks'],
    ['decisions', 'Decisions and tradeoffs'],
    ['limitations', 'Limitations and next steps'],
  ],
  'reddit-data-pipeline': [
    ['problem', 'The problem'],
    ['challenges', 'Working at scale'],
    ['contribution', 'The pipeline'],
    ['evaluation', 'Performance and reconciliation'],
    ['decisions', 'Decisions and tradeoffs'],
    ['limitations', 'Limitations'],
  ],
  streambox: [
    ['problem', 'The race conditions'],
    ['contribution', 'Concurrency safeguards'],
    ['decisions', 'Decisions and tradeoffs'],
    ['evaluation', 'Load testing'],
    ['limitations', 'Limitations'],
  ],
  'ticket-triage': [
    ['problem', 'The ML problem'],
    ['evaluation', 'Evaluation'],
    ['decisions', 'Explainability'],
    ['contribution', 'What I built'],
    ['limitations', 'Limitations'],
  ],
};
const fallback: [Key, string][] = [
  ['problem', 'Problem and constraints'],
  ['challenges', 'What makes it hard'],
  ['contribution', 'My contribution'],
  ['decisions', 'Decisions and tradeoffs'],
  ['evaluation', 'Evaluation'],
  ['limitations', project.next ? 'Limitations and next steps' : 'Limitations'],
];
const has: Record<Key, boolean> = {
  problem: !!project.problem,
  challenges: !!project.challenges,
  contribution: true,
  decisions: !!project.decisions,
  evaluation: !!project.evaluation,
  limitations: !!(project.limitations || project.next),
};
const order = (layouts[project.slug] ?? fallback).filter(([key]) => has[key]);
const sections = order.map(([id, label]) => ({ id, label }));
---

<BaseLayout title={project.title} description={project.summary}>
  <div data-page="project">
    <CaseHeader project={project} sections={sections} />

    <div class="wrap">
      <div class="lead-visual">
        {project.slug === 'reddit-data-pipeline' ? <EtlPipeline /> : project.visual && <ProjectVisual visual={project.visual} size="full" eager />}
      </div>

      {
        order.map(([key, title]) =>
          key === 'problem' ? (
            <CaseSection title={title} id="problem">
              <p>{project.problem}</p>
              {project.constraints && <BulletList items={project.constraints} />}
            </CaseSection>
          ) : key === 'challenges' ? (
            <CaseSection title={title} id="challenges">
              <BulletList items={project.challenges!} />
            </CaseSection>
          ) : key === 'contribution' ? (
            <CaseSection title={title} id="contribution">
              <p>{project.contribution}</p>
              {project.built && <BulletList items={project.built} />}
              {project.slug === 'codeatlas' && <CodeAtlasGraph />}
              {project.slug === 'streambox' && <StreamBoxFlow />}
              {project.stack && (
                <ul class="stack" aria-label="Full stack">
                  {project.stack.map((s) => (
                    <li>
                      <a class="tech-link" href={`/?tech=${encodeURIComponent(techId(s))}#skills`} data-tech-link={techId(s)}>
                        {s}
                        <span class="visually-hidden">: show in skills map</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </CaseSection>
          ) : key === 'decisions' ? (
            <CaseSection title={title} id="decisions">
              <DecisionList items={project.decisions!} />
            </CaseSection>
          ) : key === 'evaluation' ? (
            <CaseSection title={title} id="evaluation">
              <h3>Method</h3>
              <BulletList items={project.evaluation!.method} />
              <Metrics metrics={project.evaluation!.metrics} />
              {project.slug === 'reddit-data-pipeline' && <PerfCompare />}
              {project.tables?.map((t) => <DataTable table={t} />)}
              <EvidenceLinks links={project.evaluation!.evidence} />
            </CaseSection>
          ) : (
            <CaseSection title={title} id="limitations">
              {project.limitations && <BulletList items={project.limitations} />}
              {project.next && (
                <>
                  <h3>Next steps</h3>
                  <BulletList items={project.next} />
                </>
              )}
            </CaseSection>
          ),
        )
      }

      {
        project.gallery && (
          <CaseSection title="More screens" id="gallery">
            <div class="gallery">
              {project.gallery.map((v) => (
                <ProjectVisual visual={v} size="full" />
              ))}
            </div>
          </CaseSection>
        )
      }
    </div>

    <NextProject slug={project.slug} />
  </div>
</BaseLayout>

<style>
  .lead-visual {
    max-width: 60rem;
    padding-bottom: var(--space-6);
  }

  .gallery {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
  }

  @media (min-width: 60rem) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
