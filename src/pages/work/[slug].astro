---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseHeader from '../../components/CaseHeader.astro';
import CaseSection from '../../components/CaseSection.astro';
import BulletList from '../../components/BulletList.astro';
import Stages from '../../components/Stages.astro';
import Metrics from '../../components/Metrics.astro';
import DecisionList from '../../components/DecisionList.astro';
import NextProject from '../../components/NextProject.astro';
import CodeAtlasFigure from '../../components/CodeAtlasFigure.astro';
import PipelineFigure from '../../components/PipelineFigure.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const figures: Record<string, typeof CodeAtlasFigure> = {
  codeatlas: CodeAtlasFigure,
  'reddit-data-pipeline': PipelineFigure,
};
const Figure = figures[project.slug];

const sections = [
  { id: 'architecture', label: 'Architecture' },
  { id: 'decisions', label: 'Key decisions' },
  { id: 'evaluation', label: 'Evaluation' },
  { id: 'limitations', label: 'Limitations' },
  ...(project.next ? [{ id: 'next', label: 'Next steps' }] : []),
];
---

<BaseLayout title={project.title} description={project.summary}>
  <div data-page="project">
    <CaseHeader
      slug={project.slug}
      kicker={`${project.kicker} · ${project.year}`}
      title={project.title}
      summary={project.summary}
      facts={[
        { label: 'Problem', value: project.problem },
        { label: 'What I built', value: project.contribution },
        { label: 'Status', value: project.status },
        { label: 'Outcome', value: project.outcome },
      ]}
      stack={project.stack}
      links={project.links}
      sections={sections}
    />

    <div class="wrap">
      <CaseSection title="Architecture" id="architecture">
        <Stages stages={project.architecture.stages} />
        {project.architecture.note && <p>{project.architecture.note}</p>}
        <BulletList items={project.built} />
        {Figure && <Figure />}
      </CaseSection>

      <CaseSection title="Key decisions" id="decisions">
        <DecisionList items={project.decisions} />
      </CaseSection>

      <CaseSection title="Evaluation" id="evaluation">
        <Metrics metrics={project.metrics} note={project.evaluationNote} />
      </CaseSection>

      <CaseSection title="Limitations" id="limitations">
        <BulletList items={project.limitations} />
      </CaseSection>

      {
        project.next && (
          <CaseSection title="Next steps" id="next">
            <BulletList items={project.next} />
          </CaseSection>
        )
      }
    </div>

    <NextProject slug={project.slug} />
  </div>
</BaseLayout>
