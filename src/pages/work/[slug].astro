---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseHeader from '../../components/CaseHeader.astro';
import CaseSection from '../../components/CaseSection.astro';
import CaseLinks from '../../components/CaseLinks.astro';
import BulletList from '../../components/BulletList.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import Metrics from '../../components/Metrics.astro';
import DecisionList from '../../components/DecisionList.astro';
import EvidenceLinks from '../../components/EvidenceLinks.astro';
import DataTable from '../../components/DataTable.astro';
import PerfCompare from '../../components/PerfCompare.astro';
import NextProject from '../../components/NextProject.astro';
import { allCaseStudies, type Project } from '../../data/projects';
import CodeAtlasGraph from '../../components/visuals/CodeAtlasGraph.astro';
import EtlPipeline from '../../components/visuals/EtlPipeline.astro';
import StreamBoxFlow from '../../components/visuals/StreamBoxFlow.astro';

export function getStaticPaths() {
  // ZoomLens has its own page.
  return allCaseStudies
    .filter((p) => p.slug !== 'zoom-lens')
    .map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;

// Every case study uses the same order; a section only appears when the project has something for it.
const diagrams: Record<string, typeof CodeAtlasGraph | undefined> = { codeatlas: CodeAtlasGraph, streambox: StreamBoxFlow };
const Architecture = diagrams[project.slug];
const extraDecisions = project.decisions?.slice(3) ?? [];
const sections = [
  project.problem && { id: 'problem', label: 'Problem' },
  { id: 'built', label: 'What I built' },
  Architecture && { id: 'architecture', label: 'Architecture' },
  project.decisions && { id: 'decisions', label: 'Decisions' },
  project.evaluation && { id: 'results', label: 'Results' },
  (project.limitations || project.next) && { id: 'limitations', label: 'Limitations' },
  (project.github || project.demo || project.site) && { id: 'links', label: 'Code and demo' },
].filter(Boolean) as { id: string; label: string }[];
---

<BaseLayout title={project.title} description={project.summary}>
  <div data-page="project">
    <CaseHeader project={project} sections={sections} />

    <div class="wrap">
      <div class="lead-visual">
        {project.slug === 'reddit-data-pipeline' ? <EtlPipeline /> : project.visual && <ProjectVisual visual={project.visual} size="full" eager />}
      </div>

      {
        project.problem && (
          <CaseSection title="Problem" id="problem">
            <p>{project.problem}</p>
            {(project.constraints || project.challenges) && (
              <details class="fold">
                <summary>constraints and what makes it hard</summary>
                <div class="folded">
                  {project.constraints && <BulletList items={project.constraints} />}
                  {project.challenges && <BulletList items={project.challenges} />}
                </div>
              </details>
            )}
          </CaseSection>
        )
      }

      <CaseSection title="What I built" id="built">
        <p>{project.contribution}</p>
        {project.built && <BulletList items={project.built} />}
        {
          project.stack && (
            <ul class="stack" aria-label="Full stack">
              {project.stack.map((s) => <li>{s}</li>)}
            </ul>
          )
        }
      </CaseSection>

      {
        Architecture && (
          <CaseSection title="Architecture" id="architecture">
            <Architecture />
          </CaseSection>
        )
      }

      {
        project.decisions && (
          <CaseSection title="Decisions" id="decisions">
            <DecisionList items={project.decisions.slice(0, 3)} />
            {extraDecisions.length > 0 && (
              <details class="fold">
                <summary>{extraDecisions.length} more {extraDecisions.length === 1 ? 'decision' : 'decisions'}</summary>
                <DecisionList items={extraDecisions} />
              </details>
            )}
          </CaseSection>
        )
      }

      {
        project.evaluation && (
          <CaseSection title="Results" id="results">
            <Metrics metrics={project.evaluation.metrics} />
            {project.slug === 'reddit-data-pipeline' && <PerfCompare />}
            {project.gallery && (
              <div class="gallery">
                {project.gallery.map((v) => (
                  <ProjectVisual visual={v} size="full" />
                ))}
              </div>
            )}
            <details class="fold">
              <summary>how it was measured{project.tables?.length ? ', with the full tables' : ''}</summary>
              <div class="folded">
                <BulletList items={project.evaluation.method} />
                {project.tables?.map((t) => <DataTable table={t} />)}
              </div>
            </details>
            <EvidenceLinks links={project.evaluation.evidence} />
          </CaseSection>
        )
      }

      {
        (project.limitations || project.next) && (
          <CaseSection title="Limitations" id="limitations">
            {project.limitations && <BulletList items={project.limitations} />}
            {project.next && (
              <>
                <h3>Next steps</h3>
                <BulletList items={project.next} />
              </>
            )}
          </CaseSection>
        )
      }

      <CaseLinks project={project} />
    </div>

    <NextProject slug={project.slug} />
  </div>
</BaseLayout>

<style>
  .lead-visual {
    max-width: 60rem;
    padding-bottom: var(--space-6);
  }

  .folded {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-3);
  }

  .gallery {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
  }

  @media (min-width: 60rem) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
