---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseHeader from '../../components/CaseHeader.astro';
import CaseSection from '../../components/CaseSection.astro';
import BulletList from '../../components/BulletList.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import DecisionList from '../../components/DecisionList.astro';
import ZoomLensDelivery from '../../components/ZoomLensDelivery.astro';
import ZoomLensStatus from '../../components/ZoomLensStatus.astro';
import NextProject from '../../components/NextProject.astro';
import { projects, zoomLens } from '../../data/projects';

const project = projects.find((p) => p.slug === 'zoom-lens')!;
const sections = [
  { id: 'problem', label: 'Problem' },
  { id: 'contribution', label: 'My contribution' },
  { id: 'decisions', label: 'Decisions' },
  { id: 'evaluation', label: 'Evaluation' },
  { id: 'status', label: 'Limitations and next steps' },
];
---

<BaseLayout title={project.title} description={project.summary}>
  <div data-page="project">
    <CaseHeader project={{ ...project, status: 'Working prototype' }} role={zoomLens.role} sections={sections} />

    <div class="wrap">
      <div class="lead-visual">
        {
          zoomLens.demoVideo ? (
            <figure class="video">
              <video src={zoomLens.demoVideo} controls muted playsinline preload="metadata" aria-label="Zoom Lens demo recording" />
              <figcaption>Zoom Lens running in a live meeting.</figcaption>
            </figure>
          ) : (
            <ProjectVisual visual={project.visual} size="full" />
          )
        }
      </div>

      <CaseSection title="Problem and constraints" id="problem">
        {zoomLens.problem.map((p) => <p>{p}</p>)}
        <BulletList items={zoomLens.constraints} />
      </CaseSection>

      <CaseSection title="My contribution" id="contribution">
        <p>{project.contribution}</p>
        <p>{zoomLens.howItWorks}</p>
        <dl class="modes">
          {
            zoomLens.modes.map((m) => (
              <div>
                <dt>
                  {m.name} <span class="ui">“{m.label}”</span>
                </dt>
                <dd>{m.body}</dd>
              </div>
            ))
          }
        </dl>
      </CaseSection>

      <CaseSection title="Decisions and tradeoffs" id="decisions">
        <DecisionList items={zoomLens.decisions} />
        <h3>Answer delivery rules</h3>
        <ZoomLensDelivery />
      </CaseSection>

      <CaseSection title="Evaluation" id="evaluation">
        <p>
          There is no formal evaluation yet. Interface estimates shown by the app:{' '}
          {zoomLens.modes.map((m) => `${m.name} ${m.estimate}`).join(', ')}.
        </p>
        <p class="note">{zoomLens.timingContext}</p>
      </CaseSection>

      <CaseSection title="Limitations and next steps" id="status">
        <ZoomLensStatus />
      </CaseSection>
    </div>

    <NextProject slug={project.slug} />
  </div>
</BaseLayout>

<style>
  .lead-visual {
    max-width: 60rem;
    padding-bottom: var(--space-6);
  }

  .video {
    margin: 0;
  }

  .video video {
    width: 100%;
    border: var(--border-hairline);
    border-radius: var(--radius-md);
  }

  .video figcaption {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .modes {
    margin: 0;
    border-top: var(--border-hairline);
  }

  .modes > div {
    display: grid;
    gap: 2px;
    padding-block: var(--space-3);
    border-bottom: var(--border-hairline);
    font-size: var(--text-sm);
  }

  .modes dt {
    font-weight: 600;
    color: var(--color-ink);
  }

  .ui {
    font-weight: 400;
    color: var(--color-muted);
  }

  .modes dd {
    margin: 0;
  }


  .note {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
</style>
