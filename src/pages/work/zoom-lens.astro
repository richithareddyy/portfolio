---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseHeader from '../../components/CaseHeader.astro';
import CaseSection from '../../components/CaseSection.astro';
import NextProject from '../../components/NextProject.astro';
import ZoomLensMedia from '../../components/ZoomLensMedia.astro';
import ZoomLensModes from '../../components/ZoomLensModes.astro';
import ZoomLensDelivery from '../../components/ZoomLensDelivery.astro';
import ZoomLensStatus from '../../components/ZoomLensStatus.astro';
import DecisionList from '../../components/DecisionList.astro';
import { zoomLens } from '../../data/projects';

const sections = [
  { id: 'how', label: 'How it works' },
  { id: 'delivery', label: 'Response delivery' },
  { id: 'decisions', label: 'Key decisions' },
  { id: 'limitations', label: 'Limitations' },
  { id: 'tradeoff', label: 'Tradeoff' },
  { id: 'status', label: 'Status and next steps' },
];
---

<BaseLayout title={zoomLens.title} description={zoomLens.oneLiner}>
  <div data-page="project">
    <CaseHeader
      slug={zoomLens.slug}
      kicker={`${zoomLens.kicker} · ${zoomLens.year}`}
      title={zoomLens.title}
      summary={zoomLens.oneLiner}
      facts={[
        { label: 'Problem', value: zoomLens.problemShort },
        { label: 'Role', value: zoomLens.role },
        { label: 'What I built', value: zoomLens.contribution },
        { label: 'Status', value: `${zoomLens.status}. Reads the participant’s display; meeting-feed capture is not yet enabled.` },
        { label: 'Outcome', value: zoomLens.outcome },
      ]}
      stack={zoomLens.tags}
      sections={sections}
    />

    <div class="wrap">
      <div class="hero-figure">
        <ZoomLensMedia />
      </div>

      <CaseSection title="How it works" id="how">
        {zoomLens.problem.map((p) => <p>{p}</p>)}
        <p>{zoomLens.howItWorks}</p>
        <ZoomLensModes />
        <h3>About the response times</h3>
        {zoomLens.timingContext.map((p) => <p>{p}</p>)}
      </CaseSection>

      <CaseSection title="Response delivery" id="delivery">
        <ZoomLensDelivery />
      </CaseSection>

      <CaseSection title="Key decisions" id="decisions">
        <DecisionList items={zoomLens.decisions} />
      </CaseSection>

      <CaseSection title="Limitations" id="limitations">
        <h3>Screen capture</h3>
        <p>{zoomLens.capture.current}</p>
        <p>{zoomLens.capture.consequence}</p>
      </CaseSection>

      <CaseSection title="Tradeoff" id="tradeoff">
        <div class="tradeoff">
          {zoomLens.tradeoff.map((p) => <p>{p}</p>)}
        </div>
      </CaseSection>

      <CaseSection title="Status and next steps" id="status">
        <ZoomLensStatus />
      </CaseSection>
    </div>

    <NextProject slug={zoomLens.slug} />
  </div>
</BaseLayout>

<style>
  .hero-figure {
    max-width: 52rem;
    padding-bottom: var(--space-6);
  }

  .tradeoff {
    display: grid;
    gap: var(--space-4);
    max-width: var(--width-prose);
    padding-left: var(--space-5);
    border-left: 2px solid var(--color-pending);
  }

  .tradeoff p {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1.55;
  }
</style>
