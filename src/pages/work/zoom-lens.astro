---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseHeader from '../../components/CaseHeader.astro';
import CaseSection from '../../components/CaseSection.astro';
import ZoomLensStatus from '../../components/ZoomLensStatus.astro';
import ZoomLensArchitecture from '../../components/visuals/ZoomLensArchitecture.astro';
import ZoomLensPreview from '../../components/ZoomLensPreview.astro';
import NextProject from '../../components/NextProject.astro';
import CaseLinks from '../../components/CaseLinks.astro';
import Metrics from '../../components/Metrics.astro';
import { projects, zoomLens } from '../../data/projects';

const project = projects.find((p) => p.slug === 'zoom-lens')!;
const repo = (file: string) => `https://github.com/richithareddyy/ZoomLens/blob/main/${file}`;
const sections = [
  { id: 'problem', label: 'Problem' },
  { id: 'built', label: 'What I built' },
  { id: 'architecture', label: 'Architecture' },
  { id: 'decisions', label: 'Decisions' },
  { id: 'results', label: 'Results' },
  { id: 'limitations', label: 'Limitations' },
  { id: 'links', label: 'Code and demo' },
];
const extra = zoomLens.decisions.length - 3;
// Only what has been measured; the per-mode wait times are UI estimates, so they stay with the modes.
const metrics = [
  { value: '7', label: 'isolation tests against the real server', qualifier: 'including 10 participants asking at once' },
  { value: '25–110 ms', label: 'to decode a still from the meeting stream', qualifier: 'in testing' },
];
---

<BaseLayout title={project.title} description={project.summary}>
  <div data-page="project">
    <CaseHeader
      project={{ ...project, status: 'Working prototype' }}
      role={zoomLens.role}
      result={{ headline: 'Answers stay with the person who asked', qualifier: 'enforced on the server, covered by isolation tests' }}
      sections={sections}
    />

    <div class="wrap">
      <div class="lead-visual">
        {
          zoomLens.demoVideo ? (
            <figure class="video">
              <video src={zoomLens.demoVideo} controls muted playsinline preload="metadata" aria-label="ZoomLens demo recording" />
              <figcaption>ZoomLens running in a live meeting.</figcaption>
            </figure>
          ) : (
            <ZoomLensPreview eager />
          )
        }
        <p class="built-with">
          <span>Built with</span>
          {project.tech.join(' · ')}
        </p>
      </div>

      <CaseSection title="Problem" id="problem">
        <p>{zoomLens.problem.intro}</p>
        <ul class="plain">
          {zoomLens.problem.points.map((p) => <li>{p}</li>)}
        </ul>
        <p class="close">{zoomLens.problem.close}</p>
      </CaseSection>

      <CaseSection title="What I built" id="built">
        <p>Everything in the repository, end to end, in JavaScript on Node.js. Each question goes through four steps:</p>
        <ol class="steps">
          {
            zoomLens.steps.map((s, i) => (
              <li>
                <span class="n">{String(i + 1).padStart(2, '0')}</span>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
                <p class="files">
                  {s.files.map((f) => (
                    <a href={repo(f)} target="_blank" rel="noopener">
                      {f}
                      <span class="visually-hidden"> on GitHub (opens in a new tab)</span>
                    </a>
                  ))}
                </p>
              </li>
            ))
          }
        </ol>

        <details class="fold">
          <summary>what you can ask</summary>
          <div class="folded">
            <dl class="modes">
              {
                zoomLens.modes.map((m) => (
                  <div>
                    <dt>
                      {m.name} <span class="ui">“{m.label}”</span>
                    </dt>
                    <dd>{m.body}</dd>
                    <dd class="est">{m.estimate}</dd>
                  </div>
                ))
              }
            </dl>
            <p class="note">{zoomLens.timingContext}</p>
          </div>
        </details>

        <details class="fold">
          <summary>every part, with the files</summary>
          <div class="folded">
            <dl class="built">
              {
                zoomLens.built.map((b) => (
                  <div>
                    <dt>{b.title}</dt>
                    <dd>
                      {b.body}
                      <span class="files">
                        {b.files.map((f) => (
                          <a href={repo(f)} target="_blank" rel="noopener">
                            {f}
                            <span class="visually-hidden"> on GitHub (opens in a new tab)</span>
                          </a>
                        ))}
                      </span>
                    </dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </details>

        <details class="fold">
          <summary>the stack, and what each piece does</summary>
          <div class="folded">
            <dl class="stack">
              {
                zoomLens.stack.map((t) => (
                  <div>
                    <dt>{t.name}</dt>
                    <dd>{t.use}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </details>
      </CaseSection>

      <CaseSection title="Architecture" id="architecture">
        <ZoomLensArchitecture />
      </CaseSection>

      <CaseSection title="Decisions" id="decisions">
        <div class="decisions">
          {zoomLens.decisions.slice(0, 3).map((d) => (
            <article>
              <h3>{d.heading}</h3>
              <dl>
                <dt>Problem</dt>
                <dd>{d.problem}</dd>
                <dt>Decision</dt>
                <dd>{d.decision}</dd>
                <dt>Why</dt>
                <dd>{d.why}</dd>
              </dl>
            </article>
          ))}
        </div>
        <details class="fold">
          <summary>{extra} more {extra === 1 ? 'decision' : 'decisions'}</summary>
          <div class="decisions folded">
            {zoomLens.decisions.slice(3).map((d) => (
            <article>
              <h3>{d.heading}</h3>
              <dl>
                <dt>Problem</dt>
                <dd>{d.problem}</dd>
                <dt>Decision</dt>
                <dd>{d.decision}</dd>
                <dt>Why</dt>
                <dd>{d.why}</dd>
              </dl>
            </article>
          ))}
          </div>
        </details>
      </CaseSection>

      <CaseSection title="Results" id="results">
        <Metrics metrics={metrics} />
        <h3>Working today</h3>
        <ul class="plain">
          {zoomLens.progress.built.map((item) => <li>{item}</li>)}
        </ul>
        <p class="note">There is no formal evaluation of answer quality yet; that is listed under the limitations.</p>
      </CaseSection>

      <CaseSection title="Limitations" id="limitations">
        <ZoomLensStatus />
      </CaseSection>

      <CaseLinks project={project} />
    </div>

    <NextProject slug={project.slug} />
  </div>
</BaseLayout>

<style>
  .lead-visual {
    max-width: 60rem;
    padding-bottom: var(--space-6);
  }

  .built-with {
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
  }

  .built-with span {
    margin-right: var(--space-2);
    color: var(--color-muted);
  }

  .video {
    margin: 0;
  }

  .video video {
    width: 100%;
    border: var(--border-hairline);
    border-radius: var(--radius-md);
  }

  .video figcaption {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .plain {
    display: grid;
    gap: var(--space-1);
    max-width: var(--width-prose);
    padding-left: var(--space-5);
  }

  .close {
    color: var(--color-ink);
    font-weight: 500;
  }

  /* How it works: four steps, read left to right on wide screens. */
  .steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    list-style: none;
    padding: 0;
  }

  @media (min-width: 64rem) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }

  .steps li {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: var(--border-ink);
  }

  .n {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent-ink);
  }

  .steps p {
    font-size: var(--text-sm);
  }

  .files {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
  }

  .files a {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-muted);
    text-decoration: underline;
    text-decoration-color: var(--color-rule-strong);
    text-underline-offset: 0.2em;
  }

  .files a:hover {
    color: var(--color-accent-ink);
  }

  .modes {
    margin: 0;
    border-top: var(--border-hairline);
  }

  .modes > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2px var(--space-4);
    padding-block: var(--space-3);
    border-bottom: var(--border-hairline);
    font-size: var(--text-sm);
  }

  .modes dt {
    grid-column: 1;
    font-weight: 600;
    color: var(--color-ink);
  }

  .modes dd {
    grid-column: 1;
    margin: 0;
  }

  .modes .est {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: start;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .ui {
    font-weight: 400;
    color: var(--color-muted);
  }

  .note {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .built,
  .stack {
    margin: 0;
    border-top: var(--border-hairline);
  }

  .built > div,
  .stack > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2px var(--space-5);
    padding-block: var(--space-3);
    border-bottom: var(--border-hairline);
    font-size: var(--text-sm);
  }

  @media (min-width: 48rem) {
    .built > div,
    .stack > div {
      grid-template-columns: 15rem minmax(0, 1fr);
    }
  }

  .built dt,
  .stack dt {
    font-weight: 600;
    color: var(--color-ink);
  }

  .built dd,
  .stack dd {
    margin: 0;
  }

  .built .files {
    margin-top: var(--space-1);
  }

  .decisions {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6) var(--space-7);
  }

  @media (min-width: 56rem) {
    .decisions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .decisions article {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: var(--border-ink);
  }

  .decisions dl {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-2) var(--space-3);
    margin: 0;
    font-size: var(--text-sm);
  }

  .decisions dt {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    padding-top: 0.2rem;
    color: var(--color-accent-ink);
  }

  .decisions dd {
    margin: 0;
  }

  .folded {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-3);
  }
</style>
