---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseHeader from '../../components/CaseHeader.astro';
import CaseSection from '../../components/CaseSection.astro';
import BulletList from '../../components/BulletList.astro';
import DecisionList from '../../components/DecisionList.astro';
import ZoomLensDelivery from '../../components/ZoomLensDelivery.astro';
import ZoomLensStatus from '../../components/ZoomLensStatus.astro';
import ZoomLensArchitecture from '../../components/visuals/ZoomLensArchitecture.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import NextProject from '../../components/NextProject.astro';
import { projects, zoomLens } from '../../data/projects';

const project = projects.find((p) => p.slug === 'zoom-lens')!;
const sections = [
  { id: 'problem', label: 'Problem' },
  { id: 'interaction', label: 'Product' },
  { id: 'architecture', label: 'Architecture' },
  { id: 'routing', label: 'Routing and privacy' },
  { id: 'challenges', label: 'Challenges' },
  { id: 'evaluation', label: 'Evaluation' },
  { id: 'status', label: 'Limitations and next steps' },
];
---

<BaseLayout title={project.title} description={project.summary}>
  <div data-page="project">
    <CaseHeader project={{ ...project, status: 'Working prototype' }} role={zoomLens.role} sections={sections} />

    <div class="wrap">
      <div class="lead-visual">
        {
          zoomLens.demoVideo ? (
            <figure class="video">
              <video src={zoomLens.demoVideo} controls muted playsinline preload="metadata" aria-label="Zoom Lens demo recording" />
              <figcaption>Zoom Lens running in a live meeting.</figcaption>
            </figure>
          ) : (
            <ProjectVisual visual={project.visual} size="full" eager />
          )
        }
      </div>

      <CaseSection title="The problem" id="problem">
        {zoomLens.problem.map((p) => <p>{p}</p>)}
        <h3>Constraints</h3>
        <BulletList items={zoomLens.constraints} />
      </CaseSection>

      <CaseSection title="Product interaction" id="interaction">
        <ol class="steps">
          {zoomLens.interaction.map((step) => <li>{step}</li>)}
        </ol>
        <dl class="modes">
          {
            zoomLens.modes.map((m) => (
              <div>
                <dt>
                  {m.name} <span class="ui">“{m.label}”</span>
                </dt>
                <dd>{m.body}</dd>
              </div>
            ))
          }
        </dl>
      </CaseSection>

      <CaseSection title="System architecture" id="architecture">
        <p>{project.contribution}</p>
        <ZoomLensArchitecture />
        <h3>AI integration</h3>
        <BulletList items={zoomLens.ai} />
      </CaseSection>

      <CaseSection title="Routing and privacy boundaries" id="routing">
        <ZoomLensDelivery />
        <div class="bounds">
          <div>
            <h3>What the routing protects</h3>
            <BulletList items={zoomLens.boundaries.covered} />
          </div>
          <div>
            <h3>What it does not cover</h3>
            <BulletList items={zoomLens.boundaries.notCovered} />
          </div>
        </div>
      </CaseSection>

      <CaseSection title="Engineering challenges and decisions" id="challenges">
        <BulletList items={zoomLens.challenges} />
        <DecisionList items={zoomLens.decisions} />
      </CaseSection>

      <CaseSection title="Evaluation" id="evaluation">
        <p>
          There is no formal evaluation yet. Interface estimates the panel displayed:{' '}
          {zoomLens.modes.map((m) => `${m.name} ${m.estimate}`).join(', ')}.
        </p>
        <p class="note">{zoomLens.timingContext}</p>
      </CaseSection>

      <CaseSection title="Limitations and next steps" id="status">
        <ZoomLensStatus />
      </CaseSection>
    </div>

    <NextProject slug={project.slug} />
  </div>
</BaseLayout>

<style>
  .lead-visual {
    max-width: 60rem;
    padding-bottom: var(--space-6);
  }

  .video {
    margin: 0;
  }

  .video video {
    width: 100%;
    border: var(--border-hairline);
    border-radius: var(--radius-md);
  }

  .video figcaption {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .steps {
    display: grid;
    gap: var(--space-2);
    max-width: var(--width-prose);
    padding-left: var(--space-5);
  }

  .steps li::marker {
    font-family: var(--font-mono);
    color: var(--color-accent-ink);
  }

  .modes {
    margin: 0;
    border-top: var(--border-hairline);
  }

  .modes > div {
    display: grid;
    gap: 2px;
    padding-block: var(--space-3);
    border-bottom: var(--border-hairline);
    font-size: var(--text-sm);
  }

  .modes dt {
    font-weight: 600;
    color: var(--color-ink);
  }

  .ui {
    font-weight: 400;
    color: var(--color-muted);
  }

  .modes dd {
    margin: 0;
  }

  .bounds {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5) var(--space-7);
  }

  @media (min-width: 48rem) {
    .bounds {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .bounds > div {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .note {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
</style>
