---
import type { Decision } from '../data/projects';
interface Props {
  items: readonly Decision[];
}
const { items } = Astro.props;
---

<ol class="decisions">
  {
    items.map((d) => (
      <li>
        <h3>{d.heading}</h3>
        <p>{d.body}</p>
        <p class="tradeoff">
          <span>Tradeoff.</span> {d.tradeoff}
        </p>
      </li>
    ))
  }
</ol>

<style>
  .decisions {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 var(--space-7);
    list-style: none;
  }

  @media (min-width: 48rem) {
    .decisions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  li {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding-block: var(--space-4);
    border-top: var(--border-hairline);
    font-size: var(--text-sm);
  }

  .tradeoff {
    color: var(--color-muted);
  }

  .tradeoff span {
    font-weight: 600;
    color: var(--color-ink-soft);
  }
</style>
