---
import { zoomLens } from '../data/projects';
const { progress } = zoomLens;
---

<div class="status">
  <section class="col built" aria-labelledby="status-built">
    <h3 id="status-built"><span class="dot" aria-hidden="true"></span>Working today</h3>
    <ul>
      {progress.built.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="col pending" aria-labelledby="status-pending">
    <h3 id="status-pending"><span class="dot" aria-hidden="true"></span>Not yet</h3>
    <ul>
      {progress.notYet.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="col exploring" aria-labelledby="status-exploring">
    <h3 id="status-exploring"><span class="dot" aria-hidden="true"></span>Exploring next</h3>
    <ul>
      {progress.exploring.map((item) => <li>{item}</li>)}
    </ul>
    <p class="fine">Directions under exploration, not completed features.</p>
  </section>
</div>

<style>
  .status {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }

  @media (min-width: 56rem) {
    .status {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }

  .col {
    padding-top: var(--space-3);
    border-top: 2px solid var(--tone);
    font-size: var(--text-sm);
  }

  .built {
    --tone: var(--color-positive);
  }

  .pending {
    --tone: var(--color-pending);
  }

  .exploring {
    --tone: var(--color-rule-strong);
  }

  h3 {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--tone);
  }

  .exploring .dot {
    background: transparent;
    border: 1.5px solid var(--color-faint);
  }

  ul {
    display: grid;
    gap: var(--space-2);
    list-style: none;
  }

  li {
    position: relative;
    padding-left: var(--space-4);
  }

  li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 6px;
    height: 1px;
    background: var(--color-faint);
  }

  .exploring li {
    color: var(--color-muted);
  }

  .fine {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
</style>
