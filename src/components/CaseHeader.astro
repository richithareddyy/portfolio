---
interface Props {
  slug: string;
  kicker: string;
  title: string;
  summary: string;
  meta: { label: string; value: string }[];
  links?: { label: string; href: string }[];
  stack: readonly string[];
}

const { slug, kicker, title, summary, meta, links = [], stack } = Astro.props;
---

<header class="case-header wrap">
  <a class="back" href="/#work"><span aria-hidden="true">←</span> All projects</a>
  <p class="label kicker">{kicker}</p>
  <h1 transition:name={`title-${slug}`}>{title}</h1>
  <p class="summary">{summary}</p>

  <dl class="meta">
    {
      meta.map((m) => (
        <div>
          <dt class="label">{m.label}</dt>
          <dd>{m.value}</dd>
        </div>
      ))
    }
    <div class="stack-cell">
      <dt class="label">Stack</dt>
      <dd>
        <ul class="stack">
          {stack.map((s) => <li>{s}</li>)}
        </ul>
      </dd>
    </div>
    {
      links.length > 0 && (
        <div>
          <dt class="label">Links</dt>
          <dd class="links">
            {links.map((l) => (
              <a class="text-link" href={l.href} target="_blank" rel="noopener">
                {l.label}
                <span class="visually-hidden"> (opens in a new tab)</span>
                <span aria-hidden="true"> ↗</span>
              </a>
            ))}
          </dd>
        </div>
      )
    }
  </dl>
</header>

<style>
  .case-header {
    padding-top: var(--space-6);
    padding-bottom: var(--space-7);
  }

  .back {
    display: inline-flex;
    gap: var(--space-2);
    margin-bottom: var(--space-7);
    font-size: var(--text-sm);
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .back:hover {
    color: var(--color-ink);
  }

  .back span {
    transition: transform var(--duration-base) var(--ease-out);
  }

  .back:hover span {
    transform: translateX(-3px);
  }

  h1 {
    margin-top: var(--space-3);
    font-size: clamp(2.5rem, 1.6rem + 3.8vw, 4.5rem);
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .summary {
    max-width: 44rem;
    margin-top: var(--space-4);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    color: var(--color-ink-soft);
  }

  .meta {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4) var(--space-6);
    margin: var(--space-7) 0 0;
    padding-top: var(--space-4);
    border-top: var(--border-ink);
  }

  @media (min-width: 48rem) {
    .meta {
      grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    }
    .stack-cell {
      grid-column: span 2;
    }
  }

  dd {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
  }
</style>
