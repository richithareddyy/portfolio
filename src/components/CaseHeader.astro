---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  role?: string;
  sections: { id: string; label: string }[];
}

const { project, sections } = Astro.props;
const role = Astro.props.role ?? project.role;
const links = [
  project.demo && { label: 'Live demo', href: project.demo },
  project.github && { label: 'GitHub', href: project.github },
].filter(Boolean) as { label: string; href: string }[];
---

<header class="case-header wrap">
  <a class="back" href="/#work"><span aria-hidden="true">←</span> All work</a>
  <h1 transition:name={`title-${project.slug}`}>{project.title}</h1>
  <p class="summary">{project.summary}</p>

  <dl class="facts">
    {
      role && (
        <div>
          <dt>Role</dt>
          <dd>{role}</dd>
        </div>
      )
    }
    <div>
      <dt>Status</dt>
      <dd>{project.status ?? project.result.headline}</dd>
    </div>
    <div>
      <dt>{project.slug === 'zoom-lens' ? 'Current scope' : 'Strongest result'}</dt>
      <dd>
        <strong>{project.slug === 'zoom-lens' ? project.result.qualifier : project.result.headline}</strong>
        {project.slug !== 'zoom-lens' && project.result.qualifier && <span class="q">{project.result.qualifier}</span>}
      </dd>
    </div>
    {
      links.length > 0 && (
        <div>
          <dt>Links</dt>
          <dd class="links">
            {links.map((l) => (
              <a href={l.href} target="_blank" rel="noopener">
                {l.label}
                <span class="visually-hidden"> (opens in a new tab)</span>
                <span aria-hidden="true"> ↗</span>
              </a>
            ))}
          </dd>
        </div>
      )
    }
  </dl>

  <nav class="toc" aria-label="On this page">
    <p class="toc-label">On this page</p>
    <ul>
      {sections.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}
    </ul>
  </nav>
</header>

<style>
  .case-header {
    padding-top: var(--space-5);
    padding-bottom: var(--space-5);
  }

  .back {
    display: inline-flex;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
    padding-block: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .back:hover {
    color: var(--color-ink);
  }

  h1 {
    font-size: clamp(2.5rem, 1.6rem + 3.8vw, 4.25rem);
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .summary {
    max-width: 44rem;
    margin-top: var(--space-3);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    color: var(--color-ink-soft);
  }

  .facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4) var(--space-6);
    margin: var(--space-6) 0 0;
    padding-top: var(--space-4);
    border-top: var(--border-ink);
  }

  @media (min-width: 48rem) {
    .facts {
      grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    }
  }

  dt {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-muted);
  }

  dd {
    margin: 2px 0 0;
    font-size: var(--text-sm);
    color: var(--color-ink);
  }

  dd strong {
    display: block;
    font-weight: 600;
  }

  .q {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
  }

  .links a {
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--color-rule-strong);
    text-underline-offset: 0.2em;
  }

  .links a:hover {
    color: var(--color-accent-ink);
  }

  .toc {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-5);
    font-size: var(--text-sm);
  }

  .toc-label {
    color: var(--color-muted);
  }

  .toc ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    list-style: none;
  }

  .toc a {
    display: inline-block;
    padding-block: var(--space-1);
    text-decoration: underline;
    text-decoration-color: var(--color-rule-strong);
    text-underline-offset: 0.25em;
  }

  .toc a:hover {
    color: var(--color-accent-ink);
    text-decoration-color: currentColor;
  }
</style>
