---
interface Props {
  slug: string;
  kicker: string;
  title: string;
  summary: string;
  facts: { label: string; value: string }[];
  stack: readonly string[];
  links?: { label: string; href: string }[];
  sections: { id: string; label: string }[];
}

const { slug, kicker, title, summary, facts, stack, links = [], sections } = Astro.props;
---

<header class="case-header wrap">
  <a class="back" href="/#work"><span aria-hidden="true">←</span> All projects</a>
  <p class="label">{kicker}</p>
  <h1 transition:name={`title-${slug}`}>{title}</h1>
  <p class="summary">{summary}</p>

  <dl class="facts">
    {
      facts.map((f) => (
        <div>
          <dt>{f.label}</dt>
          <dd>{f.value}</dd>
        </div>
      ))
    }
    <div>
      <dt>Stack</dt>
      <dd>
        <ul class="stack">
          {stack.map((s) => <li>{s}</li>)}
        </ul>
      </dd>
    </div>
    {
      links.length > 0 && (
        <div>
          <dt>Links</dt>
          <dd class="links">
            {links.map((l) => (
              <a class="text-link" href={l.href} target="_blank" rel="noopener">
                {l.label}
                <span class="visually-hidden"> (opens in a new tab)</span>
              </a>
            ))}
          </dd>
        </div>
      )
    }
  </dl>

  <nav class="toc" aria-label="On this page">
    <p class="toc-label">On this page</p>
    <ul>
      {sections.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}
    </ul>
  </nav>
</header>

<style>
  .case-header {
    padding-top: var(--space-6);
    padding-bottom: var(--space-6);
  }

  .back {
    display: inline-flex;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    padding-block: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .back:hover {
    color: var(--color-ink);
  }

  h1 {
    margin-top: var(--space-2);
    font-size: clamp(2.5rem, 1.6rem + 3.8vw, 4.25rem);
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .summary {
    max-width: 44rem;
    margin-top: var(--space-4);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    color: var(--color-ink-soft);
  }

  .facts {
    display: grid;
    gap: 0;
    max-width: 56rem;
    margin: var(--space-6) 0 0;
    border-top: var(--border-ink);
  }

  .facts > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-1) var(--space-6);
    padding-block: var(--space-3);
    border-bottom: var(--border-hairline);
  }

  @media (min-width: 48rem) {
    .facts > div {
      grid-template-columns: 9rem minmax(0, 1fr);
    }
  }

  dt {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
  }

  .toc {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-6);
    font-size: var(--text-sm);
  }

  .toc-label {
    color: var(--color-muted);
  }

  .toc ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    list-style: none;
  }

  .toc a {
    display: inline-block;
    padding-block: var(--space-1);
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-rule-strong);
    text-underline-offset: 0.25em;
  }

  .toc a:hover {
    color: var(--color-accent-ink);
    text-decoration-color: currentColor;
  }
</style>
