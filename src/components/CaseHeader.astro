---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  role?: string;
  /** Overrides project.result when a page has a better headline fact. */
  result?: { headline: string; qualifier?: string };
  sections: { id: string; label: string }[];
}

const { project, sections } = Astro.props;
const role = Astro.props.role ?? project.role;
const result = Astro.props.result ?? project.result;
// Archived projects are not on the homepage, so their back link goes to the work section.
const back = project.tier === 'archive' ? '/#work' : `/#project-${project.slug}`;
---

<header class="case-header wrap">
  <a class="back" href={back}><span aria-hidden="true">←</span> All work</a>
  <p class="lab-id note">case study · {project.year}</p>
  <h1>{project.title}</h1>
  <p class="summary">{project.summary}</p>

  <dl class="facts">
    {
      role && (
        <div>
          <dt>Role</dt>
          <dd>{role}</dd>
        </div>
      )
    }
    {
      project.status && (
        <div>
          <dt>Status</dt>
          <dd>{project.status}</dd>
        </div>
      )
    }
    <div class="key">
      <dt>Key result</dt>
      <dd>
        <strong>{result.headline}</strong>
        {result.qualifier && <span class="q">{result.qualifier}</span>}
      </dd>
    </div>
  </dl>

  <nav class="toc" aria-label="On this page">
    <p class="toc-label">On this page</p>
    <ul>
      {sections.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}
    </ul>
  </nav>
</header>

<style>
  .case-header {
    padding-top: var(--space-5);
    padding-bottom: var(--space-5);
  }

  .back {
    display: inline-flex;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
    padding-block: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .back:hover {
    color: var(--color-ink);
  }

  h1 {
    font-size: clamp(2.5rem, 1.6rem + 3.8vw, 4.25rem);
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .summary {
    max-width: 44rem;
    margin-top: var(--space-3);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    color: var(--color-ink-soft);
  }

  .facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4) var(--space-6);
    margin: var(--space-6) 0 0;
    padding-top: var(--space-4);
    border-top: var(--border-ink);
  }

  @media (min-width: 48rem) {
    .facts {
      grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    }
  }

  dd {
    margin: 2px 0 0;
    font-size: var(--text-sm);
    color: var(--color-ink);
  }

  dd strong {
    display: block;
    font-weight: 600;
  }

  @media (min-width: 48rem) {
    .key {
      grid-column: span 2;
    }
  }

  .q {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .toc {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-5);
    font-size: var(--text-sm);
  }

  .toc-label {
    color: var(--color-muted);
  }

  .toc ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    list-style: none;
  }

  .toc a {
    display: inline-block;
    padding-block: var(--space-1);
    text-decoration: underline;
    text-decoration-color: var(--color-rule-strong);
    text-underline-offset: 0.25em;
  }

  .toc a:hover {
    color: var(--color-accent-ink);
    text-decoration-color: currentColor;
  }

  .lab-id {
    margin-bottom: var(--space-3);
  }
  dt {
    font-weight: 600;
    color: var(--color-muted);
    font-family: var(--font-mono);
    text-transform: uppercase;
    font-size: var(--text-2xs);
    letter-spacing: .06em;
  }
</style>
