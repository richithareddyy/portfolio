---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  size?: 'main' | 'compact';
}

const { project, size = 'main' } = Astro.props;
const href = `/work/${project.slug}`;
const results = project.metrics.slice(0, size === 'main' ? 2 : 1);
---

<article class:list={['preview', size]} aria-labelledby={`${project.slug}-title`}>
  <header class="head">
    <p class="label">{project.kicker} · {project.year}</p>
    <h3 id={`${project.slug}-title`}>
      <a href={href} transition:name={`title-${project.slug}`}>{project.title}</a>
    </h3>
    <ul class="stack" aria-label="Main technologies">
      {project.tags.slice(0, 4).map((t) => <li>{t}</li>)}
    </ul>
  </header>

  <div class="body">
    {
      size === 'main' ? (
        <>
          <p>
            <strong>Problem.</strong> {project.problemShort}
          </p>
          <p>
            <strong>What I built.</strong> {project.contribution}
          </p>
        </>
      ) : (
        <p>{project.summary}</p>
      )
    }
    <p class="links">
      <a class="arrow-link" href={href}>
        Case study<span class="visually-hidden">: {project.title}</span> <span class="arrow" aria-hidden="true">→</span>
      </a>
      {
        project.links.map((link) => (
          <a class="text-link" href={link.href} target="_blank" rel="noopener">
            {link.label}
            <span class="visually-hidden"> for {project.title} (opens in a new tab)</span>
          </a>
        ))
      }
    </p>
  </div>

  <dl class="results">
    {
      results.map((m) => (
        <div>
          <dd class="value">{m.value}</dd>
          <dt>
            {m.label}
            {m.qualifier && <span class="qualifier">{m.qualifier}</span>}
          </dt>
        </div>
      ))
    }
  </dl>
</article>

<style>
  .preview {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4) var(--space-7);
    padding-block: var(--space-6);
    border-bottom: var(--border-hairline);
  }

  @media (min-width: 60rem) {
    .preview {
      grid-template-columns: 17.5rem minmax(0, 1fr) 12rem;
    }
  }

  .head {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .head .label {
    font-size: var(--text-xs);
  }

  h3 {
    font-size: var(--text-2xl);
  }

  .compact h3 {
    font-size: var(--text-xl);
  }

  h3 a {
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  h3 a:hover {
    color: var(--color-accent-ink);
  }

  .stack {
    margin-top: var(--space-1);
  }

  .body {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    max-width: 36rem;
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .body strong {
    font-weight: 600;
    color: var(--color-ink);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-1);
  }

  .results {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    margin: 0;
  }

  .results > div {
    display: grid;
    gap: 2px;
    padding-top: var(--space-2);
    border-top: var(--border-hairline);
  }

  .value {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-variant-numeric: tabular-nums lining-nums;
    line-height: 1.1;
  }

  dt {
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
    line-height: 1.45;
  }

  .qualifier {
    display: block;
    color: var(--color-muted);
  }

  @media (max-width: 59.99rem) {
    .results {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }
</style>
