---
import { experience } from '../data/experience';
import { education } from '../data/profile';
import { skills } from '../data/skills';
import SectionHeading from './SectionHeading.astro';
---

<section class="wrap section" id="experience" aria-labelledby="experience-title">
  <SectionHeading id="experience" note="newest first. school and tools are at the bottom.">Where I’ve <em>been</em></SectionHeading>

  <ol class="timeline">
    {
      experience.map((role) => (
        <li class:list={['role', role.current ? 'lead' : 'earlier']} data-role-id={`role:${role.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
          <p class="dates">{role.dates}{role.current && <span class="now note"> ← right now</span>}</p>
          <div class="what">
            <h3>
              {role.title}
              <span class="org">
                {role.org}
                {role.orgDetail && <span class="detail">, {role.orgDetail}</span>}
                <span class="detail"> · {role.place}</span>
              </span>
            </h3>
            <details class="fold" open={role.current}>
              <summary>what I did<span class="visually-hidden"> as {role.title}</span></summary>
              <ul class="points">
                {role.points.map((p) => <li>{p}</li>)}
              </ul>
            </details>
            {role.current && (
              <ul class="stack role-tech" aria-label="Technologies">
                {role.tech.map((t) => <li>{t}</li>)}
              </ul>
            )}
            {role.link && (
              <a class="arrow-link more" href={role.link.href}>
                {role.link.label} <span class="arrow" aria-hidden="true">→</span>
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ol>

  <h3 class="sub">School</h3>
  <ul class="edu">
    {
      education.map((e) => (
        <li>
          <p class="dates">{e.dates}</p>
          <div>
            <p class="degree">{e.degree}</p>
            <p class="meta">
              {e.school}<span class="detail"> · {e.place}</span>
            </p>
            <p class="gpa">GPA {e.gpa}</p>
          </div>
        </li>
      ))
    }
  </ul>

  <h3 class="sub" id="tools">Tools</h3>
  <dl class="tools">
    {
      skills.map((group) => (
        <div>
          <dt>{group.name}</dt>
          <dd>
            <ul class="stack">
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .section {
    padding-top: var(--section-gap);
  }

  .timeline,
  .edu {
    list-style: none;
  }

  .role,
  .edu li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2) var(--space-7);
    padding-block: var(--space-6);
    border-bottom: var(--border-hairline);
  }

  .role:first-child {
    padding-top: 0;
  }

  @media (min-width: 48rem) {
    .role,
    .edu li {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }

  .dates {
    padding-top: 0.35em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-muted);
    transition: color var(--duration-base) var(--ease-out);
  }

  /* The entry being read: its dates take the accent color. */
  .role.is-current .dates,
  .lead .dates {
    color: var(--color-accent-ink);
  }

  .now {
    display: block;
    margin-top: var(--space-1);
  }

  .what {
    display: grid;
    justify-items: start;
    min-width: 0;
  }

  h3 {
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-2xl);
    font-weight: 500;
  }

  .org {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }

  .detail {
    font-weight: 400;
    color: var(--color-muted);
  }

  .points {
    display: grid;
    gap: var(--space-2);
    max-width: 68ch;
    margin-top: var(--space-3);
    list-style: none;
    font-size: var(--text-base);
    line-height: 1.65;
    color: var(--color-ink-soft);
  }

  .points li {
    position: relative;
    padding-left: var(--space-4);
  }

  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.8em;
    width: 6px;
    height: 1px;
    background: var(--color-faint);
  }

  .role-tech,
  .more {
    margin-top: var(--space-3);
  }

  .more {
    font-size: var(--text-sm);
  }

  .earlier {
    padding-block: var(--space-5);
  }

  .earlier h3 {
    font-size: var(--text-lg);
  }

  .earlier .org {
    font-size: var(--text-sm);
  }

  .earlier .points {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .sub {
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    font-size: var(--text-2xl);
    font-weight: 450;
    font-style: italic;
  }

  .edu {
    border-top: var(--border-hairline);
  }

  .edu li {
    padding-block: var(--space-5);
  }

  .degree {
    max-width: 34rem;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 450;
    letter-spacing: -0.01em;
    line-height: 1.25;
    text-wrap: balance;
  }

  .tools {
    margin: 0;
    border-top: var(--border-hairline);
  }

  .tools div {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-1) var(--space-7);
    padding-block: var(--space-3);
    border-bottom: var(--border-hairline);
  }

  @media (min-width: 48rem) {
    .tools div {
      grid-template-columns: 11rem minmax(0, 1fr);
      align-items: baseline;
    }
  }

  .tools dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-muted);
  }

  .tools dd {
    margin: 0;
  }

  .tools .stack {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .meta {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink-soft);
  }

  .gpa {
    display: inline-block;
    margin-top: var(--space-2);
    padding: 0.1em 0.5em;
    border: 1px dashed var(--color-rule-strong);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-muted);
  }
</style>
