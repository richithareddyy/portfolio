---
import { experience } from '../data/experience';
import { education } from '../data/profile';
import SectionHeading from './SectionHeading.astro';
import { techId } from '../data/graph';
---

<section class="wrap section" id="experience" aria-labelledby="experience-title">
  <SectionHeading id="experience" note="newest first. school is at the bottom.">Where I’ve <em>been</em></SectionHeading>

  <ol class="timeline">
    {
      experience.map((role) => (
        <li class:list={['role', role.current ? 'lead' : 'earlier']} data-role-id={`role:${role.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
          <p class="dates">{role.dates}{role.current && <span class="now note"> ← right now</span>}</p>
          <div class="what">
            <h3>
              {role.title}
              <span class="org">
                {role.org}
                {role.orgDetail && <span class="detail">, {role.orgDetail}</span>}
                <span class="detail"> · {role.place}</span>
              </span>
            </h3>
            <ul class="points">
              {role.points.map((p) => <li>{p}</li>)}
            </ul>
            {role.current && (
              <ul class="stack role-tech" aria-label="Technologies">
                {role.tech.map((t) => <li><a class="tech-link" href="#skills" data-tech-link={techId(t)}>{t}<span class="visually-hidden">: show in skills map</span></a></li>)}
              </ul>
            )}
            {role.link && (
              <a class="arrow-link more" href={role.link.href}>
                {role.link.label} <span class="arrow" aria-hidden="true">→</span>
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ol>

  <h3 class="sub">School</h3>
  <ul class="edu">
    {
      education.map((e) => (
        <li>
          <p class="dates">{e.dates}</p>
          <div>
            <p class="degree">{e.degree}</p>
            <p class="meta">
              {e.school}, {e.place} · GPA {e.gpa}
            </p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .section {
    padding-top: var(--section-gap);
  }

  .timeline,
  .edu {
    list-style: none;
  }

  .role,
  .edu li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2) var(--space-7);
    padding-block: var(--space-6);
    border-bottom: var(--border-hairline);
  }

  .role:first-child {
    padding-top: 0;
  }

  @media (min-width: 48rem) {
    .role,
    .edu li {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }

  .dates {
    padding-top: 0.35em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-muted);
    transition: color var(--duration-base) var(--ease-out);
  }

  /* The entry being read: its dates take the accent color. */
  .role.is-current .dates,
  .lead .dates {
    color: var(--color-accent-ink);
  }

  .now {
    display: block;
    margin-top: var(--space-1);
  }

  .what {
    display: grid;
    justify-items: start;
    min-width: 0;
  }

  h3 {
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-2xl);
    font-weight: 500;
  }

  .org {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }

  .detail {
    font-weight: 400;
    color: var(--color-muted);
  }

  .points {
    display: grid;
    gap: var(--space-2);
    max-width: 68ch;
    margin-top: var(--space-3);
    list-style: none;
    font-size: var(--text-base);
    line-height: 1.65;
    color: var(--color-ink-soft);
  }

  .points li {
    position: relative;
    padding-left: var(--space-4);
  }

  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.8em;
    width: 6px;
    height: 1px;
    background: var(--color-faint);
  }

  .role-tech,
  .more {
    margin-top: var(--space-3);
  }

  .more {
    font-size: var(--text-sm);
  }

  .earlier {
    padding-block: var(--space-5);
  }

  .earlier h3 {
    font-size: var(--text-lg);
  }

  .earlier .org {
    font-size: var(--text-sm);
  }

  .earlier .points {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .sub {
    margin-top: var(--space-7);
    margin-bottom: var(--space-2);
    font-size: var(--text-lg);
    font-weight: 500;
  }

  .edu {
    border-top: var(--border-hairline);
  }

  .edu li {
    padding-block: var(--space-4);
  }

  .degree {
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .meta {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
</style>
