---
import { experience } from '../data/experience';
import { education } from '../data/profile';
import SectionHeading from './SectionHeading.astro';
---

<section class="wrap section" id="experience" aria-labelledby="experience-title">
  <SectionHeading id="experience">Experience and education</SectionHeading>

  <ol class="timeline">
    {
      experience.map((role) => (
        <li class:list={['role', { current: role.current }]} data-reveal>
          <p class="dates">{role.dates}</p>
          <div class="what">
            <h3>
              {role.title}
              <span class="org">
                {role.org}
                {role.orgDetail && <span class="detail">, {role.orgDetail}</span>}
                <span class="detail"> · {role.place}</span>
              </span>
            </h3>
            <ul class="points">
              {role.points.map((p) => <li>{p}</li>)}
            </ul>
            {role.link && (
              <a class="arrow-link more" href={role.link.href}>
                {role.link.label} <span class="arrow" aria-hidden="true">→</span>
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ol>

  <h3 class="sub">Education</h3>
  <ul class="edu">
    {
      education.map((e) => (
        <li>
          <p class="dates">{e.dates}</p>
          <div>
            <p class="degree">{e.degree}</p>
            <p class="meta">
              {e.school}, {e.place} · GPA {e.gpa}
            </p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .section {
    padding-top: var(--section-gap);
  }

  .timeline,
  .edu {
    list-style: none;
  }

  .role,
  .edu li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-1) var(--space-7);
    padding-block: var(--space-5);
    border-bottom: var(--border-hairline);
  }

  .role:first-child {
    padding-top: 0;
  }

  @media (min-width: 48rem) {
    .role,
    .edu li {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }

  .dates {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    padding-top: 0.35em;
  }

  .current .dates::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: var(--space-2);
    border-radius: 50%;
    background: var(--color-accent);
    vertical-align: 1px;
  }

  h3 {
    display: grid;
    gap: 2px;
    font-size: var(--text-xl);
  }

  .org {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--color-ink-soft);
  }

  .detail {
    font-weight: 400;
    color: var(--color-muted);
  }

  .points {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-3);
    max-width: 42rem;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .points li {
    position: relative;
    padding-left: var(--space-4);
  }

  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 6px;
    height: 1px;
    background: var(--color-faint);
  }

  .more {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }

  .sub {
    margin-top: var(--space-7);
    margin-bottom: var(--space-2);
    font-size: var(--text-lg);
  }

  .edu {
    border-top: var(--border-hairline);
  }

  .degree {
    font-weight: 500;
    font-size: var(--text-sm);
  }

  .meta {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
</style>
