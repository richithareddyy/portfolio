---
/*
  First visit only: the page starts as a closed notebook. The elastic band slides off, the cover swings open, and
  the page underneath is revealed. Any click, tap, or key skips it. BaseLayout decides before first paint whether it
  shows (the `intro` class on <html>), so it never flashes for returning visitors or under reduced motion.
*/
---

<div class="intro" aria-hidden="true" data-intro>
  <div class="shade"></div>
  <div class="nb-cover">
    <div class="front">
      <span class="stitch"></span>
      <div class="emboss">
        <svg class="monogram" focusable="false" viewBox="0 0 120 120"><path d="M6.0 66.7C38.4 60.7 76.2 62.7 114.0 57.7L112.0 82.5C76.2 86.5 38.4 85.5 8.0 88.5Z" class="swipe"/><g class="ink" transform="translate(9.04 84.55) scale(0.7303)"><path d="M34.87 -36.93Q40.69 -36.93 44.35 -40.01Q48 -43.08 48 -49.17Q48 -53.1 46.4 -55.82Q44.79 -58.55 41.12 -59.97Q37.46 -61.4 31.3 -61.4H14.93L16.17 -67.6H37.28Q45.73 -67.6 50.88 -65.35Q56.03 -63.1 58.37 -59.26Q60.72 -55.42 60.72 -50.62Q60.72 -46.12 58.68 -42.57Q56.65 -39.02 52.67 -36.71Q48.7 -34.4 42.74 -33.67V-33.95Q47.05 -33.73 49.56 -32.6Q52.07 -31.47 53.57 -29.19Q55.08 -26.92 56.25 -23.22L60.21 -10.95Q61.26 -7.69 62.28 -6.2Q63.3 -4.72 64.74 -4.34Q66.18 -3.97 68.4 -3.97V0.07Q62.44 0.48 58.76 0.33Q55.07 0.18 52.93 -0.79Q50.78 -1.77 49.58 -3.77Q48.38 -5.77 47.45 -9.02L43.82 -21.33Q42.72 -25.13 41.63 -27.21Q40.54 -29.28 38.81 -30.12Q37.09 -30.96 34.04 -30.96H15.95L14.7 -36.93ZM24.48 -67.6V-5.38L32.29 -2.68V0H4.05V-2.68L11.93 -5.38V-62.22L4.05 -64.92V-67.6Z"/><path transform="translate(70.80 0)" d="M37.26 -36.7Q42.66 -36.7 46.46 -38.84Q50.26 -40.98 52.27 -44.74Q54.28 -48.49 54.28 -53.27Q54.28 -57.65 51.4 -59.96Q48.51 -62.27 41.58 -62.27H26.83L29.34 -67.6H44.69Q51.88 -67.6 56.3 -65.96Q60.72 -64.32 62.72 -61.2Q64.71 -58.08 64.71 -53.7Q64.71 -48.22 62.1 -43.82Q59.49 -39.42 54.37 -36.69Q49.25 -33.97 41.75 -33.58V-33.87Q45.22 -33.63 47.22 -32.37Q49.22 -31.11 50.3 -28.71Q51.37 -26.31 52.09 -22.54L54.6 -10.67Q55.29 -7.38 56.14 -5.85Q56.99 -4.31 58.27 -3.89Q59.55 -3.46 61.52 -3.46L60.62 0Q55.87 0.33 53.01 0.15Q50.15 -0.04 48.56 -0.99Q46.96 -1.93 46.12 -3.86Q45.27 -5.78 44.68 -8.92L41.73 -23.85Q41.18 -27.07 40.32 -28.67Q39.45 -30.28 38.05 -30.82Q36.65 -31.37 34.38 -31.37H18.09L18.99 -36.7ZM17.19 -4.8 24.26 -2.46 23.5 0H-2.08L-1.32 -2.46L6.87 -4.98L24.46 -62.8L17.39 -65.14L18.15 -67.6H36.34Z"/></g></svg>
        <p class="title">Richitha Rekula</p>
        <p class="sub">notebook</p>
      </div>
      <span class="band"></span>
    </div>
    <div class="back">
      <p class="belongs">This notebook belongs to</p>
      <p class="owner">Richitha Rekula</p>
    </div>
  </div>
</div>

<script>
  const root = document.documentElement;
  const intro = document.querySelector<HTMLElement>('[data-intro]');

  if (intro && root.classList.contains('intro')) {
    const timers: number[] = [];
    const at = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
    let finished = false;

    const finish = () => {
      if (finished) return;
      finished = true;
      timers.forEach(clearTimeout);
      intro.classList.add('is-gone');
      window.setTimeout(() => {
        root.classList.remove('intro');
        intro.remove();
        document.dispatchEvent(new Event('intro:done'));
      }, 320);
    };

    // The closed notebook holds for two seconds; then the band comes off, the cover opens, and it fades away.
    // A skip jumps straight to a quick open.
    at(2000, () => intro.classList.add('band-off'));
    at(2400, () => intro.classList.add('is-open'));
    at(3400, finish);

    const skip = () => {
      if (finished) return;
      timers.forEach(clearTimeout);
      intro.classList.add('band-off', 'is-open', 'is-fast');
      window.setTimeout(finish, 380);
    };
    addEventListener('pointerdown', skip, { once: true });
    addEventListener('keydown', skip, { once: true });
    addEventListener('wheel', skip, { once: true, passive: true });
  }
</script>

<style>
  .intro {
    display: none;
  }

  :global(html.intro) {
    overflow: hidden;
  }

  :global(html.intro) .intro {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: block;
    perspective: 2400px;
    /* If the script never runs, the cover gets out of the way on its own. */
    animation: failsafe 0s 7s forwards;
    transition: opacity 300ms var(--ease-out);
  }

  .intro.is-gone {
    opacity: 0;
    pointer-events: none;
  }

  /* The cover's shadow on the page underneath, lifting as it opens. */
  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgb(25 25 21 / 0.28), rgb(25 25 21 / 0.06) 45%, transparent 70%);
    opacity: 1;
    transition: opacity 900ms var(--ease-out);
  }

  .is-open .shade {
    opacity: 0;
  }

  .nb-cover {
    position: absolute;
    inset: 0;
    transform-origin: left center;
    transform-style: preserve-3d;
    transition: transform 1000ms cubic-bezier(0.62, 0.02, 0.24, 1);
  }

  .is-open .nb-cover {
    transform: rotateY(-118deg);
  }

  .is-fast .nb-cover,
  .is-fast .shade {
    transition-duration: 360ms;
  }

  .front,
  .back {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
  }

  .front {
    display: grid;
    place-items: center;
    border-left: clamp(14px, 2.2vw, 30px) solid color-mix(in srgb, var(--pen) 72%, #000);
    background: var(--pen);
    box-shadow: inset -18px 0 40px -30px rgb(0 0 0 / 0.45);
  }

  .stitch {
    position: absolute;
    inset: clamp(14px, 2.4vw, 30px);
    border: 2px dashed color-mix(in srgb, var(--pen) 55%, #fff);
    border-radius: 14px;
    opacity: 0.6;
  }

  .emboss {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    text-align: center;
  }

  /* Pressed into the cover: a darker shape with a faint light edge below it. */
  .monogram {
    width: clamp(7rem, 15vw, 13rem);
    overflow: visible;
    filter: drop-shadow(0 1px 0 rgb(255 255 255 / 0.28));
  }

  .monogram :global(.ink) {
    fill: color-mix(in srgb, var(--pen) 55%, #000);
  }

  .monogram :global(.swipe) {
    fill: color-mix(in srgb, var(--pen) 55%, #fff);
    opacity: 0.55;
  }

  .title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.3rem + 2.4vw, 3.6rem);
    letter-spacing: -0.01em;
    color: color-mix(in srgb, var(--pen) 55%, #000);
    text-shadow: 0 1px 0 rgb(255 255 255 / 0.25);
  }

  .sub {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--pen) 45%, #fff);
  }

  .band {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 13%;
    width: clamp(12px, 1.4vw, 20px);
    background: linear-gradient(to right, #2c2622, #45403a 45%, #2c2622);
    box-shadow: 2px 0 6px rgb(0 0 0 / 0.25);
    transition: transform 380ms cubic-bezier(0.5, 0, 0.2, 1), opacity 380ms var(--ease-out);
  }

  .band-off .band {
    transform: translateX(28vw) rotate(4deg);
    opacity: 0;
  }

  /* Inside of the cover, seen while it turns. */
  .back {
    display: grid;
    place-content: center;
    gap: var(--space-2);
    padding: var(--space-6);
    background: var(--color-surface);
    transform: rotateY(180deg);
    text-align: center;
  }

  .belongs {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  .owner {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.8rem, 1.3rem + 2vw, 3rem);
    color: var(--pen-ink);
    border-bottom: 1.5px solid var(--color-rule-strong);
  }

  @keyframes failsafe {
    to {
      visibility: hidden;
      pointer-events: none;
    }
  }
</style>
