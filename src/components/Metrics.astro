---
import type { Metric } from '../data/projects';

interface Props {
  metrics: readonly Metric[];
  note?: string;
}

const { metrics, note } = Astro.props;
---

<div>
  <dl class="metrics">
    {
      metrics.map((m) => (
        <div>
          <dd>{m.value}</dd>
          <dt>
            {m.label}
            {m.qualifier && <span class="qualifier">{m.qualifier}</span>}
          </dt>
        </div>
      ))
    }
  </dl>
  {note && <p class="note">{note}</p>}
</div>

<style>
  .metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    border-top: var(--border-hairline);
  }

  @media (min-width: 48rem) {
    .metrics {
      grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    }
  }

  .metrics > div {
    display: grid;
    align-content: start;
    gap: 2px;
    padding: var(--space-3) var(--space-4) var(--space-3) 0;
    border-bottom: var(--border-hairline);
  }

  dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-variant-numeric: tabular-nums lining-nums;
    line-height: 1.1;
  }

  dt {
    font-size: var(--text-xs);
    line-height: 1.45;
    color: var(--color-ink-soft);
  }

  .qualifier {
    display: block;
    color: var(--color-muted);
  }

  .note {
    margin-top: var(--space-3);
    max-width: var(--width-prose);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  dd { font-family: var(--font-mono); font-size: var(--text-lg); line-height: 1.4; color: var(--color-accent-ink); }

</style>
