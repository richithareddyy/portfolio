---
import type { DataTable } from '../data/projects';
interface Props {
  table: DataTable;
}
const { table } = Astro.props;
const lastIsTotal = table.rows.at(-1)?.[0] === 'total';
---

<figure class="data-table">
  <div class="scroll" tabindex="0" role="region" aria-label={`${table.caption} (scrolls horizontally on small screens)`}>
    <table>
      <caption>{table.caption}</caption>
      <thead>
        <tr>{table.columns.map((c) => <th scope="col">{c}</th>)}</tr>
      </thead>
      <tbody>
        {
          table.rows.map((row, r) => (
            <tr class:list={{ total: lastIsTotal && r === table.rows.length - 1 }}>
              {row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  {table.note && <figcaption>{table.note}</figcaption>}
</figure>

<style>
  .data-table {
    margin: 0;
    min-width: 0;
  }

  .scroll {
    overflow-x: auto;
    border-top: var(--border-ink);
  }

  .scroll:focus-visible {
    outline-offset: 2px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  caption {
    padding: var(--space-2) 0;
    text-align: left;
    font-weight: 600;
    color: var(--color-ink);
  }

  th,
  td {
    padding: var(--space-2) var(--space-3) var(--space-2) 0;
    border-bottom: var(--border-hairline);
    text-align: right;
    white-space: nowrap;
  }

  thead th {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-muted);
  }

  th:first-child {
    text-align: left;
    white-space: normal;
    min-width: 11rem;
  }

  tbody th {
    font-weight: 400;
    color: var(--color-ink-soft);
  }

  td {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink);
  }

  .total th,
  .total td {
    font-weight: 600;
    border-top: var(--border-strong);
  }

  figcaption {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
</style>
