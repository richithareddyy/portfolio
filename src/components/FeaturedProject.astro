---
import { zoomLens, type Project } from '../data/projects';
import Mark from './Mark.astro';
import Doodle from './Doodle.astro';
import ProjectLinks from './ProjectLinks.astro';
import ZoomLensPreview from './ZoomLensPreview.astro';
import CauseWayChart from './visuals/CauseWayChart.astro';
import GridCastChart from './visuals/GridCastChart.astro';

interface Props {
  project: Project;
  index?: number;
  eager?: boolean;
}

const { project, index = 0, eager = false } = Astro.props;
const href = project.caseStudy ? `/work/${project.slug}` : undefined;
const flip = index % 2 === 1;
// ZoomLens shows its product site and demo; the studies show one chart from their results.
const Chart = { causeway: CauseWayChart, gridcast: GridCastChart }[project.slug];
const media = project.slug === 'zoom-lens' || !!Chart;
---

<article
  class:list={['featured', { flip: flip && media, 'text-only': !media }]}
  id={`project-${project.slug}`}
  aria-labelledby={`${project.slug}-title`}
  data-project-id={`project:${project.slug}`}
>
  <div class="text">
    <div class="lead">
      <p class="meta">
        <span class="num" aria-hidden="true"><Mark kind="circle">{String(index + 1).padStart(2, '0')}</Mark></span>
        <span>{[project.role, project.year].filter(Boolean).join(' · ')}</span>
      </p>
      <h3 id={`${project.slug}-title`}>
        {href ? <a href={href}>{project.title}</a> : project.title}
      </h3>
      {project.hook && <p class="hook">{project.hook}</p>}
      <p class="summary">{project.summary}</p>
      <p class="result">
        <strong>{project.result.headline}<Doodle kind="star" class="result-star" /></strong>
        {project.result.qualifier && <span>{project.result.qualifier}</span>}
      </p>
    </div>

    <div class="detail">
      {
        project.story && (
          <details class="fold">
            <summary>Project details<span class="visually-hidden"> of {project.title}</span></summary>
            <dl class="story">
              {project.story.map((beat) => (
                <div>
                  <dt>{beat.label}</dt>
                  <dd>{beat.text}</dd>
                </div>
              ))}
            </dl>
            <ul class="stack" aria-label={`${project.title} technologies`}>
              {project.tech.map((t) => <li>{t}</li>)}
            </ul>
          </details>
        )
      }
      <ProjectLinks project={project} />
    </div>
  </div>

  {
    Chart && (
      <div class="media">
        <Chart />
      </div>
    )
  }

  {
    project.slug === 'zoom-lens' && (
      <div class="media">
        <ZoomLensPreview eager={eager} />
        {zoomLens.demoVideo && (
          <figure class="demo">
            <div class="laptop">
              <div class="screen">
                <video
                  src={zoomLens.demoVideo}
                  poster={zoomLens.demoPoster}
                  width="1280"
                  height="832"
                  controls
                  playsinline
                  preload="none"
                  aria-label="ZoomLens demo: describing a spreadsheet, follow-up questions, and the accessibility features in a live Zoom meeting"
                />
              </div>
              <div class="base" aria-hidden="true"><span class="notch"></span></div>
            </div>
            <figcaption>3-minute demo in a live Zoom meeting, with captions. The data shown is fictional.</figcaption>
          </figure>
        )}
      </div>
    )
  }
</article>

<style>
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    padding-block: var(--space-8);
    border-top: var(--border-hairline);
  }

  .featured:first-of-type {
    border-top: 0;
    padding-top: 0;
  }

  /* A slight paper lift on hover, and when keyboard focus is inside the project. */
  .featured {
    transition: transform var(--duration-base) var(--ease-out);
  }

  .featured:focus-within {
    transform: translateY(-2px);
  }

  @media (hover: hover) and (pointer: fine) {
    .featured:hover {
      transform: translateY(-2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured:hover,
    .featured:focus-within {
      transform: none;
    }
  }

  @media (min-width: 60rem) {
    /* The one project with a visual gets the wider column, so it leads the section. */
    .featured:not(.text-only) {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-9);
      /* Top-aligned so the text stays put when an interactive visual changes height. */
      align-items: start;
    }

    .flip .text {
      order: 2;
    }

    /* Without a visual, the problem and the story sit side by side. */
    .text-only .text {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: var(--space-9);
    }

    .text-only .story {
      margin-top: 0;
    }
  }

  .text,
  .lead,
  .detail {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    justify-items: start;
    min-width: 0;
  }

  .meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .num {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-style: italic;
    line-height: 1;
    color: var(--pen);
  }

  h3 {
    font-size: clamp(2.5rem, 1.6rem + 3vw, 4rem);
    font-weight: 450;
    letter-spacing: -0.03em;
    line-height: 0.98;
  }

  h3 a {
    text-decoration: none;
    background-image: linear-gradient(var(--pen), var(--pen));
    background-size: 0 2px;
    background-repeat: no-repeat;
    background-position: 0 92%;
    transition: background-size var(--duration-base) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }

  h3 a:hover {
    background-size: 100% 2px;
  }

  .hook {
    max-width: 34rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-xl);
    line-height: 1.3;
  }

  .hook::before {
    content: 'the problem';
    display: block;
    margin-bottom: var(--space-1);
    font-family: var(--font-mono);
    font-style: normal;
    font-size: var(--text-xs);
    color: var(--pen-ink);
  }

  .summary {
    max-width: 38rem;
    font-size: var(--text-md);
    color: var(--color-ink-soft);
  }

  /* The headline result, marked like a margin note so it is the first thing a skim lands on. */
  .result {
    display: grid;
    gap: 2px;
    max-width: 34rem;
    padding-left: var(--space-3);
    border-left: 3px solid var(--pen);
  }

  .result strong {
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--color-ink);
  }

  .result strong :global(.result-star) {
    width: 0.85em;
    height: 0.85em;
    margin-left: 0.3em;
    vertical-align: -0.05em;
  }

  .result > span {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .story {
    display: grid;
    gap: var(--space-4);
    max-width: 38rem;
    margin: var(--space-2) 0 0;
    padding-left: var(--space-4);
    border-left: 2px solid var(--pen);
  }

  dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
    text-transform: lowercase;
  }

  dt::after {
    content: ':';
  }

  dd {
    margin: var(--space-1) 0 0;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  .media {
    min-width: 0;
  }

  /* The recorded demo sits under the product site, filling the column beside the text. */
  .demo {
    margin: var(--space-7) 0 0;
  }

  /* An ink-drawn laptop around the recording: a dark bezel with a camera dot, then a cream keyboard base. */
  .laptop {
    padding-inline: 6%;
  }

  .screen {
    position: relative;
    padding: 2.4% 2.4% 3.2%;
    border: 1.5px solid var(--color-ink);
    border-radius: 14px 14px 4px 4px;
    background: var(--color-ink);
  }

  .screen::before {
    content: '';
    position: absolute;
    top: 0.9%;
    left: 50%;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #4a443d;
    transform: translateX(-50%);
  }

  .demo video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 3px;
    background: var(--color-panel);
  }

  .base {
    position: relative;
    height: clamp(0.7rem, 1.6vw, 1.15rem);
    margin-inline: -6%;
    border: 1.5px solid var(--color-ink);
    border-radius: 2px 2px 16px 16px / 2px 2px 12px 12px;
    background: var(--color-surface);
    box-shadow: 0 14px 22px -16px rgb(25 25 21 / 0.45);
  }

  .notch {
    position: absolute;
    top: -1.5px;
    left: 50%;
    width: 15%;
    height: 45%;
    border: 1.5px solid var(--color-ink);
    border-top: 0;
    border-radius: 0 0 8px 8px;
    background: var(--color-surface-sunken);
    transform: translateX(-50%);
  }

  .demo figcaption {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
</style>
