---
import type { Project } from '../data/projects';
import { techId } from '../data/graph';
import ProjectLinks from './ProjectLinks.astro';
import ZoomLensPreview from './ZoomLensPreview.astro';

interface Props {
  project: Project;
  index?: number;
  eager?: boolean;
}

const { project, index = 0, eager = false } = Astro.props;
const href = project.caseStudy ? `/work/${project.slug}` : undefined;
const flip = index % 2 === 1;
// Only ZoomLens carries a visual here; the others keep their figures on the case study.
const media = project.slug === 'zoom-lens';
---

<article
  class:list={['featured', { flip: flip && media, 'text-only': !media }]}
  id={`project-${project.slug}`}
  aria-labelledby={`${project.slug}-title`}
  data-project-id={`project:${project.slug}`}
>
  <div class="text">
    <div class="lead">
      <p class="meta">
        <span class="num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <span>{[project.role, project.year].filter(Boolean).join(' · ')}</span>
      </p>
      <h3 id={`${project.slug}-title`}>
        {href ? <a href={href}>{project.title}</a> : project.title}
      </h3>
      {project.hook && <p class="hook">{project.hook}</p>}
      <p class="summary">{project.summary}</p>
    </div>

    <div class="detail">
      {
        project.story && (
          <dl class="story">
            {project.story.map((beat) => (
              <div>
                <dt>{beat.label}</dt>
                <dd>{beat.text}</dd>
              </div>
            ))}
          </dl>
        )
      }

      <ul class="stack" aria-label={`${project.title} technologies`}>
        {
          project.tech.map((t) => (
            <li>
              <a class="tech-link" href="#skills" data-tech-link={techId(t)}>
                {t}
                <span class="visually-hidden">: show in skills map</span>
              </a>
            </li>
          ))
        }
      </ul>
      <ProjectLinks project={project} />
    </div>
  </div>

  {
    media && (
      <div class="media">
        <ZoomLensPreview eager={eager} />
      </div>
    )
  }
</article>

<style>
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    padding-block: var(--space-8);
    border-top: var(--border-hairline);
  }

  .featured:first-of-type {
    border-top: 0;
    padding-top: 0;
  }

  @media (min-width: 60rem) {
    .featured:not(.text-only) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-9);
      /* Top-aligned so the text stays put when an interactive visual changes height. */
      align-items: start;
    }

    .flip .text {
      order: 2;
    }

    .media {
      position: sticky;
      top: calc(var(--header-height) + var(--space-6));
    }

    /* Without a visual, the problem and the story sit side by side. */
    .text-only .text {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: var(--space-9);
    }

    .text-only .story {
      margin-top: 0;
    }
  }

  .text,
  .lead,
  .detail {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    justify-items: start;
    min-width: 0;
  }

  .meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .num {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-style: italic;
    line-height: 1;
    color: var(--pen);
  }

  h3 {
    font-size: clamp(2.5rem, 1.6rem + 3vw, 4rem);
    font-weight: 450;
    letter-spacing: -0.03em;
    line-height: 0.98;
  }

  h3 a {
    text-decoration: none;
    background-image: linear-gradient(var(--pen), var(--pen));
    background-size: 0 2px;
    background-repeat: no-repeat;
    background-position: 0 92%;
    transition: background-size var(--duration-base) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }

  h3 a:hover {
    background-size: 100% 2px;
  }

  .hook {
    max-width: 34rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-xl);
    line-height: 1.3;
  }

  .hook::before {
    content: 'the problem';
    display: block;
    margin-bottom: var(--space-1);
    font-family: var(--font-mono);
    font-style: normal;
    font-size: var(--text-xs);
    color: var(--pen-ink);
  }

  .summary {
    max-width: 38rem;
    font-size: var(--text-md);
    color: var(--color-ink-soft);
  }

  .story {
    display: grid;
    gap: var(--space-4);
    max-width: 38rem;
    margin: var(--space-2) 0 0;
    padding-left: var(--space-4);
    border-left: 2px solid var(--pen);
  }

  dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
    text-transform: lowercase;
  }

  dt::after {
    content: ':';
  }

  dd {
    margin: var(--space-1) 0 0;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  .media {
    min-width: 0;
  }
</style>
