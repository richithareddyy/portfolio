---
/*
  A featured project: the problem first, then how it was built, then the stack and links.
  Each one carries its own visual, and the layout alternates so no two read alike.
*/
import type { Project } from '../data/projects';
import { techId } from '../data/graph';
import ProjectVisual from './ProjectVisual.astro';
import ProjectLinks from './ProjectLinks.astro';
import ZoomLensPreview from './ZoomLensPreview.astro';
import CodeAtlasTrace from './visuals/CodeAtlasTrace.astro';
import EtlLedger from './visuals/EtlLedger.astro';

interface Props {
  project: Project;
  index?: number;
  eager?: boolean;
}

const { project, index = 0, eager = false } = Astro.props;
const href = project.caseStudy ? `/work/${project.slug}` : undefined;
const flip = index % 2 === 1;
---

<article
  class:list={['featured', `is-${project.slug}`, { flip }]}
  id={`project-${project.slug}`}
  aria-labelledby={`${project.slug}-title`}
  data-project-id={`project:${project.slug}`}
>
  <div class="text">
    <p class="meta">
      <span class="num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
      <span>{[project.role, project.year].filter(Boolean).join(' · ')}</span>
    </p>
    <h3 id={`${project.slug}-title`}>
      {href ? <a href={href}>{project.title}</a> : project.title}
    </h3>
    {project.hook && <p class="hook">{project.hook}</p>}
    <p class="summary">{project.summary}</p>

    {
      project.story && (
        <dl class="story">
          {project.story.map((beat) => (
            <div>
              <dt>{beat.label}</dt>
              <dd>{beat.text}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <ul class="stack" aria-label={`${project.title} technologies`}>
      {
        project.tech.map((t) => (
          <li>
            <a class="tech-link" href="#skills" data-tech-link={techId(t)}>
              {t}
              <span class="visually-hidden">: show in skills map</span>
            </a>
          </li>
        ))
      }
    </ul>
    <ProjectLinks project={project} />
  </div>

  <div class="media">
    {
      project.slug === 'zoom-lens' ? (
        <ZoomLensPreview eager={eager} />
      ) : project.slug === 'codeatlas' ? (
        <CodeAtlasTrace />
      ) : project.slug === 'reddit-data-pipeline' ? (
        <EtlLedger />
      ) : (
        <ProjectVisual visual={project.visual} size="feature" eager={eager} href={href} />
      )
    }
  </div>
</article>

<style>
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    padding-block: var(--space-8);
    border-top: var(--border-hairline);
  }

  .featured:first-of-type {
    border-top: 0;
    padding-top: 0;
  }

  @media (min-width: 60rem) {
    .featured {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-9);
      /* Top-aligned so the text stays put when an interactive visual changes height. */
      align-items: start;
    }

    .flip .text {
      order: 2;
    }

    /* The receipt is narrow; give the text more room beside it. */
    .is-reddit-data-pipeline {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    }

    .media {
      position: sticky;
      top: calc(var(--header-height) + var(--space-6));
    }
  }

  .text {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    min-width: 0;
  }

  .meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .num {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-style: italic;
    line-height: 1;
    color: var(--pen);
  }

  h3 {
    font-size: clamp(2.5rem, 1.6rem + 3vw, 4rem);
    font-weight: 450;
    letter-spacing: -0.03em;
    line-height: 0.98;
  }

  h3 a {
    text-decoration: none;
    background-image: linear-gradient(var(--pen), var(--pen));
    background-size: 0 2px;
    background-repeat: no-repeat;
    background-position: 0 92%;
    transition: background-size var(--duration-base) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }

  h3 a:hover {
    background-size: 100% 2px;
  }

  /* The problem comes first, in the voice of the person who has it. */
  .hook {
    max-width: 34rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-xl);
    line-height: 1.3;
  }

  .hook::before {
    content: 'the problem';
    display: block;
    margin-bottom: var(--space-1);
    font-family: var(--font-mono);
    font-style: normal;
    font-size: var(--text-xs);
    color: var(--pen-ink);
  }

  .summary {
    max-width: 38rem;
    font-size: var(--text-md);
    color: var(--color-ink-soft);
  }

  .story {
    display: grid;
    gap: var(--space-4);
    max-width: 38rem;
    margin: var(--space-2) 0 0;
    padding-left: var(--space-4);
    border-left: 2px solid var(--pen);
  }

  dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  dt {
    text-transform: lowercase;
  }

  dt::after {
    content: ':';
  }

  dd {
    margin: var(--space-1) 0 0;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  .media {
    min-width: 0;
  }
</style>
