---
import type { Project } from '../data/projects';
import { techId } from '../data/graph';
import { domains } from '../data/projects';
import ProjectVisual from './ProjectVisual.astro';
import ProjectLinks from './ProjectLinks.astro';

interface Props {
  project: Project;
  emphasis?: 'primary' | 'secondary';
  flip?: boolean;
  eager?: boolean;
}

const { project, emphasis = 'primary', flip = false, eager = false } = Astro.props;
const href = project.caseStudy ? `/work/${project.slug}` : undefined;
---

<article
  class:list={['featured', emphasis, { flip }]}
  id={`project-${project.slug}`}
  aria-labelledby={`${project.slug}-title`}
  data-reveal
  data-project-id={`project:${project.slug}`}
  data-domains={project.domains.join(' ')}
  data-demo={project.demo ? 'true' : 'false'}
>
  <div class="text">
    <p class="year">{[project.year, project.role].filter(Boolean).join(' · ')}</p>
    <p class="meta-data">
      <span><b>Domain</b> {project.domains.map((d) => domains.find((x) => x.id === d)?.label).join(' · ')}</span>
      {project.status && <span><b>Status</b> {project.status.split(';')[0]}</span>}
    </p>
    <h3 id={`${project.slug}-title`}>
      {href ? <a href={href} transition:name={`title-${project.slug}`}>{project.title}</a> : project.title}
    </h3>
    <p class="summary">{project.summary}</p>

    <dl class="facts">
      <div>
        <dt>My contribution</dt>
        <dd>{project.contribution}</dd>
      </div>
      <div>
        <dt>{project.slug === 'zoom-lens' ? 'Status' : 'Result'}</dt>
        <dd>
          <strong>{project.result.headline}</strong>
          {project.result.qualifier && <span class="qualifier">{project.result.qualifier}</span>}
        </dd>
      </div>
    </dl>

    <ul class="stack" aria-label="Technologies">
      {project.tech.map((t) => <li><button type="button" class="tech-link" data-tech-link={techId(t)}>{t}</button></li>)}
    </ul>
    <ProjectLinks project={project} />
  </div>

  <div class="media">
    {Astro.slots.has('visual') ? <slot name="visual" /> : <ProjectVisual visual={project.visual} size="feature" eager={eager} href={href} />}
  </div>
</article>

<style>
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    padding-block: var(--space-7);
    border-bottom: var(--border-hairline);
  }

  .featured:first-of-type {
    padding-top: var(--space-2);
  }

  @media (min-width: 60rem) {
    .featured {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: var(--space-8);
      align-items: center;
    }

    .flip .text {
      order: 2;
    }

    .secondary {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    }
  }

  .text {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    min-width: 0;
  }

  .meta-data {
    display: flex;
    flex-wrap: wrap;
    gap: 2px var(--space-5);
    margin-top: calc(var(--space-2) * -1);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.02em;
    color: var(--color-muted);
  }

  .meta-data b {
    margin-right: 0.5em;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-faint);
  }

  .year {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  h3 {
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .secondary h3 {
    font-size: var(--text-2xl);
  }

  h3 a {
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  h3 a:hover {
    color: var(--color-accent-ink);
  }

  .summary {
    max-width: 34rem;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--color-ink-soft);
  }

  .facts {
    display: grid;
    gap: var(--space-3);
    max-width: 34rem;
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
  }

  dt {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-muted);
  }

  dd {
    margin: 2px 0 0;
    color: var(--color-ink-soft);
  }

  dd strong {
    display: block;
    font-weight: 600;
    color: var(--color-ink);
  }

  .qualifier {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .media {
    min-width: 0;
  }
</style>
