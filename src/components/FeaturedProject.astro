---
import type { Project } from '../data/projects';
import { techId } from '../data/graph';
import ProjectVisual from './ProjectVisual.astro';
import ProjectLinks from './ProjectLinks.astro';

interface Props {
  project: Project;
  eager?: boolean;
}

const { project, eager = false } = Astro.props;
const href = project.caseStudy ? `/work/${project.slug}` : undefined;
---

<article
  class="featured"
  id={`project-${project.slug}`}
  aria-labelledby={`${project.slug}-title`}
  data-project-id={`project:${project.slug}`}
>
  <div class="text">
    <p class="meta">{[project.role, project.year].filter(Boolean).join(' · ')}</p>
    <h3 id={`${project.slug}-title`}>
      {href ? <a href={href} transition:name={`title-${project.slug}`}>{project.title}</a> : project.title}
    </h3>
    <p class="summary">{project.summary}</p>

    {
      project.story && (
        <dl class="story">
          {project.story.map((beat) => (
            <div>
              <dt>{beat.label}</dt>
              <dd>{beat.text}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <ul class="stack" aria-label={`${project.title} technologies`}>
      {project.tech.map((t) => <li><button type="button" class="tech-link" data-tech-link={techId(t)}>{t}</button></li>)}
    </ul>
    <ProjectLinks project={project} />
  </div>

  <div class="media">
    {Astro.slots.has('visual') ? <slot name="visual" /> : <ProjectVisual visual={project.visual} size="feature" eager={eager} href={href} />}
  </div>
</article>

<style>
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    padding-block: var(--space-8);
    border-bottom: var(--border-hairline);
  }

  .featured:first-of-type {
    padding-top: var(--space-2);
  }

  @media (min-width: 60rem) {
    .featured {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: var(--space-8);
      /* Top-aligned so the text stays put when an interactive visual changes height. */
      align-items: start;
    }

    .media {
      position: sticky;
      top: calc(var(--header-height) + var(--space-5));
    }
  }

  .text {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    min-width: 0;
  }

  .meta {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  h3 {
    margin-top: calc(var(--space-2) * -1);
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  h3 a {
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  h3 a:hover {
    color: var(--color-accent-ink);
  }

  .summary {
    max-width: 38rem;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--color-ink-soft);
  }

  .story {
    display: grid;
    gap: var(--space-4);
    max-width: 38rem;
    margin: var(--space-2) 0 0;
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-accent);
  }

  dt {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  dd {
    margin: var(--space-1) 0 0;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  .media {
    min-width: 0;
  }
</style>
