---
import { projects, type Project } from '../data/projects';
import { techId } from '../data/graph';
import { domains } from '../data/projects';
import ProjectVisual from './ProjectVisual.astro';
import ProjectLinks from './ProjectLinks.astro';

interface Props {
  project: Project;
  emphasis?: 'primary' | 'secondary';
  flip?: boolean;
  eager?: boolean;
}

const { project, emphasis = 'primary', flip = false, eager = false } = Astro.props;
const projectNumber = String(projects.findIndex(p => p.slug === project.slug) + 1).padStart(2, '0');
const href = project.caseStudy ? `/work/${project.slug}` : undefined;
---

<article
  class:list={['featured', emphasis, { flip }]}
  id={`project-${project.slug}`}
  aria-labelledby={`${project.slug}-title`}
  data-reveal
  data-project-id={`project:${project.slug}`}
  data-domains={project.domains.join(' ')}
  data-demo={project.demo ? 'true' : 'false'}
>
  <div class="text">
    <p class="lab-id">PROJECT / {projectNumber}</p>
    <p class="year">
      {[project.year, project.role, project.domains.map((d) => domains.find((x) => x.id === d)?.label).join(', ')].filter(Boolean).join(' · ')}
    </p>
    <h3 id={`${project.slug}-title`}>
      {href ? <a href={href} transition:name={`title-${project.slug}`}>{project.title}</a> : project.title}
    </h3>
    <p class="summary">{project.summary}</p>

    <dl class="facts">
      <div>
        <dt>{project.slug === 'zoom-lens' ? 'Status' : 'Observation'}</dt>
        <dd>
          <strong>{project.result.headline}</strong>
          {project.result.qualifier && <span class="qualifier">{project.result.qualifier}</span>}
        </dd>
      </div>
    </dl>

    <ul class="stack" aria-label="Technologies">
      {project.tech.map((t) => <li><button type="button" class="tech-link" data-tech-link={techId(t)}>{t}</button></li>)}
    </ul>
    <ProjectLinks project={project} />
    <details class="contribution">
      <summary>My contribution<span class="visually-hidden"> to {project.title}</span></summary>
      <p>{project.contribution}</p>
    </details>
  </div>

  <div class="media">
    {Astro.slots.has('visual') ? <slot name="visual" /> : <ProjectVisual visual={project.visual} size="feature" eager={eager} href={href} />}
  </div>
</article>

<style>
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    padding-block: var(--space-7);
    border-bottom: var(--border-hairline);
  }

  .featured:first-of-type {
    padding-top: var(--space-2);
  }

  @media (min-width: 60rem) {
    .featured {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: var(--space-8);
      /* Top-aligned so the text stays put when an interactive visual changes height. */
      align-items: start;
    }


    .secondary {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    }
  }

  .text {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    min-width: 0;
  }

  .year {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  h3 {
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .secondary h3 {
    font-size: var(--text-2xl);
  }

  h3 a {
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  h3 a:hover {
    color: var(--color-accent-ink);
  }

  .summary {
    max-width: 34rem;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--color-ink-soft);
  }

  .facts {
    display: grid;
    gap: var(--space-3);
    max-width: 34rem;
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
  }

  dt {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-muted);
  }

  dd {
    margin: 2px 0 0;
    color: var(--color-ink-soft);
  }

  dd strong {
    display: block;
    font-weight: 600;
    color: var(--color-ink);
  }

  .qualifier {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .contribution { max-width: 34rem; font-size: var(--text-sm); color: var(--color-ink-soft); }
  .contribution summary { cursor: pointer; min-height: 2.75rem; padding-block: var(--space-2); color: var(--color-ink); }
  .contribution summary:hover { color: var(--color-accent-ink); }
  .contribution p { padding-bottom: var(--space-2); }

  .media {
    min-width: 0;
  }

  .facts { width: 100%; border-left: 2px solid var(--color-accent); padding: var(--space-3) var(--space-4); background: var(--color-surface); }
  dt { font-family: var(--font-mono); text-transform: uppercase; font-size: var(--text-2xs); letter-spacing: .08em; margin-bottom: var(--space-2); }
  .summary { font-size: var(--text-md); line-height: 1.6; }
  h3 { font-weight: 500; }

</style>
