---
/*
  The drawing beside the name: an ink-drop character typing on a notebook rule, with a coffee cup, a taped-in code
  window, and a lightbulb. Clicking the character makes it wave and say hello; clicking the bulb switches it on.
  Most of it stays still. The idle motion pauses offscreen and is left out entirely under reduced motion.
*/
---

<div class="scene" data-scene>
  <svg class="art" viewBox="0 0 400 300" aria-hidden="true" focusable="false" data-scene-art>
    <defs>
      <filter id="scene-pencil" x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="7" result="grain" />
        <feDisplacementMap in="SourceGraphic" in2="grain" scale="1.3" />
      </filter>
      <clipPath id="shirt-clip"><path d="M165 186 C172 180 208 180 215 186 L221 222 L159 222 Z" /></clipPath>
    </defs>

    <g class="rules">
      <path d="M0 96 H400 M0 128 H400 M0 160 H400 M0 192 H400 M0 224 H400 M0 256 H400" />
      <path class="margin-line" d="M30 70 V290 M33.5 70 V290" />
    </g>

    <g filter="url(#scene-pencil)">
      <g class="code" transform="rotate(-4 106 76)">
        <rect class="tape" x="84" y="30" width="44" height="12" />
        <rect class="paper" x="46" y="38" width="122" height="76" rx="4" />
        <path class="ink thin" d="M46 52 H168" />
        <circle class="ink thin" cx="54" cy="45" r="2" />
        <circle class="ink thin" cx="61" cy="45" r="2" />
        <circle class="ink thin" cx="68" cy="45" r="2" />
        <text class="code-text" x="54" y="68"><tspan class="kw">def</tspan> notebook():</text>
        <text class="code-text" x="54" y="82">    ideas = <tspan class="kw">[]</tspan></text>
        <text class="code-text" x="54" y="96">    <tspan class="kw">return</tspan> ideas</text>
        <rect class="caret" x="141" y="88" width="1.6" height="10" />
      </g>

      <g class="bulb" data-bulb-art>
        <path class="rays" pathLength="1" d="M262 58 V50 M238 68 L232 62 M286 68 L292 62 M232 90 H224 M292 90 H300" />
        <path class="glass" d="M262 70 C248 70 240 80 240 90 C240 99 246 104 249 110 L275 110 C278 104 284 99 284 90 C284 80 276 70 262 70 Z" />
        <path class="filament" d="M254 98 L258 90 L262 98 L266 90 L270 98" />
        <path class="ink" d="M250 115 H274 M252 120 H272 M256 125 H268" />
      </g>

      <g class="thought">
        <circle cx="224" cy="140" r="2.2" />
        <circle cx="234" cy="128" r="3" />
      </g>

      <g class="cup">
        <path class="steam s1" d="M312 176 C308 170 316 166 312 158" />
        <path class="steam s2" d="M323 176 C319 168 327 164 323 154" />
        <path class="steam s3" d="M334 176 C330 170 338 166 334 158" />
        <path class="paper" d="M300 184 H344 V210 C344 219 337 224 328 224 H316 C307 224 300 219 300 210 Z" />
        <path class="band" d="M300 194 H344" />
        <path class="ink" d="M344 191 C354 191 357 196 357 201 C357 207 352 211 344 210" />
      </g>

      <g class="inky">
        <path class="hair" d="M190 108 C163 108 148 126 147 150 C146 166 143 178 140 189 C136 195 134 203 139 208 C135 214 141 221 148 218 C150 224 159 225 163 219 L217 219 C221 225 230 224 232 218 C239 221 245 214 241 208 C246 203 244 195 240 189 C237 178 234 166 233 150 C232 126 217 108 190 108 Z" />
        <path class="strand" d="M157 158 C152 174 151 190 145 205 M164 172 C161 188 160 200 155 214 M223 158 C228 174 229 190 235 205 M216 172 C219 188 220 200 225 214" />
        <path class="leg" d="M180 220 C179 231 178 240 176 249 M176 249 C172 250 169 251 167 253" />
        <path class="leg" d="M200 220 C201 231 202 240 204 249 M204 249 C208 250 211 251 213 253" />
        <g class="arm arm-left"><path class="sleeve-edge" d="M164 189 C156 197 157 206 165 211" /><path class="sleeve" d="M164 189 C156 197 157 206 165 211" /></g>
        <g class="arm arm-right"><path class="sleeve-edge" d="M216 189 C224 197 223 206 215 211" /><path class="sleeve" d="M216 189 C224 197 223 206 215 211" /></g>
        <path class="shirt" d="M165 186 C172 180 208 180 215 186 L221 222 L159 222 Z" />
        <g clip-path="url(#shirt-clip)">
          <path class="stripes" d="M160 180 V224 M165 180 V224 M170 180 V224 M175 180 V224 M180 180 V224 M185 180 V224 M190 180 V224 M195 180 V224 M200 180 V224 M205 180 V224 M210 180 V224 M215 180 V224 M220 180 V224" />
        </g>
        <path class="skin" d="M184 168 H196 V184 C193 187 187 187 184 184 Z" />
        <path class="collar" d="M181 182 L190 192 L199 182" />
        <ellipse class="skin" cx="190" cy="151" rx="21" ry="23" />
        <path class="hair" d="M169 156 C166 134 177 124 190 125 C203 124 214 134 211 156 C209 144 201 136 191 135 L190 132 L189 135 C179 136 171 144 169 156 Z" />
        <path class="hair" d="M170 146 C165 162 164 178 160 192 C156 198 156 205 161 207 C160 212 166 214 168 208 C170 196 169 176 172 156 Z" />
        <path class="hair" d="M210 146 C215 162 216 178 220 192 C224 198 224 205 219 207 C220 212 214 214 212 208 C210 196 211 176 208 156 Z" />
        <path class="strand" d="M180 129 C174 133 170 140 169 149 M200 129 C206 133 210 140 211 149" />
        <circle class="earring" cx="170" cy="163" r="1.9" />
        <path class="brow" d="M178 145 Q182 143 186 145 M194 145 Q198 143 202 145" />
        <g class="eyes">
          <ellipse class="eye-dot" cx="182" cy="153" rx="2.5" ry="3.2" />
          <ellipse class="eye-dot" cx="198" cy="153" rx="2.5" ry="3.2" />
          <circle class="eye-glint" cx="183" cy="152" r="0.8" />
          <circle class="eye-glint" cx="199" cy="152" r="0.8" />
        </g>
        <path class="eyes-happy" d="M178.5 154 Q182 149.5 185.5 154 M194.5 154 Q198 149.5 201.5 154" />
        <ellipse class="cheek" cx="176" cy="161" rx="3.6" ry="2.2" />
        <ellipse class="cheek" cx="204" cy="161" rx="3.6" ry="2.2" />
        <path class="nose" d="M190 155 Q191.5 159 189.5 160" />
        <path class="mouth" d="M185.5 164 Q190 168 194.5 164" />
        <g class="laptop">
          <path class="paper" d="M162 190 L218 186 L222 214 L164 217 Z" />
          <circle class="logo" cx="192" cy="202" r="3.2" />
          <path class="ink" d="M156 217 L226 213 L230 219 L152 222 Z" />
        </g>
        <g class="wave-arm"><path class="sleeve-edge" d="M216 188 C228 180 234 170 236 160" /><path class="sleeve" d="M216 188 C228 180 234 170 236 160" /><circle class="skin hand" cx="237" cy="155" r="4.6" /></g>
      </g>

    </g>
  </svg>

  <button type="button" class="hit hit-inky" data-inky aria-label="Say hi to my doodle"></button>
  <button type="button" class="hit hit-bulb" data-bulb aria-label="Switch on the lightbulb"></button>
  <p class="bubble" role="status" data-bubble><span>Hi! Thanks for visiting.</span></p>
  <span class="plane-start" data-plane-start aria-hidden="true"></span>
</div>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const scene of document.querySelectorAll<HTMLElement>('[data-scene]')) {
    const bubble = scene.querySelector<HTMLElement>('[data-bubble]')!;
    let waveTimer: number | undefined;
    let bulbTimer: number | undefined;

    const light = () => {
      scene.classList.add('is-lit');
      clearTimeout(bulbTimer);
      bulbTimer = window.setTimeout(() => scene.classList.remove('is-lit'), 1800);
    };

    scene.querySelector('[data-inky]')!.addEventListener('click', () => {
      scene.classList.remove('is-waving');
      void scene.offsetWidth;
      scene.classList.add('is-waving');
      bubble.classList.add('is-open');
      light();
      clearTimeout(waveTimer);
      waveTimer = window.setTimeout(() => {
        scene.classList.remove('is-waving');
        bubble.classList.remove('is-open');
      }, 3200);
    });
    scene.querySelector('[data-bulb]')!.addEventListener('click', light);

    // Idle motion only runs while the drawing is on screen.
    if (!reduce) {
      new IntersectionObserver(([entry]) => scene.classList.toggle('is-offscreen', !entry.isIntersecting)).observe(scene);
    }
  }
</script>

<style>
  .scene {
    position: relative;
    width: min(24rem, 100%);
    margin-top: var(--space-6);
  }

  /* Beside the name on wide screens, where the right half of the first screen is empty. */
  @media (min-width: 75rem) {
    .scene {
      position: absolute;
      top: 50%;
      right: 0;
      margin: 0;
      translate: 0 -48%;
    }
  }

  @media (min-width: 90rem) {
    .scene {
      width: 28rem;
    }
  }

  .art {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .art :global(*) {
    vector-effect: non-scaling-stroke;
  }

  .rules path {
    fill: none;
    stroke: var(--color-rule);
    stroke-width: 1;
  }

  .rules .margin-line {
    stroke: var(--pen);
    opacity: 0.3;
  }

  .ink,
  .leg,
  .wave-arm,
  .eyes-happy,
  .steam,
  .rays,
  .filament,
  .glass,
  .paper {
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .thin {
    stroke-width: 1.1;
  }

  .paper,
  .glass {
    fill: var(--color-surface);
  }

  .tape {
    fill: color-mix(in srgb, var(--pen-wash) 85%, transparent);
  }

  .code-text {
    font-family: var(--font-mono);
    font-size: 8.5px;
    fill: var(--color-ink-soft);
    white-space: pre;
  }

  .code-text .kw {
    fill: var(--pen-ink);
  }

  .caret {
    fill: var(--pen);
  }

  .band {
    fill: none;
    stroke: var(--pen);
    stroke-width: 2.4;
  }

  .steam {
    stroke: var(--color-faint);
    stroke-width: 1.3;
    opacity: 0.7;
  }

  .thought circle {
    fill: none;
    stroke: var(--color-faint);
    stroke-width: 1.2;
  }

  .filament {
    stroke: var(--color-faint);
    stroke-width: 1.2;
  }

  .rays {
    stroke: var(--pen);
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 400ms var(--ease-out);
  }

  .glass {
    transition: fill var(--duration-base) var(--ease-out);
  }

  /* The character: long dark wavy hair with a center part, a striped shirt in the pen ink, small gold earrings. */
  .hair {
    fill: var(--color-ink);
  }

  /* Lighter pencil strands so the hair reads as wavy, not as one solid shape. */
  .strand {
    fill: none;
    stroke: #5a4e44;
    stroke-width: 1;
    stroke-linecap: round;
    opacity: 0.85;
  }

  .skin {
    fill: #c99270;
    stroke: var(--color-ink);
    stroke-width: 1.1;
  }

  .shirt {
    fill: var(--pen-wash);
    stroke: var(--color-ink);
    stroke-width: 1.3;
  }

  .stripes {
    fill: none;
    stroke: var(--pen);
    stroke-width: 1.1;
    opacity: 0.5;
  }

  .collar,
  .brow {
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .earring {
    fill: #d4a72c;
    stroke: #8a6a10;
    stroke-width: 0.6;
  }

  .eye-dot {
    fill: var(--color-ink);
  }

  .eye-glint {
    fill: #fff;
  }

  .nose {
    fill: none;
    stroke: #8a5a3c;
    stroke-width: 1.1;
    stroke-linecap: round;
  }

  .leg {
    stroke-width: 4;
  }

  .sleeve-edge,
  .sleeve {
    fill: none;
    stroke-linecap: round;
  }

  .sleeve-edge {
    stroke: var(--color-ink);
    stroke-width: 8.6;
  }

  .sleeve {
    stroke: var(--pen-wash);
    stroke-width: 6;
  }

  .eyes,
  .arm,
  .wave-arm {
    transform-box: fill-box;
  }

  .eyes {
    transform-origin: center;
  }

  .eyes-happy {
    stroke: var(--color-ink);
    stroke-width: 1.8;
    opacity: 0;
  }

  .cheek {
    fill: #e8846f;
    opacity: 0.55;
  }

  .mouth {
    fill: none;
    stroke: #6b2f2a;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .logo {
    fill: var(--pen);
  }

  .wave-arm {
    opacity: 0;
    transform-origin: 0% 100%;
  }

  .inky {
    transform-box: view-box;
    transform-origin: 190px 224px;
  }

  /* Lit bulb */
  .is-lit .glass {
    fill: var(--pen-wash);
  }

  .is-lit .filament {
    stroke: var(--pen);
  }

  .is-lit .rays {
    stroke-dashoffset: 0;
  }

  /* Waving: the right arm comes up, the eyes smile, the bubble opens. */
  .is-waving .arm-right {
    opacity: 0;
  }

  .is-waving .wave-arm,
  .is-waving .eyes-happy {
    opacity: 1;
  }

  .is-waving .eyes {
    opacity: 0;
  }

  /* Invisible buttons over the character and the bulb, so both work by touch and keyboard. */
  .hit {
    position: absolute;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .hit:focus-visible {
    outline: 2px dashed var(--pen-ink);
    outline-offset: 2px;
  }

  .hit-inky {
    left: 33%;
    top: 35%;
    width: 30%;
    height: 50%;
  }

  .hit-bulb {
    left: 58%;
    top: 21%;
    width: 15%;
    height: 22%;
  }

  .bubble {
    position: absolute;
    left: 8%;
    top: 31%;
    max-width: 10.5rem;
    padding: var(--space-2) var(--space-3);
    border: 1.5px solid var(--color-ink);
    border-radius: 14px 14px 4px 14px;
    background: var(--color-surface);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-md);
    line-height: 1.25;
    color: var(--color-ink);
    opacity: 0;
    transform: translateY(4px) rotate(-3deg) scale(0.96);
    transform-origin: right bottom;
    pointer-events: none;
    transition: opacity var(--duration-base) var(--ease-out), transform var(--duration-base) var(--ease-out);
  }

  .bubble.is-open {
    opacity: 1;
    transform: rotate(-3deg);
  }

  .plane-start {
    position: absolute;
    left: 16.5%;
    top: 85.3%;
    width: 0;
    height: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .eyes {
      animation: blink 5.5s infinite;
    }

    .arm-left {
      animation: type 7s ease-in-out infinite;
    }

    .arm-right {
      animation: type 7s ease-in-out 0.12s infinite;
    }

    .caret {
      animation: caret 1.1s steps(1) infinite;
    }

    .inky {
      animation: tilt 12s var(--ease-out) infinite;
    }

    .steam {
      animation: drift 5s ease-in-out infinite;
    }

    .s2 {
      animation-delay: 1.6s;
    }

    .s3 {
      animation-delay: 3.2s;
    }

    .is-waving .inky {
      animation: none;
    }

    .is-waving .wave-arm {
      animation: wave 0.5s ease-in-out 4 alternate;
    }

    .is-offscreen :global(*) {
      animation-play-state: paused !important;
    }
  }

  @keyframes blink {
    0%,
    93%,
    100% {
      transform: scaleY(1);
    }

    96% {
      transform: scaleY(0.1);
    }
  }

  @keyframes type {
    0%,
    42%,
    100% {
      transform: none;
    }

    6%,
    18%,
    30% {
      transform: translateY(1.8px);
    }

    12%,
    24%,
    36% {
      transform: none;
    }
  }

  @keyframes caret {
    50% {
      opacity: 0;
    }
  }

  @keyframes tilt {
    0%,
    72%,
    100% {
      transform: rotate(0deg);
    }

    78%,
    90% {
      transform: rotate(-5deg);
    }
  }

  @keyframes drift {
    0%,
    100% {
      opacity: 0.25;
      transform: translateY(2px);
    }

    50% {
      opacity: 0.75;
      transform: translateY(-3px);
    }
  }

  @keyframes wave {
    from {
      transform: rotate(-12deg);
    }

    to {
      transform: rotate(14deg);
    }
  }
</style>
