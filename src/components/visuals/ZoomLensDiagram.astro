---
/* Diagram of the Zoom Lens panel and answer routing. Labels come from the prototype's interface. */
const actions = [
  { name: 'Describe', label: 'What is on the shared screen' },
  { name: 'Explain', label: 'What the content means' },
  { name: 'Follow-up', label: 'Ask about the last answer' },
];
---

<div class="zl-diagram" role="img" aria-label="Diagram: a Zoom meeting window with the shared screen on the left and the Zoom Lens panel on the right offering Describe, Explain, and Follow-up. A request goes from the panel to the server, which addresses the answer to the requesting participant only.">
  <div class="window" aria-hidden="true">
    <div class="screen">
      <span class="tag">Shared screen</span>
      <span class="line w80"></span>
      <span class="line w60"></span>
      <span class="bars"><i style="--h:40%"></i><i style="--h:65%"></i><i style="--h:90%"></i><i style="--h:75%"></i></span>
    </div>
    <div class="panel">
      <span class="panel-title">Zoom Lens</span>
      {
        actions.map((a) => (
          <span class="action">
            <b>{a.name}</b>
            <small>{a.label}</small>
          </span>
        ))
      }
      <span class="foot">Only you see your answers.</span>
    </div>
  </div>
  <ol class="route" aria-hidden="true">
    <li>Request from one participant</li>
    <li>Server: one recipient, no broadcast, must match a request</li>
    <li>Answer to that participant only</li>
  </ol>
</div>

<style>
  .zl-diagram {
    display: grid;
    gap: var(--space-3);
    min-height: 100%;
    padding: var(--space-4);
    container-type: inline-size;
  }

  .window {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    gap: var(--space-2);
    min-height: 0;
    padding: var(--space-2);
    background: var(--color-ink);
    border-radius: var(--radius-sm);
  }

  .screen {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--space-3);
    background: var(--color-surface);
    border-radius: var(--radius-xs);
  }

  .tag {
    font-size: var(--text-2xs);
    font-weight: 600;
    color: var(--color-muted);
  }

  .line {
    height: 5px;
    background: var(--color-rule);
    border-radius: 2px;
  }

  .w80 {
    width: 80%;
  }

  .w60 {
    width: 60%;
  }

  .bars {
    flex: 1;
    display: flex;
    align-items: flex-end;
    gap: 6px;
    min-height: 2.5rem;
    padding-top: var(--space-2);
    border-bottom: 1px solid var(--color-rule-strong);
  }

  .bars i {
    flex: 1;
    height: var(--h);
    background: var(--color-rule-strong);
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: var(--space-2);
    background: var(--color-panel);
    border-radius: var(--radius-xs);
    color: var(--color-panel-ink);
  }

  .panel-title {
    font-size: var(--text-2xs);
    font-weight: 600;
    color: var(--color-panel-muted);
  }

  .action {
    display: grid;
    padding: 4px 6px;
    border: 1px solid var(--color-panel-line);
    border-radius: 3px;
    line-height: 1.25;
  }

  .action b {
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .action small {
    font-size: 0.625rem;
    color: var(--color-panel-muted);
  }

  .foot {
    margin-top: auto;
    font-size: 0.625rem;
    color: var(--color-panel-muted);
  }

  .route {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
    list-style: none;
    counter-reset: step;
  }

  .route li {
    position: relative;
    padding: var(--space-2);
    font-size: var(--text-2xs);
    line-height: 1.35;
    background: var(--color-bg);
    border: var(--border-strong);
    border-radius: var(--radius-xs);
  }

  .route li:nth-child(2) {
    border-color: var(--color-ink);
  }

  .route li:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: calc(var(--space-2) * -0.85);
    top: 50%;
    transform: translateY(-50%);
    font-size: var(--text-xs);
    color: var(--color-ink);
    background: var(--color-surface);
    line-height: 1;
  }

  @container (max-width: 22rem) {
    .action small,
    .foot {
      display: none;
    }

    .route li {
      font-size: 0.625rem;
      padding: 6px;
    }
  }
</style>
