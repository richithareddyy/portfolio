---
/* Interactive view of the Reddit ETL pipeline. Every figure comes from the project README (generated benchmark data). */
const stages = [
  {
    id: 'extract',
    input: 'Plain, gzip, or Zstandard NDJSON',
    output: 'Parsed records, one line at a time',
    validation: 'Source line numbers carried into validation',
    name: 'Extract',
    does: 'Streams plain, gzip, or Zstandard NDJSON line by line, parsing with orjson, so memory stays constant.',
    tech: ['Python', 'orjson'],
    metric: '18,897,027 lines read (5.9 GB)',
  },
  {
    id: 'validate',
    input: 'Parsed records',
    output: 'Valid rows; rejected lines with reasons',
    validation: 'Shape, required fields, IDs, names, and ranges',
    name: 'Validate',
    does: 'Checks JSON shape, required fields, base-36 IDs, name rules, timestamp and integer ranges. Every rejected line is kept with its source line number and reason.',
    tech: ['Python'],
    metric: '111,408 invalid lines recorded',
  },
  {
    id: 'stage',
    input: 'Validated rows',
    output: 'Unlogged staging tables',
    validation: 'Constraints deliberately deferred to merge and check',
    name: 'Stage',
    does: 'Valid rows land in unlogged, constraint-free staging tables through one COPY per entity, in 50K-row chunks.',
    tech: ['PostgreSQL', 'COPY'],
    metric: 'Parse, validate, and COPY: 97 s',
  },
  {
    id: 'merge',
    input: 'Staged entities',
    output: 'Upserted rows; duplicates and orphans recorded',
    validation: 'Only strictly newer data updates existing rows',
    name: 'Merge',
    does: 'One window-function pass finds superseded duplicates and orphans; the upsert anti-joins against that small set and applies only strictly newer data.',
    tech: ['SQL', 'PostgreSQL'],
    metric: '21,826 duplicates and 53,793 orphans set aside · 137 s',
  },
  {
    id: 'check',
    input: 'Merged PostgreSQL tables',
    output: 'Rebuilt indexes and a data-quality report',
    validation: '5 foreign keys and 13 checks; errors fail the run',
    name: 'Check',
    does: 'Rebuilds 7 secondary indexes, validates 5 foreign keys, then runs 13 data-quality checks. A failed error-level check fails the run.',
    tech: ['SQL', 'GitHub Actions'],
    metric: '13 / 13 checks passed · 110 s for indexes, keys, and checks',
  },
];
const uid = `etl-${Math.random().toString(36).slice(2, 7)}`;
---

<figure class="etl" data-etl>
  <p class="source-label lab-label">Data source / Reddit-format NDJSON archives</p>
  <ol class="stages" role="tablist" aria-label="Pipeline stages">
    {
      stages.map((s, i) => (
        <li>
          <button
            type="button"
            role="tab"
            class="choice"
            id={`${uid}-${s.id}`}
            aria-controls={`${uid}-panel`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-stage={s.id}
          >
            <span class="i">{String(i + 1).padStart(2, '0')}</span>
            {s.name}
          </button>
          {i < stages.length - 1 && (
            <span class="pipe" aria-hidden="true">
              <i />
              <i />
              <i />
            </span>
          )}
        </li>
      ))
    }
  </ol>

  <div class="detail" id={`${uid}-panel`} role="tabpanel" tabindex="0" aria-labelledby={`${uid}-extract`} aria-live="polite">
    {
      stages.map((s, i) => (
        <div class="stage-detail" data-detail={s.id} aria-hidden={i !== 0 ? "true" : undefined}>
          <dl class="stage-record">
            <div><dt>Input</dt><dd>{s.input}</dd></div>
            <div><dt>Process</dt><dd>{s.does}</dd></div>
            <div><dt>Output</dt><dd>{s.output}</dd></div>
            <div><dt>Validation</dt><dd>{s.validation}</dd></div>
          </dl>
          <p class="metric">{s.metric}</p>
          <ul class="stack" aria-label="Tools">
            {s.tech.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="ledger" aria-label="Where every line went">
    <span><b>18,897,027</b> read</span>
    <span class="ok"><b>18,710,000</b> loaded</span>
    <span class="bad"><b>187,027</b> rejected and recorded</span>
  </div>
  <figcaption>Interactive diagram. Figures from the full-scale benchmark on generated data with injected defects.</figcaption>
</figure>

<script>
  function setupEtl() {
    for (const fig of document.querySelectorAll<HTMLElement>('[data-etl]:not([data-ready])')) {
      fig.dataset.ready = 'true';
      const tabs = Array.from(fig.querySelectorAll<HTMLButtonElement>('[data-stage]'));
      const select = (id: string, focus = false) => {
        tabs.forEach((t, i) => {
          const on = t.dataset.stage === id;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
          if (on && focus) t.focus();
          // Replay the flow into the next stage once.
          const pipe = t.parentElement?.querySelector<HTMLElement>('.pipe');
          if (pipe) {
            pipe.classList.remove('is-flowing');
            if (on) {
              void pipe.offsetWidth;
              pipe.classList.add('is-flowing');
            }
          }
          t.closest('li')?.classList.toggle('is-done', tabs.findIndex((x) => x.dataset.stage === id) > i);
        });
        for (const d of fig.querySelectorAll<HTMLElement>('[data-detail]')) {
          if (d.dataset.detail === id) d.removeAttribute('aria-hidden');
          else d.setAttribute('aria-hidden', 'true');
        }
        fig.querySelector('[role="tabpanel"]')?.setAttribute('aria-labelledby', tabs.find(t => t.dataset.stage === id)!.id);
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => select(t.dataset.stage!));
        t.addEventListener('keydown', (e) => {
          if (e.key === 'Home' || e.key === 'End') {
            e.preventDefault(); select(tabs[e.key === 'Home' ? 0 : tabs.length - 1].dataset.stage!, true); return;
          }
          const dir = ['ArrowRight', 'ArrowDown'].includes(e.key) ? 1 : ['ArrowLeft', 'ArrowUp'].includes(e.key) ? -1 : 0;
          if (!dir) return;
          e.preventDefault();
          select(tabs[(i + dir + tabs.length) % tabs.length].dataset.stage!, true);
        });
      });
    }
  }
  document.addEventListener('astro:page-load', setupEtl);
</script>

<style>
  .etl {
    margin: 0;
    padding: var(--space-4);
    border: var(--border-hairline);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .stages {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    list-style: none;
  }

  .stages li {
    position: relative;
    display: flex;
    align-items: center;
  }

  .stages button {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 2px;
    justify-items: start;
    width: 100%;
    min-height: 3.25rem;
    padding: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
    text-align: left;
  }

  .i {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-accent-ink);
  }



  /* Connector between stages; dots travel along it once when the stage before it is selected. */
  .pipe {
    position: absolute;
    right: calc(var(--space-2) * -1);
    width: var(--space-2);
    height: 2px;
    background: var(--color-rule-strong);
    overflow: visible;
  }

  .pipe i {
    position: absolute;
    top: -2px;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .pipe.is-flowing i {
      animation: flow var(--duration-slow) var(--ease-out) forwards;
    }

    .pipe.is-flowing i:nth-child(2) {
      animation-delay: calc(var(--duration-fast) * 0.66);
    }

    .pipe.is-flowing i:nth-child(3) {
      animation-delay: calc(var(--duration-fast) * 1.33);
    }

    @keyframes flow {
      0% {
        opacity: 0;
        transform: translateX(-10px);
      }
      30% {
        opacity: 1;
      }
      100% {
        opacity: 0;
        transform: translateX(14px);
      }
    }
  }

  .stages li:not(:last-child) button {
    margin-right: var(--space-2);
  }

  .stage-detail { grid-area: 1 / 1; }
  .stage-detail[aria-hidden="true"] { visibility: hidden; }
  .detail {
    display: grid;
    min-height: 7.5rem;
    margin-top: var(--space-4);
  }

  .does {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .metric {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink);
  }

  .stage-detail .stack {
    margin-top: var(--space-2);
  }

  .ledger {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: var(--border-hairline);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .ledger b {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--color-ink);
  }

  .ledger .bad b {
    color: var(--color-accent-ink);
  }

  figcaption {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  @media (max-width: 34rem) {
    .stages {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2);
    }

    .stages li:not(:last-child) button {
      margin-right: 0;
    }

    .stages button {
      grid-auto-flow: column;
      justify-content: start;
      align-items: baseline;
      gap: var(--space-3);
      min-height: 2.75rem;
    }

    .pipe {
      display: none;
    }
  }

  .source-label { margin-bottom: var(--space-4); padding-bottom: var(--space-3); border-bottom: var(--border-hairline); }
  .stage-record { margin: 0; display: grid; gap: var(--space-2); font-size: var(--text-xs); }
  .stage-record > div { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: var(--space-2); }
  .stage-record dt { font-family: var(--font-mono); font-size: var(--text-2xs); text-transform: uppercase; color: var(--color-muted); }
  .stage-record dd { margin: 0; color: var(--color-ink-soft); }
  .metric { border-top: var(--border-hairline); padding-top: var(--space-3); color: var(--color-accent-ink); }
  @media (max-width: 34rem) {
    .stages { padding-left: var(--space-3); border-left: var(--border-hairline); }
    .stages li::before { content: ''; position: absolute; left: -16px; width: 7px; height: 7px; border: 1px solid var(--color-rule-strong); background: var(--color-bg); border-radius: 50%; }
    .stages li:has([aria-selected='true'])::before { background: var(--color-accent); border-color: var(--color-accent); }
    .stage-record > div { grid-template-columns: minmax(0,1fr); gap: 2px; }
  }
</style>
