---
/* The real Zoom Lens screenshot with annotation markers, and the product flow behind it. Markers are added for this page. */
import { Image } from 'astro:assets';
import shot from '../../assets/projects/zoom-lens-meeting.webp';

interface Props {
  href?: string;
  eager?: boolean;
}
const { href, eager = false } = Astro.props;

// Marker positions are percentages of the screenshot (2000 x 1300).
const marks = [
  { n: 1, x: 44, y: 20, title: 'Shared screen', body: 'What the presenter is sharing. Here, a paper’s first page.' },
  { n: 2, x: 72, y: 25, title: 'Zoom Lens panel', body: 'Opened from the Apps panel. It sits beside the meeting, in this participant’s window only.' },
  { n: 3, x: 83, y: 33, title: 'Describe screen · Explain this', body: 'Describe reports what is shown; Explain reasons about what it means.' },
  { n: 4, x: 71, y: 41, title: 'Answer', body: 'Names the paper, its authors, venue, and page, instead of describing it vaguely.' },
  { n: 5, x: 93, y: 72.5, title: 'Follow-up', body: 'One question about the last answer.' },
  { n: 6, x: 71, y: 76.5, title: 'Only you see your answers', body: 'The answer is routed to this participant’s session only.' },
];
const steps = [
  {
    id: 'input',
    name: 'Input',
    marks: [2, 3, 5],
    body: 'The participant opens Zoom Lens from the Apps panel and chooses Describe screen or Explain this, or types one follow-up.',
  },
  {
    id: 'context',
    name: 'Context',
    marks: [1],
    body: 'The prototype captures what is on that participant’s display. Capturing the meeting feed directly is not enabled yet.',
  },
  {
    id: 'ai',
    name: 'AI processing',
    marks: [4],
    body: 'Claude generates the answer for the chosen action, reporting the real titles, numbers, and headings on screen.',
  },
  {
    id: 'private',
    name: 'Private response',
    marks: [6],
    body: 'The server addresses the answer to exactly one session, has no broadcast path, and refuses replies that do not match a request.',
  },
];
const uid = `zl-${Math.random().toString(36).slice(2, 7)}`;
---

<figure class="zl" data-zl>
  <div class="shot" data-depth={href ? '' : undefined}>
    <Image
      src={shot}
      alt="Zoom Lens in a live Zoom meeting: a paper is shared on screen, and the Zoom Lens panel on the right shows a Describe answer naming the paper, its authors, and its venue, with an Ask a follow-up box and the note Only you see your answers."
      widths={[640, 960, 1280, 1600]}
      sizes="(min-width: 64rem) 40rem, 92vw"
      loading={eager ? 'eager' : 'lazy'}
    />
    {href && <a class="cover" href={href} tabindex="-1" aria-hidden="true"></a>}
    {
      marks.map((m) => (
        <button
          type="button"
          class="mark"
          style={`left:${m.x}%;top:${m.y}%`}
          data-mark={m.n}
          aria-describedby={`${uid}-tip-${m.n}`}
        >
          <span aria-hidden="true">{m.n}</span>
          <span class="visually-hidden">{m.title}</span>
          <span class="tip" role="tooltip" id={`${uid}-tip-${m.n}`}>
            <b>{m.title}</b>
            {m.body}
          </span>
        </button>
      ))
    }
  </div>

  <ol class="flow" role="tablist" aria-label="How a request flows">
    {
      steps.map((s, i) => (
        <li>
          <button
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls={`${uid}-flow`}
            data-step={s.id}
            data-marks={s.marks.join(' ')}
          >
            <span class="i">{String(i + 1).padStart(2, '0')}</span>
            {s.name}
          </button>
        </li>
      ))
    }
  </ol>
  <div class="flow-detail" id={`${uid}-flow`} role="tabpanel" aria-live="polite">
    <p class="flow-empty">Select a step, or a numbered marker, to see how a request moves through Zoom Lens.</p>
    {
      steps.map((s) => (
        <p class="flow-body" data-flow={s.id} hidden>
          {s.body}
        </p>
      ))
    }
  </div>
  <figcaption>Screenshot of the prototype in a live meeting. Numbered markers are annotations added for this page.</figcaption>
</figure>

<script>
  function setupZoomLens() {
    for (const fig of document.querySelectorAll<HTMLElement>('[data-zl]:not([data-ready])')) {
      fig.dataset.ready = 'true';
      const steps = Array.from(fig.querySelectorAll<HTMLButtonElement>('[data-step]'));
      const marks = Array.from(fig.querySelectorAll<HTMLElement>('[data-mark]'));
      const empty = fig.querySelector<HTMLElement>('.flow-empty')!;
      let current: string | null = null;

      const select = (id: string | null) => {
        current = id && id !== current ? id : null;
        const active = steps.find((s) => s.dataset.step === current);
        const lit = new Set((active?.dataset.marks ?? '').split(' ').filter(Boolean));
        for (const s of steps) s.setAttribute('aria-selected', String(s === active));
        for (const m of marks) m.classList.toggle('is-lit', lit.has(m.dataset.mark!));
        fig.classList.toggle('has-step', !!current);
        empty.hidden = !!current;
        for (const p of fig.querySelectorAll<HTMLElement>('[data-flow]')) p.hidden = p.dataset.flow !== current;
      };
      for (const s of steps) s.addEventListener('click', () => select(s.dataset.step!));

      // A marker click selects the flow step it belongs to; hover or focus shows its tooltip.
      for (const m of marks) {
        m.addEventListener('click', (e) => {
          e.preventDefault();
          const step = steps.find((s) => (s.dataset.marks ?? '').split(' ').includes(m.dataset.mark!));
          if (step) {
            current = null;
            select(step.dataset.step!);
          }
        });
      }
      fig.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') select(null);
      });
    }
  }
  document.addEventListener('astro:page-load', setupZoomLens);
</script>

<style>
  .zl {
    margin: 0;
    min-width: 0;
  }

  .shot {
    position: relative;
    overflow: clip;
    border: var(--border-hairline);
    border-radius: var(--radius-md);
    background: var(--color-panel);
  }

  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .shot:hover :global(img) {
    transform: translate(var(--px, 0px), var(--py, 0px)) scale(1.02);
  }

  .cover {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .mark {
    position: absolute;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    margin: -0.75rem 0 0 -0.75rem;
    padding: 0;
    border: 1.5px solid var(--color-on-accent);
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: 500;
    cursor: pointer;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.35);
    transition: transform var(--duration-fast) var(--ease-out), opacity var(--duration-base) var(--ease-out);
  }

  .mark::before {
    content: '';
    position: absolute;
    inset: -10px;
  }

  .mark:hover,
  .mark:focus-visible {
    transform: scale(1.12);
  }

  .has-step .mark {
    opacity: 0.35;
  }

  .has-step .mark.is-lit {
    opacity: 1;
    transform: scale(1.12);
  }

  .tip {
    position: absolute;
    bottom: calc(100% + 8px);
    right: 0;
    display: grid;
    gap: 2px;
    width: max-content;
    max-width: 15rem;
    padding: var(--space-2) var(--space-3);
    border: var(--border-hairline);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 400;
    line-height: 1.4;
    color: var(--color-ink-soft);
    text-align: left;
    opacity: 0;
    transform: translateY(4px);
    pointer-events: none;
    transition: opacity var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }

  .tip b {
    font-weight: 600;
    color: var(--color-ink);
  }

  .mark[data-mark='1'] .tip {
    right: auto;
    left: 0;
  }

  .mark:hover .tip,
  .mark:focus-visible .tip {
    opacity: 1;
    transform: none;
  }

  .flow {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-2);
    margin-top: var(--space-3);
    list-style: none;
    counter-reset: step;
  }

  .flow li {
    position: relative;
  }

  .flow li:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: calc(var(--space-2) * -0.85);
    top: 50%;
    z-index: 1;
    transform: translateY(-50%);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .flow button {
    display: grid;
    gap: 1px;
    justify-items: start;
    width: 100%;
    min-height: 2.75rem;
    padding: var(--space-1) var(--space-2);
    border: var(--border-hairline);
    border-radius: var(--radius-sm);
    background: none;
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-ink);
    text-align: left;
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-press);
  }

  .flow button:hover {
    border-color: var(--color-rule-strong);
  }

  .flow button:active {
    transform: scale(0.98);
  }

  .flow button[aria-selected='true'] {
    border-color: var(--color-accent);
    box-shadow: inset 0 -2px 0 var(--color-accent);
  }

  .i {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-accent-ink);
  }

  .flow-detail {
    min-height: 3em;
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .flow-empty {
    color: var(--color-muted);
  }

  figcaption {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  @media (max-width: 34rem) {
    .flow {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .flow li:nth-child(2)::after {
      display: none;
    }

    .mark {
      width: 1.25rem;
      height: 1.25rem;
      margin: -0.625rem 0 0 -0.625rem;
    }

    .tip {
      display: none;
    }
  }
</style>
