---
/* Conceptual view of StreamBox's concurrency safeguards. Figures are the README's load-test results. */
const guards = [
  {
    id: 'unique',
    name: 'Unique index + upsert',
    on: ['watchlist', 'db'],
    race: 'Double-clicks or two devices adding the same title',
    how: 'A unique compound index on {user, title} with idempotent upserts. The losing insert gets a duplicate-key error, handled as already exists.',
  },
  {
    id: 'atomic',
    name: 'Atomic rating update',
    on: ['reviews', 'db'],
    race: 'Many users rating the same title at once',
    how: 'Count, sum, and average change in one aggregation-pipeline write, so the average always matches the totals.',
  },
  {
    id: 'ordered',
    name: 'Ordered heartbeats',
    on: ['progress', 'api'],
    race: 'Retried or out-of-order playback heartbeats',
    how: 'Each update carries the client’s timestamp and applies only if it is newer than the stored one, so playback never rewinds.',
  },
  {
    id: 'lock',
    name: 'Optimistic locking',
    on: ['admin', 'api'],
    race: 'Two admins editing one title',
    how: 'The edit includes the version it read. A stale edit matches nothing and returns 409 Conflict instead of overwriting.',
  },
];
const requests = [
  { id: 'watchlist', label: 'Watchlist add' },
  { id: 'reviews', label: 'Rating / review' },
  { id: 'progress', label: 'Playback heartbeat' },
  { id: 'admin', label: 'Admin edit' },
];
---

<figure class="sb" data-sb>
  <div class="lanes" aria-hidden="true">
    <div class="col clients">
      <span class="k">Clients</span>
      <span class="dots"><i></i><i></i><i></i><i></i><i></i></span>
      <span class="note">100 concurrent in the load test</span>
    </div>
    <div class="col reqs">
      <span class="k">Concurrent requests</span>
      {requests.map((r) => <span class="req" data-target={r.id}>{r.label}</span>)}
    </div>
    <div class="col api" data-target="api">
      <span class="k">Express API</span>
      <b>24 endpoints</b>
      <span class="note">JWT auth, validation</span>
    </div>
    <div class="col db" data-target="db">
      <span class="k">MongoDB</span>
      <b>5 collections</b>
      <span class="note">indexes, atomic writes</span>
    </div>
  </div>

  <div class="guards" role="tablist" aria-label="Concurrency safeguards">
    {
      guards.map((g) => (
        <button type="button" role="tab" class="choice" aria-selected="false" data-guard={g.id} data-on={g.on.join(' ')}>
          {g.name}
        </button>
      ))
    }
  </div>
  <div class="guard-detail" aria-live="polite">
    <p class="empty">Select a safeguard to see the race condition it prevents.</p>
    {
      guards.map((g) => (
        <div data-guard-detail={g.id} hidden>
          <p class="race">
            <b>Race:</b> {g.race}
          </p>
          <p>{g.how}</p>
        </div>
      ))
    }
  </div>
  <p class="result">
    Load test: <b>51,633 requests</b> in 15 s from 100 concurrent clients, then a database check:
    <b>0 duplicates, 0 incorrect totals.</b>
  </p>
  <figcaption>Conceptual diagram. Load-test figures from the project README, measured on a development laptop.</figcaption>
</figure>

<script>
  function setupStreamBox() {
    for (const fig of document.querySelectorAll<HTMLElement>('[data-sb]:not([data-ready])')) {
      fig.dataset.ready = 'true';
      const buttons = Array.from(fig.querySelectorAll<HTMLButtonElement>('[data-guard]'));
      const empty = fig.querySelector<HTMLElement>('.empty')!;
      let current: string | null = null;
      for (const b of buttons) {
        b.addEventListener('click', () => {
          current = current === b.dataset.guard ? null : b.dataset.guard!;
          const on = new Set(current ? (b.dataset.on ?? '').split(' ') : []);
          for (const x of buttons) x.setAttribute('aria-selected', String(x.dataset.guard === current));
          for (const t of fig.querySelectorAll<HTMLElement>('[data-target]')) t.classList.toggle('is-on', on.has(t.dataset.target!));
          fig.classList.toggle('has-guard', !!current);
          empty.hidden = !!current;
          for (const d of fig.querySelectorAll<HTMLElement>('[data-guard-detail]')) d.hidden = d.dataset.guardDetail !== current;
        });
      }
    }
  }
  document.addEventListener('astro:page-load', setupStreamBox);
</script>

<style>
  .sb {
    margin: 0;
    padding: var(--space-4);
    border: var(--border-hairline);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .lanes {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr 1fr 1fr;
    gap: var(--space-3);
    align-items: stretch;
  }

  .col {
    position: relative;
    display: grid;
    align-content: start;
    gap: 4px;
    padding: var(--space-3);
    border: var(--border-hairline);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    font-size: var(--text-xs);
    transition: border-color var(--duration-base) var(--ease-out);
  }

  .col:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: calc(var(--space-3) * -0.85);
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-muted);
  }

  .k {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .col b {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .note {
    color: var(--color-muted);
  }

  .dots {
    display: flex;
    gap: 4px;
    padding-block: var(--space-1);
  }

  .dots i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-ink-soft);
  }

  .req {
    padding: 2px var(--space-2);
    border: var(--border-hairline);
    border-radius: var(--radius-xs);
    transition: border-color var(--duration-base) var(--ease-out), color var(--duration-base) var(--ease-out);
  }

  .has-guard .req,
  .has-guard .api,
  .has-guard .db {
    opacity: var(--opacity-dim);
  }

  .has-guard .is-on {
    opacity: 1;
    border-color: var(--color-accent);
    color: var(--color-ink);
  }

  .guards {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .guards button {
    min-height: 2.25rem;
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .guard-detail {
    min-height: 4.5em;
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .empty {
    color: var(--color-muted);
  }

  .race b {
    font-weight: 600;
    color: var(--color-ink);
  }

  .result {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: var(--border-hairline);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .result b {
    font-weight: 600;
    color: var(--color-ink);
  }

  figcaption {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  @media (max-width: 40rem) {
    .lanes {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .col:nth-child(2)::after {
      display: none;
    }
  }
</style>
