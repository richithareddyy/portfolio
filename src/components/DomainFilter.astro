---
import { domains, projects } from '../data/projects';

const countFor = (id: string) => projects.filter((p) => (p.domains as string[]).includes(id)).length;
---

<div class="filter" role="group" aria-label="Explore projects by domain" data-reveal>
  <span class="label-mono">View /</span>
  <ul>
    <li>
      <button type="button" class="choice" data-domain-filter="all" aria-pressed="true">
        All <span class="n">{projects.length}</span>
      </button>
    </li>
    {
      domains.map((d) => (
        <li>
          <button type="button" class="choice" data-domain-filter={d.id} aria-pressed="false">
            {d.label} <span class="n">{countFor(d.id)}</span>
          </button>
        </li>
      ))
    }
  </ul>
  <p class="status" aria-live="polite" data-filter-status></p>
</div>

<style>
  .filter {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-6);
  }

  .label-mono {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
  }

  button {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35em;
    min-height: 2.75rem;
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
  }

  .n {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    opacity: 0.7;
  }

  .status {
    flex-basis: 100%;
    min-height: 1.4em;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .filter { padding-block: var(--space-3); border-block: var(--border-hairline); }
  button { align-items: center; font-family: var(--font-mono); font-size: var(--text-xs); border-color: transparent; border-radius: 0; }
  button[aria-pressed='true'] { background: var(--color-accent-wash); border-color: transparent; box-shadow: inset 0 -2px var(--color-accent); }

</style>
