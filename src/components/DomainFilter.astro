---
import { domains, projects } from '../data/projects';

const countFor = (id: string) => projects.filter((p) => (p.domains as string[]).includes(id)).length;
---

<div class="filter" role="group" aria-label="Explore projects by domain" data-reveal>
  <span class="label-mono">Explore by</span>
  <ul>
    <li>
      <button type="button" data-domain-filter="all" aria-pressed="true">
        All <span class="n">{projects.length}</span>
      </button>
    </li>
    {
      domains.map((d) => (
        <li>
          <button type="button" data-domain-filter={d.id} aria-pressed="false">
            {d.label} <span class="n">{countFor(d.id)}</span>
          </button>
        </li>
      ))
    }
  </ul>
  <p class="status" aria-live="polite" data-filter-status></p>
</div>

<style>
  .filter {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-6);
  }

  .label-mono {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
  }

  button {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35em;
    min-height: 2.25rem;
    padding: var(--space-1) var(--space-3);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: none;
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-press);
  }

  button:hover {
    color: var(--color-ink);
    border-color: var(--color-rule-strong);
  }

  button:active {
    transform: scale(0.97);
  }

  button[aria-pressed='true'] {
    color: var(--color-bg);
    background: var(--color-ink);
    border-color: var(--color-ink);
  }

  .n {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    opacity: 0.7;
  }

  .status {
    flex-basis: 100%;
    min-height: 1.4em;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
</style>
