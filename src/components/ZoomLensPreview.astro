---
import { Image } from 'astro:assets';
import preview from '../assets/zoomlens-website.png';

interface Props {
  /** Set when the preview is above the fold. */
  eager?: boolean;
}
const { eager = false } = Astro.props;
---

<figure class="zl-site" data-zl-site>
  <a class="frame" href="https://zoomlens.vercel.app/" target="_blank" rel="noopener">
    <span class="bar" aria-hidden="true">
      <span class="dots"><i></i><i></i><i></i></span>
      <span class="url"><span class="url-text">zoomlens.vercel.app</span></span>
      <span class="open">open <span class="ext-arrow">↗</span></span>
    </span>
    <span class="shot">
      <Image
        src={preview}
        alt="The Zoom Lens product site: Ask AI about anything shared in your Zoom meeting."
        widths={[480, 800, 1280]}
        sizes="(min-width: 64rem) 36rem, 92vw"
        loading={eager ? 'eager' : 'lazy'}
      />
      {/* Both sit on the screenshot's "Try the demo" button. */}
      <span class="poke" aria-hidden="true"></span>
      <span class="pointer" aria-hidden="true">
        <svg viewBox="0 0 16 22"><path d="M1 1 L1 17 L5.2 13.2 L8 20 L11 18.8 L8.2 12.2 L14 12 Z" /></svg>
      </span>
    </span>
    <span class="glare" aria-hidden="true"></span>
    <span class="visually-hidden"> (Zoom Lens product site, opens in a new tab)</span>
  </a>
  <p class="pin note" aria-hidden="true">
    the real product site
    <svg class="pen-arrow" viewBox="0 0 40 34"><path d="M31 3 C 37 14, 29 26, 10 28" pathLength="1" /><path class="head" d="M16 22 L 9 28 L 16 32" pathLength="1" /></svg>
    go poke at it
  </p>
</figure>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;

  for (const fig of document.querySelectorAll<HTMLElement>('[data-zl-site]')) {
    const frame = fig.querySelector<HTMLElement>('.frame')!;
    const url = fig.querySelector<HTMLElement>('.url-text')!;
    const full = url.textContent!;

    // Once mostly in view: the pen arrow draws, the address types itself, and a pointer goes and presses the demo button.
    const start = async () => {
      fig.classList.add('is-live');
      if (reduce) return;
      url.textContent = '';
      fig.dataset.step = 'typing';
      for (let i = 1; i <= full.length; i++) {
        url.textContent = full.slice(0, i);
        await sleep(60);
      }
      for (const [step, ms] of [['point', 350], ['move', 1000], ['click', 700]] as const) {
        fig.dataset.step = step;
        await sleep(ms);
      }
      fig.dataset.step = 'poke';
    };
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        observer.disconnect();
        start();
      },
      { threshold: 0.5 },
    );
    observer.observe(fig);

    if (reduce || !fine) continue;

    // Tilt toward the cursor, with a soft sheen that follows it.
    let raf = 0;
    frame.addEventListener('pointermove', (e) => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const box = frame.getBoundingClientRect();
        const x = (e.clientX - box.left) / box.width - 0.5;
        const y = (e.clientY - box.top) / box.height - 0.5;
        frame.style.setProperty('--ry', `${(x * 12).toFixed(2)}deg`);
        frame.style.setProperty('--rx', `${(-y * 10).toFixed(2)}deg`);
        frame.style.setProperty('--gx', `${((x + 0.5) * 100).toFixed(1)}%`);
        frame.style.setProperty('--gy', `${((y + 0.5) * 100).toFixed(1)}%`);
      });
    });
    frame.addEventListener('pointerleave', () => {
      cancelAnimationFrame(raf);
      frame.style.removeProperty('--rx');
      frame.style.removeProperty('--ry');
    });
  }
</script>

<style>
  .zl-site {
    position: relative;
    margin: 0;
    padding-top: var(--space-7);
  }

  .frame {
    position: relative;
    display: block;
    overflow: clip;
    border: var(--border-ink);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-ink);
    text-decoration: none;
    box-shadow: 6px 6px 0 var(--color-rule);
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform var(--duration-fast) var(--ease-out), box-shadow var(--duration-base) var(--ease-out);
  }

  .frame:hover {
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) translate(-2px, -2px);
    box-shadow: 8px 8px 0 var(--pen-wash);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 8px 12px;
    border-bottom: var(--border-ink);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
  }

  .dots {
    display: flex;
    gap: 5px;
  }

  .dots i {
    width: 9px;
    height: 9px;
    border: 1px solid var(--color-ink);
    border-radius: 50%;
    transition: background-color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out);
  }

  .frame:hover .dots i:nth-child(1) {
    background: #ff5f57;
    border-color: #e0443e;
  }

  .frame:hover .dots i:nth-child(2) {
    background: #febc2e;
    border-color: #dea123;
    transition-delay: 40ms;
  }

  .frame:hover .dots i:nth-child(3) {
    background: #28c840;
    border-color: #1aab29;
    transition-delay: 80ms;
  }

  .url {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    color: var(--color-muted);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  [data-step='typing'] .url::after {
    content: '';
    display: inline-block;
    width: 1px;
    height: 1.1em;
    margin-left: 1px;
    vertical-align: -0.2em;
    background: currentColor;
    animation: caret 0.8s steps(1) infinite;
  }

  .open {
    color: var(--pen-ink);
  }

  .shot {
    position: relative;
    display: block;
  }

  .frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: scale var(--duration-slow) var(--ease-out);
  }

  .frame:hover :global(img) {
    scale: 1.02;
  }

  .glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at var(--gx, 50%) var(--gy, 0%), rgb(255 255 255 / 0.22), transparent 50%);
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out);
  }

  .frame:hover .glare {
    opacity: 1;
  }

  .pointer {
    position: absolute;
    left: 80%;
    top: 26%;
    width: 18px;
    opacity: 0;
    pointer-events: none;
    filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.35));
    transition:
      left 900ms cubic-bezier(0.45, 0, 0.2, 1),
      top 900ms cubic-bezier(0.45, 0, 0.2, 1),
      opacity var(--duration-fast) var(--ease-out);
  }

  .pointer svg {
    display: block;
    fill: #fff;
    stroke: #111;
    stroke-width: 1.2;
    stroke-linejoin: round;
  }

  [data-step='point'] .pointer,
  [data-step='move'] .pointer,
  [data-step='click'] .pointer {
    opacity: 1;
  }

  [data-step='move'] .pointer,
  [data-step='click'] .pointer {
    left: 42.2%;
    top: 71.3%;
  }

  [data-step='click'] .pointer svg {
    animation: press 300ms var(--ease-out);
  }

  [data-step='click'] .poke {
    animation: burst 650ms var(--ease-out);
  }

  .poke {
    position: absolute;
    left: 42.2%;
    top: 71.3%;
    width: 13%;
    height: 8.5%;
    translate: -50% -50%;
    border: 2px solid var(--pen);
    border-radius: 8px;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  [data-step='poke'] .poke {
    animation: poke 1.6s var(--ease-out) 3;
  }

  .frame:hover .poke {
    opacity: 1;
    animation: none;
  }

  .pin {
    position: absolute;
    top: 0;
    right: var(--space-2);
    display: flex;
    align-items: flex-end;
    gap: 2px;
    white-space: nowrap;
    transform: rotate(-2deg);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .zl-site:hover .pin {
    transform: rotate(-4deg) translateY(-2px);
  }

  .pen-arrow {
    width: 1.9em;
    height: 1.6em;
    margin-bottom: -0.9em;
    overflow: visible;
    fill: none;
    stroke: var(--pen);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  :global(.js) .pen-arrow path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 500ms var(--ease-out);
  }

  :global(.js) .pen-arrow .head {
    transition-delay: 450ms;
  }

  .is-live .pen-arrow path {
    stroke-dashoffset: 0;
  }

  @keyframes caret {
    50% {
      opacity: 0;
    }
  }

  @keyframes press {
    50% {
      transform: scale(0.82);
    }
  }

  @keyframes burst {
    0% {
      opacity: 1;
      transform: scale(0.6);
    }

    100% {
      opacity: 0;
      transform: scale(1.5);
    }
  }

  @keyframes poke {
    0% {
      opacity: 0.9;
      transform: scale(0.92);
    }

    70%,
    100% {
      opacity: 0;
      transform: scale(1.2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .frame,
    .frame:hover {
      transform: none;
    }

    .frame:hover :global(img) {
      scale: none;
    }

    :global(.js) .pen-arrow path {
      stroke-dashoffset: 0;
    }
  }
</style>
