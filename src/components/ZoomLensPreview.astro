---
import { Image } from 'astro:assets';
import preview from '../assets/zoomlens-website.png';

interface Props {
  /** Set when the preview is above the fold. */
  eager?: boolean;
}
const { eager = false } = Astro.props;
---

<figure class="zl-site">
  <a class="frame" href="https://zoomlens.vercel.app/" target="_blank" rel="noopener">
    <span class="bar" aria-hidden="true">
      <span class="dots"><i></i><i></i><i></i></span>
      <span class="url">zoomlens.vercel.app</span>
      <span class="open">open <span class="ext-arrow">↗</span></span>
    </span>
    <Image
      src={preview}
      alt="The Zoom Lens product site: Ask AI about anything shared in your Zoom meeting."
      widths={[480, 800, 1280]}
      sizes="(min-width: 64rem) 36rem, 92vw"
      loading={eager ? 'eager' : 'lazy'}
    />
    <span class="visually-hidden"> (Zoom Lens product site, opens in a new tab)</span>
  </a>
  <p class="pin note" aria-hidden="true">the real product site ↓ go poke at it</p>
</figure>

<style>
  .zl-site {
    position: relative;
    margin: 0;
    padding-top: var(--space-6);
  }

  .frame {
    display: block;
    overflow: clip;
    border: var(--border-ink);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-ink);
    text-decoration: none;
    box-shadow: 6px 6px 0 var(--color-rule);
    transition: transform var(--duration-base) var(--ease-out), box-shadow var(--duration-base) var(--ease-out);
  }

  .frame:hover {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 var(--pen-wash);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 8px 12px;
    border-bottom: var(--border-ink);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
  }

  .dots {
    display: flex;
    gap: 5px;
  }

  .dots i {
    width: 9px;
    height: 9px;
    border: 1px solid var(--color-ink);
    border-radius: 50%;
  }

  .url {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    color: var(--color-muted);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .open {
    color: var(--pen-ink);
  }

  .frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .pin {
    position: absolute;
    top: 0;
    right: var(--space-2);
    transform: rotate(-2deg);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .frame:hover {
      transform: none;
    }
  }
</style>
