---
import { profile } from '../data/profile';

interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
const base = isHome ? '' : '/';

const nav = [
  { id: 'work', label: 'Work' },
  { id: 'experience', label: 'Experience' },
  { id: 'skills', label: 'Skills' },
  { id: 'about', label: 'About' },
  { id: 'contact', label: 'Contact' },
];
---

<header class="site-header" data-header>
  <div class="wrap bar">
    <a class="wordmark" href={isHome ? '#top' : '/'} aria-label={`${profile.name}, home`}>
      <svg class="mark" viewBox="0 0 120 120" aria-hidden="true">
        <rect width="120" height="120" rx="24" />
        <g transform="translate(1 3)">
          <path class="letters" d="M26 92V28H82l10 10v12l-10 10H26M62 28V92" />
          <path class="legs" d="M29.7 60H42.3L52.3 92H39.7ZM69.3 60H82.7L98.7 92H85.3Z" />
        </g>
      </svg>
      <svg class="name" viewBox="0 0 470 40" aria-hidden="true">
        <g fill="none" stroke="currentColor" stroke-width="6">
          <path transform="translate(0 0)" d="M3 40V3H17l6 6v5l-6 6H3"/>
          <path transform="translate(0 0)" d="M9.6 20H16.4L26.4 40H19.6Z" fill="currentColor" stroke="none"/>
          <path transform="translate(36 0)" d="M3 0V40"/>
          <path transform="translate(52 0)" d="M25 3H9L3 9V31l6 6H25"/>
          <path transform="translate(88 0)" d="M3 0V40M23 0V40M3 20H23"/>
          <path transform="translate(124 0)" d="M3 0V40"/>
          <path transform="translate(140 0)" d="M0 3H26M13 3V40"/>
          <path transform="translate(176 0)" d="M3 0V40M23 0V40M3 20H23"/>
          <path transform="translate(212 0)" d="M3 40V9l6-6h8l6 6V40M3 22H23"/>
          <path transform="translate(264 0)" d="M3 40V3H17l6 6v5l-6 6H3"/>
          <path transform="translate(264 0)" d="M9.6 20H16.4L26.4 40H19.6Z" fill="currentColor" stroke="none"/>
          <path transform="translate(300 0)" d="M25 3H3V37H25M3 20H19"/>
          <path transform="translate(336 0)" d="M3 0V40M3 20H10"/>
          <path transform="translate(336 0)" d="M6.4 20H13.6L26.6 40H19.4ZM6.4 20H13.6L26.6 0H19.4Z" fill="currentColor" stroke="none"/>
          <path transform="translate(372 0)" d="M3 0V31l6 6h8l6-6V0"/>
          <path transform="translate(408 0)" d="M3 0V37H25"/>
          <path transform="translate(444 0)" d="M3 40V9l6-6h8l6 6V40M3 22H23"/>
        </g>
      </svg>
    </a>

    <nav class="nav" aria-label="Primary">
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="primary-menu"
        data-menu-toggle
      >
        <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
        <span class="menu-label">Menu</span>
      </button>

      <ul id="primary-menu" class="menu" data-menu>
        <li class="indicator-wrap" aria-hidden="true"><span class="indicator" data-nav-indicator></span></li>
        {
          nav.map((item, index) => (
            <li>
              <a href={`${base}#${item.id}`} data-nav-link={item.id}>
                <span class="nav-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span> {item.label}
              </a>
            </li>
          ))
        }
        <li class="menu-ext">
          <a href={profile.links.github} target="_blank" rel="noopener">
            GitHub<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </li>
        <li class="menu-resume">
          <a href={profile.links.resume} target="_blank" rel="noopener">
            Résumé<span class="visually-hidden"> (PDF, opens in a new tab)</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
  <div class="progress" aria-hidden="true">
    <span class="axis"></span>
    <span class="tick" style="left: 25%"></span>
    <span class="tick" style="left: 50%"></span>
    <span class="tick" style="left: 75%"></span>
    <span class="fill" data-progress></span>
    <span class="rail" data-progress-rail><i></i></span>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const bar = header.querySelector<HTMLElement>('[data-progress]')!;
  const rail = header.querySelector<HTMLElement>('[data-progress-rail]')!;

  function setOpen(open: boolean) {
    toggle.setAttribute('aria-expanded', String(open));
    header.classList.toggle('is-open', open);
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target.closest('[data-menu-toggle]')) setOpen(!header.classList.contains('is-open'));
    else if (target.closest('[data-menu] a') || !header.contains(target)) setOpen(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && header.classList.contains('is-open')) {
      setOpen(false);
      toggle.focus();
    }
  });

  matchMedia('(min-width: 48rem)').addEventListener('change', (e) => e.matches && setOpen(false));

  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      header.classList.toggle('is-scrolled', scrollY > 8);
      const max = document.documentElement.scrollHeight - innerHeight;
      const p = max > 0 ? Math.min(scrollY / max, 1) : 0;
      bar.style.transform = `scaleX(${p})`;
      rail.style.transform = `translateX(${(p * 100).toFixed(2)}%)`;
    });
  };
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', onScroll, { passive: true });
  onScroll();

  // On the home page the link for the section in view is marked; on case studies "Work" stays marked.
  const links = Array.from(header.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
  const indicator = header.querySelector<HTMLElement>('[data-nav-indicator]')!;

  function setActive(id: string | null) {
    const active = links.find((link) => link.dataset.navLink === id);
    for (const link of links) {
      if (link === active) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    }
    // One indicator glides to the active link, instead of each link animating its own underline.
    if (active) {
      const inset = 12;
      indicator.style.width = `${active.offsetWidth - inset * 2}px`;
      indicator.style.transform = `translateX(${active.offsetLeft + inset}px)`;
      indicator.style.opacity = '1';
    } else {
      indicator.style.opacity = '0';
    }
  }

  const page = document.querySelector<HTMLElement>('[data-page]')?.dataset.page;
  if (page === 'home') {
    const sections = links.map((link) => document.getElementById(link.dataset.navLink!)).filter((el) => el !== null);
    const visible = new Set<string>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        }
        // The topmost section crossing the band wins.
        setActive(sections.find((section) => visible.has(section.id))?.id ?? null);
      },
      { rootMargin: '-35% 0px -55% 0px', threshold: [0, 0.01] },
    );
    sections.forEach((section) => observer.observe(section));
  } else {
    setActive(page === 'project' ? 'work' : null);
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: saturate(1.2) blur(8px);
    -webkit-backdrop-filter: saturate(1.2) blur(8px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-base) var(--ease-out);
  }

  /* Scroll progress: a hairline with quarter ticks and a point that moves along it. */
  .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    overflow-x: clip;
    overflow-y: visible;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out);
  }

  .is-scrolled .progress {
    opacity: 1;
  }

  .axis,
  .fill {
    position: absolute;
    inset: 0;
  }

  .axis {
    background: var(--color-rule);
  }

  .fill {
    background: var(--color-accent);
    opacity: 0.55;
    transform: scaleX(0);
    transform-origin: left;
  }

  .tick {
    position: absolute;
    bottom: 0;
    width: 1px;
    height: 5px;
    background: var(--color-rule-strong);
  }

  .rail {
    position: absolute;
    inset: 0;
    transform: translateX(0);
  }

  .rail i {
    position: absolute;
    left: 0;
    top: -3px;
    width: 7px;
    height: 7px;
    margin-left: -3.5px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .site-header.is-scrolled,
  .site-header.is-open {
    border-bottom-color: var(--color-rule);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-ink);
    text-decoration: none;
  }

  .name {
    display: block;
    width: auto;
    height: 0.875rem;
    overflow: visible;
  }

  /* Brand colors by default; once a different pen is picked with the dot in the hero, the logo follows it. */
  .mark {
    --logo-bg: #2f6bff;
    --logo-fg: #ffffff;
    display: block;
    width: 2rem;
    height: 2rem;
    transition: transform var(--duration-base) var(--ease-out);
  }

  :global([data-pen]) .mark {
    --logo-bg: var(--pen);
    --logo-fg: var(--color-on-accent);
  }

  .mark rect {
    fill: var(--logo-bg);
    transition: fill var(--duration-base) var(--ease-out);
  }

  .mark .letters {
    fill: none;
    stroke: var(--logo-fg);
    stroke-width: 12;
  }

  .mark .legs {
    fill: var(--logo-fg);
  }

  .wordmark:hover .mark {
    transform: rotate(-6deg);
  }

  .menu {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
  }

  .menu a {
    position: relative;
    display: block;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-muted);
    text-decoration: none;
    border-radius: var(--radius-xs);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .menu a:hover,
  .menu a[aria-current] {
    color: var(--color-ink);
  }


  .indicator-wrap {
    position: absolute;
    left: 0;
    bottom: 2px;
    width: 0;
    height: 1px;
    list-style: none;
  }

  .indicator {
    position: absolute;
    left: 0;
    top: 0;
    height: 1px;
    background: var(--color-accent);
    opacity: 0;
    transition: transform var(--duration-slow) var(--ease-out), width var(--duration-slow) var(--ease-out),
      opacity var(--duration-base) var(--ease-out);
  }

  .menu-ext {
    margin-left: var(--space-3);
    padding-left: var(--space-3);
    border-left: var(--border-hairline);
  }

  .menu-resume {
    margin-left: var(--space-1);
  }

  .menu-resume a {
    color: var(--color-ink);
    border: var(--border-strong);
    padding: var(--space-1) var(--space-3);
    transition: border-color var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out);
  }

  .menu-resume a:hover {
    border-color: var(--color-ink);
    background: var(--color-surface);
  }

  .menu-toggle {
    display: none;
  }

  @media (max-width: 47.99rem) {
    .indicator-wrap {
      display: none;
    }

    .wordmark .name {
      height: 0.75rem;
    }

    .menu-toggle {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      min-height: 2.75rem;
      padding: 0 var(--space-3);
      margin-right: calc(var(--space-3) * -1);
      background: none;
      border: 0;
      cursor: pointer;
      font-size: var(--text-sm);
    }

    .menu-icon {
      position: relative;
      width: 1rem;
      height: 0.625rem;
    }

    .menu-icon span {
      position: absolute;
      left: 0;
      width: 100%;
      height: 1.5px;
      background: currentColor;
      transition: transform var(--duration-base) var(--ease-out), top var(--duration-base) var(--ease-out);
    }

    .menu-icon span:first-child {
      top: 0;
    }

    .menu-icon span:last-child {
      top: calc(100% - 1.5px);
    }

    .is-open .menu-icon span:first-child {
      top: calc(50% - 0.75px);
      transform: rotate(45deg);
    }

    .is-open .menu-icon span:last-child {
      top: calc(50% - 0.75px);
      transform: rotate(-45deg);
    }

    .menu {
      position: absolute;
      top: var(--header-height);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: var(--space-2) var(--gutter) var(--space-5);
      background: var(--color-bg);
      border-bottom: var(--border-hairline);
      box-shadow: var(--shadow-md);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-6px);
      transition: opacity var(--duration-base) var(--ease-out), transform var(--duration-base) var(--ease-out),
        visibility 0s linear var(--duration-base);
    }

    .is-open .menu {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition: opacity var(--duration-base) var(--ease-out), transform var(--duration-base) var(--ease-out);
    }

    .menu a {
      padding: var(--space-3) 0;
      font-size: var(--text-md);
      color: var(--color-ink);
      border-bottom: var(--border-hairline);
      border-radius: 0;
    }

    .menu a[data-nav-link]::after {
      display: none;
    }

    .menu a[aria-current] {
      color: var(--color-accent-ink);
    }

    .menu-ext {
      margin: 0;
      padding: 0;
      border: 0;
    }

    .menu-resume {
      margin: var(--space-4) 0 0;
    }

    .menu-resume a {
      display: inline-block;
      padding: var(--space-2) var(--space-4);
      border: var(--border-strong);
    }
  }

  .nav-index {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-faint);
    margin-right: 3px;
  }
  .menu a[aria-current] .nav-index {
    color: var(--color-accent-ink);
  }
  /* Last on purpose: overrides .menu-resume a's inline-block in the mobile menu. */
  .menu a {
    min-height: 2.75rem;
    display: flex;
    align-items: center;
  }
  @media (min-width: 48rem) and (max-width: 64rem) { .wordmark .name, .menu-ext { display: none; } }
</style>
