---
import type { Project } from '../data/projects';
import ProjectVisual from './ProjectVisual.astro';
import ProjectLinks from './ProjectLinks.astro';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const href = project.caseStudy ? `/work/${project.slug}` : undefined;
---

<article class="card" id={`project-${project.slug}`} aria-labelledby={`${project.slug}-title`}>
  <ProjectVisual visual={project.visual} size="card" />
  <div class="body">
    <p class="meta">{[project.year, project.role].filter(Boolean).join(' · ')}</p>
    <h3 id={`${project.slug}-title`}>
      {href ? <a href={href} transition:name={`title-${project.slug}`}>{project.title}</a> : project.title}
    </h3>
    <p class="summary">{project.summary}</p>
    <p class="contribution">{project.contribution}</p>
    <p class="result">
      <strong>{project.result.headline}</strong>
      {project.result.qualifier && <span>{project.result.qualifier}</span>}
    </p>
    <ul class="stack" aria-label="Technologies">
      {project.tech.map((t) => <li>{t}</li>)}
    </ul>
    <div class="links">
      <ProjectLinks project={project} />
    </div>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }

  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  h3 {
    font-size: var(--text-xl);
  }

  h3 a {
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  h3 a:hover {
    color: var(--color-accent-ink);
  }

  .summary {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink);
  }

  .contribution {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .result {
    padding-top: var(--space-2);
    border-top: var(--border-hairline);
    font-size: var(--text-sm);
  }

  .result strong {
    display: block;
    font-weight: 600;
  }

  .result span {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .links {
    margin-top: auto;
    padding-top: var(--space-1);
  }
</style>
