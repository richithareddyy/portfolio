---
import { profile } from '../data/profile';
import SectionHeading from './SectionHeading.astro';

const others = [
  { label: 'LinkedIn', value: 'linkedin.com/in/richitha-rekula', href: profile.links.linkedin },
  { label: 'GitHub', value: 'github.com/richithareddyy', href: profile.links.github },
  { label: 'Résumé', value: 'download the PDF', href: profile.links.resume },
];
---

<section class="wrap section" id="contact" aria-labelledby="contact-title">
  <SectionHeading id="contact">Say <em>hello</em></SectionHeading>

  <div class="opening">
    <p class="invite">
      Hiring for early-career data science, machine learning, or applied AI roles? I’d be glad to talk. Email is the quickest way to reach me.
    </p>
    <p class="sticky">
      <span class="ps">p.s.</span> open to new grad and internship roles in data science, machine learning, and applied AI
    </p>
  </div>

  <div class="email">
    <a href={`mailto:${profile.email}`}>{profile.email}</a>
    <button type="button" class="copy note" data-copy={profile.email}>copy</button>
  </div>

  <ul class="others">
    {
      others.map((o) => (
        <li>
          <span class="note">{o.label.toLowerCase()}</span>
          <a href={o.href} target="_blank" rel="me noopener">
            {o.value}
            <span class="ext-arrow" aria-hidden="true">↗</span>
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .section {
    padding-block: var(--section-gap);
  }

  .opening {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  @media (min-width: 56rem) {
    .opening {
      grid-template-columns: minmax(0, var(--width-prose)) 15rem;
      justify-content: space-between;
    }
  }

  /* A sticky note on the page, with a strip of tape holding it on. */
  .sticky {
    position: relative;
    justify-self: start;
    max-width: 15rem;
    padding: var(--space-5) var(--space-4) var(--space-4);
    background: var(--pen-wash);
    box-shadow: var(--shadow-md);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lg);
    line-height: 1.3;
    color: var(--color-ink);
    transform: rotate(2.5deg);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .sticky:hover {
    transform: rotate(0deg);
  }

  .sticky::before {
    content: '';
    position: absolute;
    top: -9px;
    left: 50%;
    width: 4rem;
    height: 1.1rem;
    background: color-mix(in srgb, var(--color-surface) 70%, transparent);
    box-shadow: 0 1px 2px rgb(25 25 21 / 0.08);
    transform: translateX(-50%) rotate(-4deg);
  }

  .ps {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: var(--text-xs);
    color: var(--pen-ink);
  }

  .invite {
    max-width: var(--width-prose);
    font-size: var(--text-md);
    color: var(--color-ink-soft);
  }

  .email {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-6);
  }

  .email a {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1rem + 3.4vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
    text-decoration: none;
    background-image: linear-gradient(var(--pen), var(--pen));
    background-size: 100% 2px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .email a:hover {
    color: var(--pen-ink);
  }

  .copy {
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    border: 1px dashed var(--pen);
    border-radius: 999px;
    background: none;
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out);
  }

  .copy:hover {
    background: var(--pen-wash);
  }

  .others {
    display: grid;
    gap: 0;
    margin-top: var(--space-7);
    list-style: none;
    border-top: var(--border-hairline);
  }

  .others li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2px var(--space-6);
    padding-block: var(--space-3);
    border-bottom: var(--border-hairline);
  }

  @media (min-width: 40rem) {
    .others li {
      grid-template-columns: 8rem minmax(0, 1fr);
      align-items: baseline;
    }
  }

  .others a {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    font-size: var(--text-lg);
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .others a:hover {
    color: var(--pen-ink);
  }
</style>
