---
import { profile } from '../data/profile';

// Accomplishments rather than counts: what each flagship project is, and the evidence behind it.
const highlights = [
  { slug: 'zoom-lens', title: 'Zoom Lens', what: 'AI assistant inside live Zoom meetings', proof: 'Zoom Fellowship project' },
  { slug: 'codeatlas', title: 'CodeAtlas', what: 'Change-impact analysis for Rust', proof: 'Indexes tokio in 3.6 s' },
  { slug: 'reddit-data-pipeline', title: 'Reddit ETL Pipeline', what: '18.9M records into PostgreSQL', proof: 'Full run cut from 584 s to 345 s' },
];
---

<section class="hero wrap" id="top" aria-labelledby="hero-title">
  <div class="body">
    <div class="main">
      <h1 id="hero-title" class="name"><span>Richitha</span> <span>Rekula<span class="dot" aria-hidden="true">.</span></span></h1>
      <p class="lede">Software engineer building applied AI and backend systems.</p>
      <p class="desc">
        <strong>Zoom Fellow at ASU Next Lab</strong>, building an AI assistant that runs inside live Zoom meetings. I also build
        the systems underneath: a Rust code-analysis engine and a PostgreSQL pipeline that accounts for every one of 18.9M records.
      </p>

      <div class="actions">
        <a class="button primary" href="#work">View projects</a>
        <a class="button" href={profile.links.resume} target="_blank" rel="noopener">
          Résumé <span class="ext-arrow" aria-hidden="true">↗</span><span class="visually-hidden"> (PDF, opens in a new tab)</span>
        </a>
        <ul class="quiet" aria-label="Profiles and email">
          <li><a href={profile.links.github} target="_blank" rel="me noopener">GitHub<span class="visually-hidden"> (opens in a new tab)</span></a></li>
          <li><a href={profile.links.linkedin} target="_blank" rel="me noopener">LinkedIn<span class="visually-hidden"> (opens in a new tab)</span></a></li>
          <li><a href={`mailto:${profile.email}`}>Email</a></li>
        </ul>
      </div>
    </div>

    <nav class="index" aria-labelledby="index-title">
      <p id="index-title" class="label">Featured work</p>
      <ol>
        {
          highlights.map((h, i) => (
            <li>
              <a href={`#project-${h.slug}`}>
                <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="t">{h.title}</span>
                <span class="w">{h.what}</span>
                <span class="p">{h.proof}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>

  <dl class="facts">
    <div>
      <dt class="label">Education</dt>
      <dd>M.S. Data Science, Analytics and Engineering</dd>
      <dd class="sub">Arizona State University · {profile.graduation}</dd>
    </div>
    <div>
      <dt class="label">Open to</dt>
      <dd>Software engineering, applied AI, and backend roles</dd>
      <dd class="sub">New grad and internship</dd>
    </div>
    <div>
      <dt class="label">Based in</dt>
      <dd>{profile.location}</dd>
    </div>
  </dl>
</section>

<style>
  .hero {
    padding-block: var(--space-7) var(--space-6);
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    align-items: end;
  }

  @media (min-width: 60rem) {
    .body {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  .main,
  .index {
    min-width: 0;
  }

  .name {
    font-size: clamp(3.5rem, 2rem + 4.7vw, 6.5rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .name > span {
    display: block;
  }

  .dot {
    display: inline-block;
    color: var(--color-accent);
  }

  .lede {
    max-width: 30rem;
    margin-top: var(--space-5);
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 1rem + 0.8vw, 1.7rem);
    line-height: 1.35;
  }

  .desc {
    max-width: 46ch;
    margin-top: var(--space-3);
    font-size: var(--text-md);
    color: var(--color-ink-soft);
  }

  .desc strong {
    font-weight: 600;
    color: var(--color-ink);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: 0 var(--space-5);
    border: var(--border-strong);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: border-color var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-press);
  }

  .button:hover {
    border-color: var(--color-ink);
    background: var(--color-surface);
  }

  .button:active {
    transform: scale(0.98);
  }

  .button.primary {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .button.primary:hover {
    background: var(--color-accent-ink);
    border-color: var(--color-accent-ink);
  }

  .quiet {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    width: 100%;
    list-style: none;
    font-size: var(--text-sm);
  }

  .quiet a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-muted);
    text-decoration: underline;
    text-decoration-color: var(--color-rule-strong);
    text-underline-offset: 0.2em;
    transition: color var(--duration-fast) var(--ease-out), text-decoration-color var(--duration-fast) var(--ease-out);
  }

  .quiet a:hover {
    color: var(--color-ink);
    text-decoration-color: currentColor;
  }

  .label {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* Featured-work index: a typographic list, not a dashboard. */
  .index ol {
    margin-top: var(--space-2);
    list-style: none;
    border-top: var(--border-hairline);
  }

  .index a {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 2px var(--space-2);
    padding-block: var(--space-3);
    border-bottom: var(--border-hairline);
    text-decoration: none;
  }

  .n {
    grid-row: span 3;
    padding-top: 0.35em;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-muted);
  }

  .t {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1.2;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .w {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .p {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .index a:hover .t {
    color: var(--color-accent-ink);
  }

  .facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4) var(--space-7);
    margin: var(--space-8) 0 0;
    padding-top: var(--space-4);
    border-top: var(--border-hairline);
  }

  @media (min-width: 40rem) {
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  dt {
    margin-bottom: var(--space-2);
  }

  dd {
    margin: 2px 0 0;
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: var(--leading-snug);
  }

  dd.sub {
    font-weight: 400;
    color: var(--color-muted);
  }

  @media (max-width: 40rem) {
    .hero {
      padding-top: var(--space-5);
    }

    .facts {
      margin-top: var(--space-7);
    }
  }
</style>
