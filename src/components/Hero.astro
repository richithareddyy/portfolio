---
import { profile } from '../data/profile';
import Doodle from './Doodle.astro';
import HeroScene from './HeroScene.astro';

const phrases = ['Data scientist, Zoom Fellow', 'Causal inference and forecasting', 'M.S. Data Science, ASU 2027'];

const contents = [
  { slug: 'zoom-lens', title: 'ZoomLens', what: 'An AI assistant inside live Zoom meetings', proof: 'Zoom Fellowship project' },
  { slug: 'causeway', title: 'CauseWay', what: 'Did the e-mail cause the spending? A causal study', proof: 'naive estimate off by ~50%' },
  { slug: 'gridcast', title: 'GridCast', what: 'Day-ahead electricity demand, with honest intervals', proof: '22% below the seasonal baseline' },
];
---

<section class="hero wrap" id="top" aria-labelledby="hero-title">
  <div class="cover">
    <p class="hello note">Hi, I'm</p>
    <h1 id="hero-title" class="name" aria-label="Richitha Rekula">
      <span class="first">Richitha<Doodle kind="star" class="name-star" /><svg class="sparkle one" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1 Q11 9 19 10 Q11 11 10 19 Q9 11 1 10 Q9 9 10 1Z" /></svg></span>
      <span class="last"><svg class="sparkle two" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1 Q11 9 19 10 Q11 11 10 19 Q9 11 1 10 Q9 9 10 1Z" /></svg>Rekula<button type="button" class="pen-dot" data-pen-toggle aria-label="Change the pen color used across the site"></button><span class="pen-hint note" aria-hidden="true">paint the page ↗</span></span>
    </h1>
    <p class="phrases" aria-hidden="true" data-phrases={JSON.stringify(phrases)}><span class="phrase is-in">{phrases[0]}</span></p>
    <p class="visually-hidden">{phrases.join(', ')}.</p>
    <p class="tagline">I build AI tools and study when models can be trusted.</p>
    <p class="pen-hint-below note" aria-hidden="true">tap the dot: paint the page ↗</p>

    <div class="actions">
      <a class="button primary" href="#work">See the work <span aria-hidden="true">↓</span></a>
      <p class="start note" aria-hidden="true">
        <svg viewBox="0 0 30 30"><path d="M5 28 C 3 18, 8 9, 19 5" pathLength="1" /><path class="head" d="M12 3 L 19 5 L 16 11" pathLength="1" /></svg>
        Start here
      </p>
      <a class="button" href={profile.links.resume} target="_blank" rel="noopener">
        Résumé <span class="ext-arrow" aria-hidden="true">↗</span><span class="visually-hidden"> (PDF, opens in a new tab)</span>
      </a>
      <ul class="quiet" aria-label="Profiles and email">
        <li><a href={profile.links.github} target="_blank" rel="me noopener">GitHub<span class="visually-hidden"> (opens in a new tab)</span></a></li>
        <li><a href={profile.links.linkedin} target="_blank" rel="me noopener">LinkedIn<span class="visually-hidden"> (opens in a new tab)</span></a></li>
        <li><a href={`mailto:${profile.email}`}>Email</a></li>
      </ul>
    </div>

    <HeroScene />

    <svg class="flight" aria-hidden="true" focusable="false" data-flight>
      <defs>
        <mask id="trail-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="100%" height="100%">
          <path class="trail-reveal" pathLength="1" data-trail-reveal />
        </mask>
      </defs>
      <path class="pencil-line" pathLength="1" data-pencil-line />
      <path class="trail" mask="url(#trail-mask)" data-trail />
    </svg>
    <button type="button" class="plane" aria-label="Fly the paper airplane again" data-plane>
      <svg viewBox="0 0 36 24" aria-hidden="true" focusable="false">
        <path class="plane-body" d="M2 12 L34 2 L24 22 L16 14 Z" />
        <path d="M16 14 L34 2 M16 14 L14 21 L19 17" />
      </svg>
    </button>
  </div>

  <nav class="contents" aria-labelledby="contents-title">
    <svg class="clip" viewBox="0 0 24 48" aria-hidden="true"><path d="M8 14 V36 a5 5 0 0 0 10 0 V8 a7 7 0 0 0 -14 0 V34" /></svg>
    <p id="contents-title" class="contents-title">Featured projects</p>
    <ol>
      {
        contents.map((c, i) => (
          <li>
            <a href={`#project-${c.slug}`}>
              <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="t">{c.title}</span>
              <span class="leader" aria-hidden="true" />
              <span class="w">{c.what}</span>
              <span class="p note">{c.proof}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</section>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const cover = document.querySelector<HTMLElement>('#top .cover')!;
  let onScreen = true;
  new IntersectionObserver(([entry]) => (onScreen = entry.isIntersecting)).observe(cover);

  // Phrases under the name: each one is inked in, held, and lifted off before the next.
  const phraseLine = document.querySelector<HTMLElement>('[data-phrases]');
  if (phraseLine && !reduce) {
    const phrases: string[] = JSON.parse(phraseLine.dataset.phrases!);
    const phrase = phraseLine.querySelector<HTMLElement>('.phrase')!;
    let i = 0;
    setInterval(() => {
      if (!onScreen || document.hidden) return;
      phrase.classList.add('is-out');
      setTimeout(() => {
        i = (i + 1) % phrases.length;
        phrase.textContent = phrases[i];
        phrase.classList.remove('is-out', 'is-in');
        void phrase.offsetWidth;
        phrase.classList.add('is-in');
      }, 420);
    }, 3800);
  }

  // The paper airplane: a pencil line folds into a plane, which flies along a dotted curve and lands beside the links.
  const plane = document.querySelector<HTMLButtonElement>('[data-plane]')!;
  const flight = document.querySelector<SVGSVGElement>('[data-flight]')!;
  const pencil = flight.querySelector<SVGPathElement>('[data-pencil-line]')!;
  const trail = flight.querySelector<SVGPathElement>('[data-trail]')!;
  const reveal = flight.querySelector<SVGPathElement>('[data-trail-reveal]')!;
  const startMark = document.querySelector<HTMLElement>('[data-plane-start]')!;
  const landing = document.querySelector<HTMLElement>('#top .cover .quiet li:last-child')!;
  let flying = false;

  const local = (el: Element) => {
    const r = el.getBoundingClientRect();
    const c = cover.getBoundingClientRect();
    return { x: r.left - c.left, y: r.top - c.top, w: r.width, h: r.height };
  };
  const restPoint = () => {
    const r = local(landing);
    return { x: r.x + r.w + 34, y: r.y + r.h / 2 };
  };
  const pose = (x: number, y: number, angle: number, scaleY = 1) =>
    `translate(${x - 18}px, ${y - 12}px) rotate(${angle}deg) scaleY(${scaleY})`;
  const settle = () => {
    const p = restPoint();
    plane.getAnimations().forEach((a) => a.cancel());
    plane.style.transform = pose(p.x, p.y, -8);
    plane.style.opacity = '';
    plane.classList.add('is-ready');
  };

  async function fly() {
    if (flying) return;
    flying = true;
    flight.setAttribute('viewBox', `0 0 ${cover.clientWidth} ${cover.clientHeight}`);
    const s0 = local(startMark);
    const s = { x: s0.x, y: s0.y };
    const e = restPoint();
    const low = Math.min(Math.max(s.y, e.y) + 80, cover.clientHeight - 16);
    const dx = e.x - s.x;
    const d = `M${s.x} ${s.y} C${s.x + dx * 0.3} ${low} ${s.x + dx * 0.75} ${low} ${e.x} ${e.y}`;
    trail.setAttribute('d', d);
    reveal.setAttribute('d', d);
    pencil.setAttribute('d', `M${s.x - 72} ${s.y} H${s.x}`);
    flight.classList.add('is-flying');
    plane.getAnimations().forEach((a) => a.cancel());
    plane.style.transform = pose(s.x, s.y, 0, 0.06);
    plane.style.opacity = '0';
    plane.classList.add('is-ready');

    // 1. A pencil stroke along the rule.
    await pencil.animate([{ strokeDashoffset: 1, opacity: 1 }, { strokeDashoffset: 0, opacity: 1 }], { duration: 600, easing: 'ease-out', fill: 'forwards' }).finished;

    // 2. It folds up into a plane.
    pencil.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 300, fill: 'forwards' });
    await plane.animate([{ transform: pose(s.x, s.y, 0, 0.06), opacity: 0.5 }, { transform: pose(s.x, s.y, -12), opacity: 1 }], { duration: 420, easing: 'ease-out', fill: 'forwards' }).finished;

    // 3. It flies the dotted curve, nose along the path.
    const len = trail.getTotalLength();
    const frames: Keyframe[] = [];
    for (let i = 0; i <= 40; i++) {
      const a = trail.getPointAtLength((len * i) / 40);
      const b = trail.getPointAtLength(Math.min(len, (len * i) / 40 + 1));
      const angle = (Math.atan2(b.y - a.y, b.x - a.x) * 180) / Math.PI;
      frames.push({ transform: pose(a.x, a.y, i === 40 ? -8 : angle) });
    }
    const timing = { duration: 1700, easing: 'cubic-bezier(0.45, 0, 0.2, 1)', fill: 'forwards' as const };
    reveal.animate([{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], timing);
    await plane.animate(frames, timing).finished;

    // 4. It lands; the trail fades after a moment.
    settle();
    await trail.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 900, delay: 700, fill: 'forwards' }).finished;
    flight.classList.remove('is-flying');
    trail.getAnimations().forEach((a) => a.cancel());
    pencil.getAnimations().forEach((a) => a.cancel());
    reveal.getAnimations().forEach((a) => a.cancel());
    flying = false;
  }

  let seen: string | null = null;
  try {
    seen = localStorage.getItem('plane-flown');
    localStorage.setItem('plane-flown', '1');
  } catch {
    // Storage can be blocked; the plane then simply flies on each visit.
  }
  const begin = () => {
    if (reduce || seen) settle();
    else setTimeout(fly, 700);
  };
  // On a first visit the doodle says hi first; the plane waits until she has landed.
  if (document.documentElement.classList.contains('hello')) document.addEventListener('intro:done', begin, { once: true });
  else begin();

  plane.addEventListener('click', () => {
    if (reduce) return;
    fly();
  });
  // The landing spot moves when the first screen reflows: the name's web font arriving, or a resize. The cover keeps
  // its height, so the name and the links are watched too.
  const resettle = () => !flying && plane.classList.contains('is-ready') && settle();
  const reflow = new ResizeObserver(resettle);
  for (const el of [cover, document.querySelector('#hero-title'), landing]) if (el) reflow.observe(el);
  document.fonts?.addEventListener('loadingdone', resettle);
  addEventListener('load', resettle);
</script>

<style>
  .hero {
    padding-bottom: var(--space-6);
  }

  /* The first screen is only the name; everything else starts below it. */
  .cover {
    position: relative;
    display: grid;
    align-content: center;
    min-height: calc(100svh - var(--header-height));
    padding-block: var(--space-7);
  }

  .cover :global(.name-star) {
    width: 0.3em;
    height: 0.3em;
    margin-left: 0.08em;
    vertical-align: 0.9em;
    transform: rotate(-12deg);
  }

  /* Sized and placed in em, so they stay beside the name at every width. */
  .first {
    position: relative;
  }

  .sparkle {
    position: absolute;
    fill: var(--pen);
    pointer-events: none;
  }

  .sparkle.one {
    top: 0.22em;
    left: 4.15em;
    width: max(0.75rem, 0.11em);
    opacity: 0.8;
  }

  .sparkle.two {
    top: 0.42em;
    left: -0.07em;
    width: max(0.5rem, 0.07em);
    opacity: 0.6;
  }


  /* Handwritten phrases under the name. One line is reserved so the page never jumps. */
  .phrases {
    min-height: 1.4em;
    margin-top: var(--space-4);
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.3rem, 1rem + 1.1vw, 1.9rem);
    line-height: 1.4;
    color: var(--pen-ink);
    white-space: nowrap;
  }

  .phrase {
    display: inline-block;
    transition: opacity 400ms var(--ease-out), transform 400ms var(--ease-out);
  }

  .phrase.is-out {
    opacity: 0;
    transform: translateY(-3px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .phrase.is-in {
      animation: ink-in 900ms var(--ease-out) both;
    }
  }

  @keyframes ink-in {
    from {
      clip-path: inset(-20% 100% -20% -5%);
      opacity: 0.4;
    }

    to {
      clip-path: inset(-20% -5% -20% -5%);
      opacity: 1;
    }
  }

  /* The flight layer covers the first screen but never takes clicks; only the plane does. */
  .flight {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .pencil-line {
    fill: none;
    stroke: var(--color-faint);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
  }

  .trail {
    fill: none;
    stroke: var(--pen);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 1.5 7;
    opacity: 0;
  }

  .is-flying .trail {
    opacity: 1;
  }

  .trail-reveal {
    fill: none;
    stroke: #fff;
    stroke-width: 10;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .plane {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    width: 36px;
    height: 24px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    opacity: 0;
    transform-origin: 50% 50%;
    -webkit-tap-highlight-color: transparent;
  }

  .plane.is-ready {
    opacity: 1;
  }

  .plane svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 1.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .plane .plane-body {
    fill: var(--color-surface);
  }

  .plane:hover svg {
    stroke: var(--pen-ink);
  }

  .plane:focus-visible {
    outline: 2px dashed var(--pen-ink);
    outline-offset: 4px;
  }

  .tagline {
    max-width: 36rem;
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    line-height: 1.45;
    color: var(--color-ink-soft);
  }

  .pen-hint-below {
    margin-top: var(--space-5);
    font-size: var(--text-xs);
  }

  .hello {
    margin-bottom: var(--space-2);
  }

  .name {
    font-size: clamp(3.75rem, 1.4rem + 10vw, 10.5rem);
    font-weight: 450;
    line-height: 0.88;
    letter-spacing: -0.035em;
  }

  .name > span {
    display: block;
    width: fit-content;
  }

  .name > span:last-child {
    font-style: italic;
    font-weight: 400;
  }

  /* The period doubles as the pen toggle (handled in interactions.ts). */
  .pen-dot {
    position: relative;
    display: inline-block;
    width: 0.16em;
    height: 0.16em;
    margin-left: 0.06em;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--pen);
    vertical-align: baseline;
    cursor: pointer;
    transition: transform var(--duration-base) var(--ease-out), background-color var(--duration-base) var(--ease-out);
  }

  /* Bigger tap target than the dot itself. */
  .pen-dot::before {
    content: '';
    position: absolute;
    inset: -0.12em;
  }

  .pen-dot:hover {
    transform: scale(1.25);
  }

  .pen-dot:active {
    transform: scale(0.85);
  }

  .pen-dot:focus-visible {
    outline-offset: 0.06em;
    border-radius: 50%;
  }

  .actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: 0 var(--space-5);
    border: var(--border-ink);
    border-radius: 999px;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .button:hover {
    background: var(--color-surface-sunken);
  }

  .button:active {
    transform: scale(0.98);
  }

  .button.primary {
    background: var(--color-ink);
    color: var(--color-bg);
  }

  .button.primary:hover {
    background: var(--pen-ink);
    border-color: var(--pen-ink);
    color: var(--color-on-accent);
  }

  .quiet {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    margin-left: var(--space-2);
    list-style: none;
    font-size: var(--text-sm);
  }

  .quiet a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-muted);
    text-decoration: underline;
    text-decoration-color: var(--color-rule-strong);
    text-underline-offset: 0.25em;
    transition: color var(--duration-fast) var(--ease-out), text-decoration-color var(--duration-fast) var(--ease-out);
  }

  .quiet a:hover {
    color: var(--pen-ink);
    text-decoration-color: currentColor;
  }

  /* A pen note pointing at the main button, on wide screens where there is room under it. */
  .start {
    display: none;
  }

  @media (min-width: 64rem) {
    .start {
      position: absolute;
      top: calc(100% + 2px);
      left: 2.5rem;
      display: flex;
      align-items: flex-end;
      gap: 4px;
      font-size: var(--text-xs);
      transform: rotate(-3deg);
    }
  }

  .start svg {
    width: 1.6em;
    height: 1.6em;
    overflow: visible;
    fill: none;
    stroke: var(--pen);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .start path {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: draw 600ms var(--ease-out) 900ms forwards;
    }

    :global(.js) .start .head {
      animation-delay: 1400ms;
    }
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Hint next to the dot; only shown where there's room beside the name. */
  .last {
    position: relative;
  }

  .pen-hint {
    display: none;
    position: absolute;
    left: calc(100% + 0.9rem);
    bottom: 0.35em;
    white-space: nowrap;
    font-size: var(--text-xs);
    font-style: normal;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.4;
  }

  @media (min-width: 64rem) {
    .pen-hint {
      display: block;
    }

    .tagline {
    max-width: 36rem;
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    line-height: 1.45;
    color: var(--color-ink-soft);
  }

  .pen-hint-below {
      display: none;
    }
  }

  /* Starts clear of the first screen, so its paperclip doesn't peek in. */
  .contents {
    position: relative;
    margin-top: var(--space-8);
  }

  .clip {
    position: absolute;
    top: -1.4rem;
    right: 1.5rem;
    width: 1.35rem;
    fill: none;
    stroke: var(--color-faint);
    stroke-width: 2;
    stroke-linecap: round;
    transform: rotate(12deg);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .contents:hover .clip {
    transform: rotate(4deg) translateY(-2px);
  }

  .contents-title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lg);
    color: var(--color-muted);
  }

  .contents ol {
    margin-top: var(--space-2);
    list-style: none;
    border-top: var(--border-ink);
  }

  .contents a {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 2px var(--space-3);
    align-items: baseline;
    padding-block: var(--space-4);
    border-bottom: var(--border-hairline);
    text-decoration: none;
  }

  .n {
    grid-row: span 3;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .t {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.15;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .leader {
    display: none;
  }

  .w {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .p {
    font-size: var(--text-2xs);
  }

  .contents a:hover .t {
    color: var(--pen-ink);
  }

  @media (min-width: 56rem) {
    .contents a {
      grid-template-columns: 2.25rem auto minmax(2rem, 1fr) auto 11rem;
      gap: var(--space-3);
    }

    .n {
      grid-row: auto;
    }

    .leader {
      display: block;
      align-self: center;
      height: 0;
      border-bottom: 2px dotted var(--color-rule-strong);
      transition: border-color var(--duration-fast) var(--ease-out);
    }

    .contents a:hover .leader {
      border-color: var(--pen);
    }

    .p {
      text-align: right;
    }
  }

  @media (max-width: 40rem) {
    .hero {
      padding-top: var(--space-6);
    }

    .quiet {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
