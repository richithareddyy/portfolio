---
import { profile } from '../data/profile';
import Doodle from './Doodle.astro';

const contents = [
  { slug: 'zoom-lens', title: 'ZoomLens', what: 'An AI assistant inside live Zoom meetings', proof: 'Zoom Fellowship project' },
  { slug: 'causeway', title: 'CauseWay', what: 'Did the e-mail cause the spending? A causal study', proof: 'naive estimate off by ~50%' },
  { slug: 'gridcast', title: 'GridCast', what: 'Day-ahead electricity demand, with honest intervals', proof: '22% below the seasonal baseline' },
];
---

<section class="hero wrap" id="top" aria-labelledby="hero-title">
  <div class="cover">
    <p class="hello note">hi, I'm</p>
    <h1 id="hero-title" class="name" aria-label="Richitha Rekula">
      <span class="first">Richitha<Doodle kind="star" class="name-star" /><svg class="sparkle one" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1 Q11 9 19 10 Q11 11 10 19 Q9 11 1 10 Q9 9 10 1Z" /></svg></span>
      <span class="last"><svg class="sparkle two" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1 Q11 9 19 10 Q11 11 10 19 Q9 11 1 10 Q9 9 10 1Z" /></svg>Rekula<button type="button" class="pen-dot" data-pen-toggle aria-label="Change the pen color used across the site"></button><span class="pen-hint note" aria-hidden="true">← click the dot to change the pen color</span></span>
    </h1>
    <p class="pen-hint-below note" aria-hidden="true">↑ click or tap the dot to change the pen color</p>

    <div class="actions">
      <a class="button primary" href="#work">See the work <span aria-hidden="true">↓</span></a>
      <p class="start note" aria-hidden="true">
        <svg viewBox="0 0 30 30"><path d="M5 28 C 3 18, 8 9, 19 5" pathLength="1" /><path class="head" d="M12 3 L 19 5 L 16 11" pathLength="1" /></svg>
        start here
      </p>
      <a class="button" href={profile.links.resume} target="_blank" rel="noopener">
        Résumé <span class="ext-arrow" aria-hidden="true">↗</span><span class="visually-hidden"> (PDF, opens in a new tab)</span>
      </a>
      <ul class="quiet" aria-label="Profiles and email">
        <li><a href={profile.links.github} target="_blank" rel="me noopener">GitHub<span class="visually-hidden"> (opens in a new tab)</span></a></li>
        <li><a href={profile.links.linkedin} target="_blank" rel="me noopener">LinkedIn<span class="visually-hidden"> (opens in a new tab)</span></a></li>
        <li><a href={`mailto:${profile.email}`}>Email</a></li>
      </ul>
    </div>


  </div>

  <nav class="contents" aria-labelledby="contents-title">
    <svg class="clip" viewBox="0 0 24 48" aria-hidden="true"><path d="M8 14 V36 a5 5 0 0 0 10 0 V8 a7 7 0 0 0 -14 0 V34" /></svg>
    <p id="contents-title" class="contents-title">In this notebook</p>
    <ol>
      {
        contents.map((c, i) => (
          <li>
            <a href={`#project-${c.slug}`}>
              <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="t">{c.title}</span>
              <span class="leader" aria-hidden="true" />
              <span class="w">{c.what}</span>
              <span class="p note">{c.proof}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</section>

<style>
  .hero {
    padding-bottom: var(--space-6);
  }

  /* The first screen is only the name; everything else starts below it. */
  .cover {
    position: relative;
    display: grid;
    align-content: center;
    min-height: calc(100svh - var(--header-height));
    padding-block: var(--space-7);
  }

  .cover :global(.name-star) {
    width: 0.3em;
    height: 0.3em;
    margin-left: 0.08em;
    vertical-align: 0.9em;
    transform: rotate(-12deg);
  }

  /* Sized and placed in em, so they stay beside the name at every width. */
  .first {
    position: relative;
  }

  .sparkle {
    position: absolute;
    fill: var(--pen);
    pointer-events: none;
  }

  .sparkle.one {
    top: 0.22em;
    left: 4.15em;
    width: max(0.75rem, 0.11em);
    opacity: 0.8;
  }

  .sparkle.two {
    top: 0.42em;
    left: -0.07em;
    width: max(0.5rem, 0.07em);
    opacity: 0.6;
  }

  .pen-hint-below {
    margin-top: var(--space-5);
    font-size: var(--text-xs);
    transform: rotate(-2deg);
    transform-origin: left;
  }

  .hello {
    margin-bottom: var(--space-2);
  }

  .name {
    font-size: clamp(3.75rem, 1.4rem + 10vw, 10.5rem);
    font-weight: 450;
    line-height: 0.88;
    letter-spacing: -0.035em;
  }

  .name > span {
    display: block;
    width: fit-content;
  }

  .name > span:last-child {
    font-style: italic;
    font-weight: 400;
  }

  /* The period doubles as the pen toggle (handled in interactions.ts). */
  .pen-dot {
    position: relative;
    display: inline-block;
    width: 0.16em;
    height: 0.16em;
    margin-left: 0.06em;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--pen);
    vertical-align: baseline;
    cursor: pointer;
    transition: transform var(--duration-base) var(--ease-out), background-color var(--duration-base) var(--ease-out);
  }

  /* Bigger tap target than the dot itself. */
  .pen-dot::before {
    content: '';
    position: absolute;
    inset: -0.12em;
  }

  .pen-dot:hover {
    transform: scale(1.25);
  }

  .pen-dot:active {
    transform: scale(0.85);
  }

  .pen-dot:focus-visible {
    outline-offset: 0.06em;
    border-radius: 50%;
  }

  .actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: 0 var(--space-5);
    border: var(--border-ink);
    border-radius: 999px;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .button:hover {
    background: var(--color-surface-sunken);
  }

  .button:active {
    transform: scale(0.98);
  }

  .button.primary {
    background: var(--color-ink);
    color: var(--color-bg);
  }

  .button.primary:hover {
    background: var(--pen-ink);
    border-color: var(--pen-ink);
    color: var(--color-on-accent);
  }

  .quiet {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    margin-left: var(--space-2);
    list-style: none;
    font-size: var(--text-sm);
  }

  .quiet a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-muted);
    text-decoration: underline;
    text-decoration-color: var(--color-rule-strong);
    text-underline-offset: 0.25em;
    transition: color var(--duration-fast) var(--ease-out), text-decoration-color var(--duration-fast) var(--ease-out);
  }

  .quiet a:hover {
    color: var(--pen-ink);
    text-decoration-color: currentColor;
  }

  /* A pen note pointing at the main button, on wide screens where there is room under it. */
  .start {
    display: none;
  }

  @media (min-width: 64rem) {
    .start {
      position: absolute;
      top: calc(100% + 2px);
      left: 2.5rem;
      display: flex;
      align-items: flex-end;
      gap: 4px;
      font-size: var(--text-xs);
      transform: rotate(-3deg);
    }
  }

  .start svg {
    width: 1.6em;
    height: 1.6em;
    overflow: visible;
    fill: none;
    stroke: var(--pen);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .start path {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: draw 600ms var(--ease-out) 900ms forwards;
    }

    :global(.js) .start .head {
      animation-delay: 1400ms;
    }
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Hint next to the dot; only shown where there's room beside the name. */
  .last {
    position: relative;
  }

  .pen-hint {
    display: none;
    position: absolute;
    left: calc(100% + 0.9rem);
    bottom: 0.35em;
    width: 11rem;
    font-size: var(--text-xs);
    font-style: normal;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.4;
    white-space: normal;
    transform: rotate(-3deg);
    transform-origin: left bottom;
  }

  @media (min-width: 64rem) {
    .pen-hint {
      display: block;
    }

    .pen-hint-below {
      display: none;
    }
  }

  /* Starts clear of the first screen, so its paperclip doesn't peek in. */
  .contents {
    position: relative;
    margin-top: var(--space-8);
  }

  .clip {
    position: absolute;
    top: -1.4rem;
    right: 1.5rem;
    width: 1.35rem;
    fill: none;
    stroke: var(--color-faint);
    stroke-width: 2;
    stroke-linecap: round;
    transform: rotate(12deg);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .contents:hover .clip {
    transform: rotate(4deg) translateY(-2px);
  }

  .contents-title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lg);
    color: var(--color-muted);
  }

  .contents ol {
    margin-top: var(--space-2);
    list-style: none;
    border-top: var(--border-ink);
  }

  .contents a {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 2px var(--space-3);
    align-items: baseline;
    padding-block: var(--space-4);
    border-bottom: var(--border-hairline);
    text-decoration: none;
  }

  .n {
    grid-row: span 3;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .t {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.15;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .leader {
    display: none;
  }

  .w {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .p {
    font-size: var(--text-2xs);
  }

  .contents a:hover .t {
    color: var(--pen-ink);
  }

  @media (min-width: 56rem) {
    .contents a {
      grid-template-columns: 2.25rem auto minmax(2rem, 1fr) auto 11rem;
      gap: var(--space-3);
    }

    .n {
      grid-row: auto;
    }

    .leader {
      display: block;
      align-self: center;
      height: 0;
      border-bottom: 2px dotted var(--color-rule-strong);
      transition: border-color var(--duration-fast) var(--ease-out);
    }

    .contents a:hover .leader {
      border-color: var(--pen);
    }

    .p {
      text-align: right;
    }
  }

  @media (max-width: 40rem) {
    .hero {
      padding-top: var(--space-6);
    }

    .quiet {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
