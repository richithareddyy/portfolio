---
import { profile } from '../data/profile';
---

<section class="hero wrap" id="top" aria-labelledby="hero-title">
  <div class="intro">
    <p class="label degree">{profile.degree} · {profile.school}</p>
    <h1 id="hero-title">{profile.name}</h1>
    <p class="focus">Software engineering and applied AI.</p>
    <p class="summary">
      I'm a graduate student at ASU and a Zoom Fellow at ASU Next Lab, building{' '}
      <a class="text-link" href="/work/zoom-lens">Zoom Lens</a>: an assistant inside Zoom that privately explains a shared
      screen to the one participant who asked. I've also built a Rust static analyzer, a PostgreSQL ETL pipeline, and ML
      services, each designed so its output can be checked.
    </p>

    <div class="actions">
      <a class="button primary" href="#zoom-lens">See Zoom Lens <span aria-hidden="true">↓</span></a>
      <a class="button" href="#work">Projects</a>
      <a class="button" href="#experience">Experience</a>
    </div>

    <ul class="links" aria-label="Profiles and résumé">
      <li><a href={profile.links.github} target="_blank" rel="me noopener">GitHub <span aria-hidden="true">↗</span></a></li>
      <li><a href={profile.links.linkedin} target="_blank" rel="me noopener">LinkedIn <span aria-hidden="true">↗</span></a></li>
      <li>
        <a href={profile.links.resume} target="_blank" rel="noopener">
          Résumé <span class="hint">PDF</span><span class="visually-hidden"> (opens in a new tab)</span>
        </a>
      </li>
      <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
    </ul>
  </div>

  <dl class="now" aria-label="At a glance">
    <div>
      <dt class="label">Now</dt>
      <dd>Zoom Fellow, ASU Next Lab<span>Aug 2026 – present</span></dd>
    </div>
    <div>
      <dt class="label">Studying</dt>
      <dd>M.S. Data Science, Analytics and Engineering<span>Arizona State University · {profile.graduation}</span></dd>
    </div>
    <div>
      <dt class="label">Looking for</dt>
      <dd>New grad and internship roles<span>Software engineering · Applied AI · ML engineering</span></dd>
    </div>
    <div>
      <dt class="label">Based in</dt>
      <dd>{profile.location}</dd>
    </div>
  </dl>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    padding-top: clamp(2.5rem, 1.5rem + 5vw, 5.5rem);
    padding-bottom: clamp(3rem, 2rem + 4vw, 5rem);
  }

  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) 19rem;
      gap: var(--space-9);
      align-items: end;
    }
  }

  .degree {
    margin-bottom: var(--space-4);
  }

  h1 {
    font-size: var(--text-3xl);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .focus {
    margin-top: var(--space-2);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-xl);
    color: var(--color-ink-soft);
  }

  .summary {
    max-width: 40rem;
    margin-top: var(--space-5);
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--color-ink-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: 0 var(--space-5);
    border: var(--border-strong);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: border-color var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .button:hover {
    border-color: var(--color-ink);
    background: var(--color-surface);
  }

  .button.primary {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-bg);
  }

  .button.primary:hover {
    background: var(--color-accent-ink);
    border-color: var(--color-accent-ink);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-5);
    list-style: none;
    font-size: var(--text-sm);
  }

  .links a {
    color: var(--color-muted);
    text-decoration: underline;
    text-decoration-color: var(--color-rule-strong);
    overflow-wrap: anywhere;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .links a:hover {
    color: var(--color-ink);
    text-decoration-color: currentColor;
  }

  .hint {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.04em;
  }

  .now {
    margin: 0;
    border-top: var(--border-ink);
  }

  .now > div {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-3);
    border-bottom: var(--border-hairline);
  }

  .now dd {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: var(--leading-snug);
  }

  .now dd span {
    display: block;
    margin-top: 2px;
    font-weight: 400;
    color: var(--color-muted);
  }
</style>
