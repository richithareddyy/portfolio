---
import { profile } from '../data/profile';
---

<section class="hero wrap" id="top" aria-labelledby="hero-title">
  <div class="intro">
    <h1 id="hero-title" class="name">
      <span>Richitha</span> <span>Rekula<span class="dot" aria-hidden="true">.</span></span>
    </h1>
    <p class="lede">Software engineer building applied AI systems.</p>

    <div class="actions">
      <a class="button primary" href="#work">View projects</a>
      <a class="button" href={profile.links.resume} target="_blank" rel="noopener">
        Résumé<span class="visually-hidden"> (PDF, opens in a new tab)</span>
      </a>
      <ul class="quiet" aria-label="Profiles and email">
        <li><a href={profile.links.github} target="_blank" rel="me noopener">GitHub<span class="visually-hidden"> (opens in a new tab)</span></a></li>
        <li><a href={profile.links.linkedin} target="_blank" rel="me noopener">LinkedIn<span class="visually-hidden"> (opens in a new tab)</span></a></li>
        <li><a href={`mailto:${profile.email}`}>Email</a></li>
      </ul>
    </div>
  </div>

  <div class="band">
    <dl class="facts">
      <div>
        <dt>Now</dt>
        <dd>Zoom Fellow, ASU Next Lab</dd>
        <dd class="sub">Fellowship in partnership with Zoom</dd>
      </div>
      <div>
        <dt>Education</dt>
        <dd>M.S. Data Science, Analytics and Engineering</dd>
        <dd class="sub">Arizona State University · {profile.graduation}</dd>
      </div>
      <div>
        <dt>Open to</dt>
        <dd>Applied AI, software, AI/ML, and backend roles</dd>
        <dd class="sub">New grad and internship</dd>
      </div>
    </dl>
    <a class="scroll" href="#work">
      Selected work <span class="arrow" aria-hidden="true">↓</span>
    </a>
  </div>
</section>

<style>
  /* The intro fills the first screen; work begins on scroll. */
  .hero {
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - var(--header-height));
    padding-top: var(--space-6);
    padding-bottom: var(--space-5);
  }

  .intro {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: var(--space-7);
  }


  .name {
    font-size: clamp(3.25rem, 1rem + 9vw, 10rem);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.04em;
  }

  /* Each word stays whole; the name breaks between first and last name on narrow screens. */
  .name > span {
    display: inline-block;
  }

  .dot {
    color: var(--color-accent);
  }

  .lede {
    margin-top: var(--space-5);
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.5rem);
    line-height: var(--leading-snug);
    color: var(--color-ink-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 var(--space-5);
    border: var(--border-strong);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: border-color var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out);
  }

  .button:hover {
    border-color: var(--color-ink);
    background: var(--color-surface);
  }

  .button.primary {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-bg);
  }

  .button.primary:hover {
    background: var(--color-accent-ink);
    border-color: var(--color-accent-ink);
  }

  .quiet {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin-left: var(--space-3);
    list-style: none;
    font-size: var(--text-sm);
  }

  .quiet a {
    display: inline-block;
    padding-block: var(--space-2);
    color: var(--color-muted);
    text-decoration: underline;
    text-decoration-color: var(--color-rule-strong);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .quiet a:hover {
    color: var(--color-ink);
    text-decoration-color: currentColor;
  }

  .band {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    padding-top: var(--space-4);
    border-top: var(--border-ink);
  }

  @media (min-width: 60rem) {
    .band {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
  }

  .facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3) var(--space-7);
    margin: 0;
  }

  @media (min-width: 40rem) {
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  dt {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-muted);
  }

  dd {
    margin: 2px 0 0;
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: var(--leading-snug);
  }

  dd.sub {
    font-weight: 400;
    color: var(--color-muted);
  }

  .scroll {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    justify-self: start;
    padding-block: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .scroll:hover {
    color: var(--color-accent-ink);
  }

  .scroll .arrow {
    display: inline-block;
    animation: nudge 2.4s var(--ease-out) infinite;
  }

  @keyframes nudge {
    0%,
    60%,
    100% {
      transform: none;
    }
    75% {
      transform: translateY(3px);
    }
  }

  @media (max-width: 30rem) {
    .quiet {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
