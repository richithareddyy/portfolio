---
import { profile } from '../data/profile';
---

<section class="hero wrap" id="top" aria-labelledby="hero-title">
  <h1 id="hero-title">{profile.name}</h1>
  <p class="headline">Software engineering and applied AI.</p>
  <p class="intro">
    I build software and applied AI systems, currently{' '}
    <a class="text-link" href="/work/zoom-lens">Zoom Lens</a>, an assistant that privately explains a shared screen to one
    meeting participant. My other projects cover Rust static analysis, PostgreSQL data pipelines, and explainable ML services.
  </p>

  <div class="actions">
    <a class="button primary" href="#work">View projects</a>
    <a class="button" href={profile.links.resume} target="_blank" rel="noopener">
      Résumé<span class="visually-hidden"> (PDF, opens in a new tab)</span>
    </a>
    <ul class="quiet" aria-label="Profiles and email">
      <li><a href={profile.links.github} target="_blank" rel="me noopener">GitHub<span class="visually-hidden"> (opens in a new tab)</span></a></li>
      <li><a href={profile.links.linkedin} target="_blank" rel="me noopener">LinkedIn<span class="visually-hidden"> (opens in a new tab)</span></a></li>
      <li><a href={`mailto:${profile.email}`}>Email</a></li>
    </ul>
  </div>

  <dl class="facts">
    <div>
      <dt>Education</dt>
      <dd>M.S. Data Science, Analytics and Engineering, Arizona State University · {profile.graduation}</dd>
    </div>
    <div>
      <dt>Current</dt>
      <dd>Zoom Fellow, ASU Next Lab</dd>
    </div>
    <div>
      <dt>Open to</dt>
      <dd>New grad and internship roles in software engineering, applied AI, and ML engineering</dd>
    </div>
  </dl>
</section>

<style>
  .hero {
    padding-top: clamp(2.5rem, 1.5rem + 5vw, 5rem);
    padding-bottom: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
  }

  h1 {
    font-size: var(--text-3xl);
    letter-spacing: -0.02em;
  }

  .headline {
    margin-top: var(--space-2);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-accent-ink);
  }

  .intro {
    max-width: 38rem;
    margin-top: var(--space-5);
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--color-ink-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 var(--space-5);
    border: var(--border-strong);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: border-color var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out);
  }

  .button:hover {
    border-color: var(--color-ink);
    background: var(--color-surface);
  }

  .button.primary {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-bg);
  }

  .button.primary:hover {
    background: var(--color-accent-ink);
    border-color: var(--color-accent-ink);
  }

  .quiet {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin-left: var(--space-3);
    list-style: none;
    font-size: var(--text-sm);
  }

  .quiet a {
    display: inline-block;
    padding-block: var(--space-2);
    color: var(--color-muted);
    text-decoration: underline;
    text-decoration-color: var(--color-rule-strong);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .quiet a:hover {
    color: var(--color-ink);
    text-decoration-color: currentColor;
  }

  .facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3) var(--space-6);
    margin: var(--space-7) 0 0;
    padding-top: var(--space-4);
    border-top: var(--border-hairline);
  }

  @media (min-width: 48rem) {
    .facts {
      grid-template-columns: 1.3fr 0.8fr 1.2fr;
    }
  }

  dt {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-muted);
  }

  dd {
    margin: 2px 0 0;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  @media (max-width: 30rem) {
    .quiet {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
