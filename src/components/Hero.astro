---
import { profile } from '../data/profile';
import Mark from './Mark.astro';

// The three projects that matter most, set as a table of contents with the evidence in the margin.
const contents = [
  { slug: 'zoom-lens', title: 'Zoom Lens', what: 'An AI assistant inside live Zoom meetings', proof: 'Zoom Fellowship project' },
  { slug: 'codeatlas', title: 'CodeAtlas', what: 'What a Rust change can break, with receipts', proof: 'indexes tokio in 3.6 s' },
  { slug: 'reddit-data-pipeline', title: 'Reddit ETL Pipeline', what: '18.9M records into PostgreSQL, every one accounted for', proof: '584 s → 345 s' },
];
---

<section class="hero wrap" id="top" aria-labelledby="hero-title">
  <div class="layout">
    <div class="main">
      <p class="hello note">hi, I'm</p>
      <h1 id="hero-title" class="name" aria-label="Richitha Rekula">
        <span>Richitha</span>
        <span class="last">Rekula<button type="button" class="pen-dot" data-pen-toggle aria-label="Change the pen color used across the site"></button><span class="pen-hint note" aria-hidden="true">← psst. that dot is a pen. try it.</span></span>
      </h1>
      <p class="lede">
        Software engineer building <Mark kind="circle" delay={150}>applied AI</Mark> and <Mark kind="under" delay={550}>backend systems</Mark>.
      </p>
      <p class="desc">
        I’m a <span class="hl">Zoom Fellow at ASU Next Lab</span>, building an AI assistant that runs inside live Zoom meetings. I also
        build the systems underneath: a Rust code-analysis engine, and a PostgreSQL pipeline that accounts for every one of 18.9M records.
      </p>

      <div class="actions">
        <a class="button primary" href="#work">See the work <span aria-hidden="true">↓</span></a>
        <a class="button" href={profile.links.resume} target="_blank" rel="noopener">
          Résumé <span class="ext-arrow" aria-hidden="true">↗</span><span class="visually-hidden"> (PDF, opens in a new tab)</span>
        </a>
        <ul class="quiet" aria-label="Profiles and email">
          <li><a href={profile.links.github} target="_blank" rel="me noopener">GitHub<span class="visually-hidden"> (opens in a new tab)</span></a></li>
          <li><a href={profile.links.linkedin} target="_blank" rel="me noopener">LinkedIn<span class="visually-hidden"> (opens in a new tab)</span></a></li>
          <li><a href={`mailto:${profile.email}`}>Email</a></li>
        </ul>
      </div>
    </div>

    <aside class="margin" aria-label="Quick facts">
      <dl class="facts note">
        <div><dt>now</dt><dd><b>Zoom Fellow</b>, ASU Next Lab</dd></div>
        <div><dt>studying</dt><dd>M.S. Data Science, Analytics and Engineering, Arizona State ({profile.graduation.replace('Expected ', '')})</dd></div>
        <div><dt>based in</dt><dd>{profile.location}</dd></div>
        <div><dt>open to</dt><dd>new grad and internship roles in software, applied AI, and backend</dd></div>
      </dl>
    </aside>
  </div>

  <nav class="contents" aria-labelledby="contents-title">
    <p id="contents-title" class="contents-title">In this notebook</p>
    <ol>
      {
        contents.map((c, i) => (
          <li>
            <a href={`#project-${c.slug}`}>
              <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="t">{c.title}</span>
              <span class="leader" aria-hidden="true" />
              <span class="w">{c.what}</span>
              <span class="p note">{c.proof}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</section>

<style>
  .hero {
    padding-block: var(--space-8) var(--space-6);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6) var(--space-8);
  }

  @media (min-width: 64rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) var(--width-margin);
      align-items: end;
    }
  }

  .main {
    min-width: 0;
  }

  .hello {
    margin-bottom: var(--space-2);
  }

  .name {
    font-size: clamp(3.75rem, 1.6rem + 8vw, 8.5rem);
    font-weight: 450;
    line-height: 0.88;
    letter-spacing: -0.035em;
  }

  .name > span {
    display: block;
    width: fit-content;
  }

  .name > span:last-child {
    font-style: italic;
    font-weight: 400;
  }

  /* The period is a pen: each click switches the ink color used across the site. */
  .pen-dot {
    position: relative;
    display: inline-block;
    width: 0.16em;
    height: 0.16em;
    margin-left: 0.06em;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--pen);
    vertical-align: baseline;
    cursor: pointer;
    transition: transform var(--duration-base) var(--ease-out), background-color var(--duration-base) var(--ease-out);
  }

  /* A comfortable tap area around a small dot. */
  .pen-dot::before {
    content: '';
    position: absolute;
    inset: -0.12em;
  }

  .pen-dot:hover {
    transform: scale(1.25);
  }

  .pen-dot:active {
    transform: scale(0.85);
  }

  .pen-dot:focus-visible {
    outline-offset: 0.06em;
    border-radius: 50%;
  }

  .lede {
    max-width: 34rem;
    margin-top: var(--space-6);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.15rem + 1.2vw, 2.1rem);
    line-height: 1.3;
  }

  .desc {
    max-width: 50ch;
    margin-top: var(--space-4);
    font-size: var(--text-md);
    color: var(--color-ink-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: 0 var(--space-5);
    border: var(--border-ink);
    border-radius: 999px;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .button:hover {
    background: var(--color-surface-sunken);
  }

  .button:active {
    transform: scale(0.98);
  }

  .button.primary {
    background: var(--color-ink);
    color: var(--color-bg);
  }

  .button.primary:hover {
    background: var(--pen-ink);
    border-color: var(--pen-ink);
    color: var(--color-on-accent);
  }

  .quiet {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    margin-left: var(--space-2);
    list-style: none;
    font-size: var(--text-sm);
  }

  .quiet a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-muted);
    text-decoration: underline;
    text-decoration-color: var(--color-rule-strong);
    text-underline-offset: 0.25em;
    transition: color var(--duration-fast) var(--ease-out), text-decoration-color var(--duration-fast) var(--ease-out);
  }

  .quiet a:hover {
    color: var(--pen-ink);
    text-decoration-color: currentColor;
  }

  /* Margin: notes in the right column on wide screens, a short list under the actions on small ones. */
  .margin {
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }

  /* Sits just right of the dot on wide screens; hidden where there is no room for it. */
  .last {
    position: relative;
  }

  .pen-hint {
    display: none;
    position: absolute;
    left: calc(100% + 0.9rem);
    bottom: 0.35em;
    width: 11rem;
    font-size: var(--text-xs);
    font-style: normal;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.4;
    white-space: normal;
    transform: rotate(-3deg);
    transform-origin: left bottom;
  }

  @media (min-width: 64rem) {
    .margin {
      align-self: stretch;
      align-content: end;
      padding-left: var(--space-5);
      border-left: 1px dashed var(--color-rule-strong);
    }

    .pen-hint {
      display: block;
    }
  }

  .facts {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  .facts dt {
    color: var(--color-muted);
  }

  .facts dt::after {
    content: ':';
  }

  .facts dd {
    margin: 0;
    color: var(--color-ink-soft);
  }

  @media (min-width: 40rem) and (max-width: 63.99rem) {
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3) var(--space-6);
    }
  }

  /* Table of contents with dot leaders. */
  .contents {
    margin-top: var(--space-8);
  }

  .contents-title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lg);
    color: var(--color-muted);
  }

  .contents ol {
    margin-top: var(--space-2);
    list-style: none;
    border-top: var(--border-ink);
  }

  .contents a {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 2px var(--space-3);
    align-items: baseline;
    padding-block: var(--space-4);
    border-bottom: var(--border-hairline);
    text-decoration: none;
  }

  .n {
    grid-row: span 3;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .t {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.15;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .leader {
    display: none;
  }

  .w {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .p {
    font-size: var(--text-2xs);
  }

  .contents a:hover .t {
    color: var(--pen-ink);
  }

  @media (min-width: 56rem) {
    .contents a {
      grid-template-columns: 2.25rem auto minmax(2rem, 1fr) auto 11rem;
      gap: var(--space-3);
    }

    .n {
      grid-row: auto;
    }

    .leader {
      display: block;
      align-self: center;
      height: 0;
      border-bottom: 2px dotted var(--color-rule-strong);
      transition: border-color var(--duration-fast) var(--ease-out);
    }

    .contents a:hover .leader {
      border-color: var(--pen);
    }

    .p {
      text-align: right;
    }
  }

  @media (max-width: 40rem) {
    .hero {
      padding-top: var(--space-6);
    }

    .quiet {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
