---
import { profile } from '../data/profile';

const proof = [
  { text: 'a private AI assistant inside Zoom', href: '#project-zoom-lens' },
  { text: 'a Rust change-impact analyzer', href: '#project-codeatlas' },
  { text: 'an 18.9M‑line PostgreSQL pipeline', href: '#project-reddit-data-pipeline' },
];
---

<section class="hero wrap" id="top" aria-labelledby="hero-title">
  <div class="main">
    <h1 id="hero-title">{profile.name}</h1>
    <p class="headline">Software engineer building applied AI systems.</p>
    <p class="proof">
      Recently:{' '}
      {
        proof.map((p, i) => (
          <>
            <a href={p.href}>{p.text}</a>
            {i < proof.length - 2 ? ', ' : i === proof.length - 2 ? ', and ' : '.'}
          </>
        ))
      }
    </p>

    <div class="actions">
      <a class="button primary" href="#work">View projects</a>
      <a class="button" href={profile.links.resume} target="_blank" rel="noopener">
        Résumé<span class="visually-hidden"> (PDF, opens in a new tab)</span>
      </a>
      <ul class="quiet" aria-label="Profiles and email">
        <li><a href={profile.links.github} target="_blank" rel="me noopener">GitHub<span class="visually-hidden"> (opens in a new tab)</span></a></li>
        <li><a href={profile.links.linkedin} target="_blank" rel="me noopener">LinkedIn<span class="visually-hidden"> (opens in a new tab)</span></a></li>
        <li><a href={`mailto:${profile.email}`}>Email</a></li>
      </ul>
    </div>
  </div>

  <dl class="facts">
    <div>
      <dt>Now</dt>
      <dd>Zoom Fellow, ASU Next Lab</dd>
      <dd class="sub">Fellowship in partnership with Zoom, building Zoom Lens</dd>
    </div>
    <div>
      <dt>Education</dt>
      <dd>M.S. Data Science, Analytics and Engineering</dd>
      <dd class="sub">Arizona State University · {profile.graduation}</dd>
    </div>
    <div>
      <dt>Open to</dt>
      <dd>Applied AI, software, AI/ML, and backend engineering</dd>
      <dd class="sub">New grad and internship roles</dd>
    </div>
  </dl>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    padding-top: clamp(1.75rem, 1rem + 2.5vw, 3rem);
    padding-bottom: clamp(2rem, 1.25rem + 2vw, 3rem);
  }

  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) 19rem;
      gap: var(--space-8);
      align-items: end;
    }
  }

  h1 {
    font-size: var(--text-3xl);
    letter-spacing: -0.02em;
  }

  .headline {
    margin-top: var(--space-2);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    color: var(--color-accent-ink);
  }

  .proof {
    max-width: 36rem;
    margin-top: var(--space-4);
    font-size: var(--text-md);
    line-height: 1.55;
    color: var(--color-ink-soft);
  }

  .proof a {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-rule-strong);
    text-underline-offset: 0.2em;
    transition: color var(--duration-fast) var(--ease-out), text-decoration-color var(--duration-fast) var(--ease-out);
  }

  .proof a:hover {
    color: var(--color-accent-ink);
    text-decoration-color: currentColor;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 var(--space-5);
    border: var(--border-strong);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: border-color var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out);
  }

  .button:hover {
    border-color: var(--color-ink);
    background: var(--color-surface);
  }

  .button.primary {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-bg);
  }

  .button.primary:hover {
    background: var(--color-accent-ink);
    border-color: var(--color-accent-ink);
  }

  .quiet {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin-left: var(--space-3);
    list-style: none;
    font-size: var(--text-sm);
  }

  .quiet a {
    display: inline-block;
    padding-block: var(--space-2);
    color: var(--color-muted);
    text-decoration: underline;
    text-decoration-color: var(--color-rule-strong);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .quiet a:hover {
    color: var(--color-ink);
    text-decoration-color: currentColor;
  }

  .facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3) var(--space-6);
    margin: 0;
    padding-top: var(--space-4);
    border-top: var(--border-hairline);
  }

  @media (min-width: 40rem) and (max-width: 59.99rem) {
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 60rem) {
    .facts {
      border-top: var(--border-ink);
    }
  }

  dt {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-muted);
  }

  dd {
    margin: 2px 0 0;
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: var(--leading-snug);
  }

  dd.sub {
    font-weight: 400;
    color: var(--color-muted);
  }

  @media (max-width: 30rem) {
    .quiet {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
