---
import { zoomLens } from '../data/projects';

const { demoVideo, demoPoster } = zoomLens;
---

{
  demoVideo ? (
    <figure class="media">
      <video
        src={demoVideo}
        poster={demoPoster ?? undefined}
        controls
        muted
        playsinline
        preload="metadata"
        aria-label="Zoom Lens demo recording"
      />
      <figcaption>Zoom Lens running in a live meeting.</figcaption>
    </figure>
  ) : (
    <figure class="media placeholder" aria-label="Demo recording placeholder">
      <div class="slot">
        <p class="label">Demo recording</p>
        <p class="soon">Coming soon</p>
      </div>
    </figure>
  )
}

<style>
  .media {
    margin: 0;
  }

  video {
    width: 100%;
    aspect-ratio: 16 / 10;
    background: var(--color-surface-sunken);
    border: var(--border-hairline);
    border-radius: var(--radius-md);
  }

  figcaption {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .slot {
    display: grid;
    place-content: center;
    gap: var(--space-1);
    aspect-ratio: 16 / 10;
    text-align: center;
    background: var(--color-bg);
    border: 1px dashed var(--color-rule-strong);
    border-radius: var(--radius-md);
  }

  .soon {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-muted);
  }
</style>
