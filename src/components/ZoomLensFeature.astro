---
import { zoomLens } from '../data/projects';
import ZoomLensMedia from './ZoomLensMedia.astro';
---

<article class="zl" id="zoom-lens" aria-labelledby="zl-title">
  <div class="wrap grid">
    <div class="text">
      <p class="label">{zoomLens.kicker} · {zoomLens.year}</p>
      <h3 id="zl-title"><a href="/work/zoom-lens" transition:name="title-zoom-lens">{zoomLens.title}</a></h3>
      <p class="one-liner">{zoomLens.oneLiner}</p>

      <dl class="facts">
        <div>
          <dt>Problem</dt>
          <dd>{zoomLens.problemShort}</dd>
        </div>
        <div>
          <dt>My contribution</dt>
          <dd>{zoomLens.contribution}</dd>
        </div>
        <div>
          <dt>Status</dt>
          <dd>
            {zoomLens.status}. It reads the participant’s display for now; capture directly from the meeting feed is not yet
            enabled.
          </dd>
        </div>
      </dl>

      <ul class="modes" aria-label="Interactions">
        {
          zoomLens.modes.map((m) => (
            <li>
              <span class="mode-name">{m.name}</span>
              <span class="mode-what">{m.what}</span>
              <span class="mode-time">{m.timing}</span>
            </li>
          ))
        }
      </ul>

      <a class="arrow-link" href="/work/zoom-lens">
        Zoom Lens case study <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <div class="media">
      <ZoomLensMedia />
    </div>
  </div>
</article>

<style>
  .zl {
    padding-block: var(--space-7);
    background: var(--color-surface);
    border-top: var(--border-hairline);
    border-bottom: var(--border-hairline);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
  }

  @media (min-width: 60rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-8);
      align-items: start;
    }
  }

  .text {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  h3 {
    font-size: clamp(2.25rem, 1.6rem + 2.6vw, 3.5rem);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  h3 a {
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  h3 a:hover {
    color: var(--color-accent-ink);
  }

  .one-liner {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--color-ink-soft);
  }

  .facts {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    font-size: var(--text-sm);
  }

  dt {
    font-weight: 600;
  }

  dd {
    margin: 0;
    color: var(--color-ink-soft);
  }

  .modes {
    width: 100%;
    list-style: none;
    border-top: var(--border-hairline);
  }

  .modes li {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: baseline;
    padding-block: var(--space-2);
    border-bottom: var(--border-hairline);
    font-size: var(--text-sm);
  }

  .mode-name {
    font-weight: 500;
  }

  .mode-what {
    color: var(--color-muted);
  }

  .mode-time {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent-ink);
    white-space: nowrap;
  }
</style>
