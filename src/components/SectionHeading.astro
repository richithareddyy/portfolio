---
import Doodle from './Doodle.astro';
import MarginDoodle from './MarginDoodle.astro';

interface Props {
  id: string;
  note?: string;
}

const { id, note } = Astro.props;
const numbers: Record<string, string> = { work: '01', experience: '02', about: '03', contact: '04' };
const kickers: Record<string, string> = { work: 'Selected work', experience: 'Experience', about: 'About', contact: 'Contact' };
const doodles = { work: 'star', experience: 'trail', about: 'heart', contact: 'plane' } as const;
const doodle = doodles[id as keyof typeof doodles];
const sketches = {
  work: { kind: 'bell', side: 'left' },
  experience: { kind: 'mug', side: 'right' },
  about: { kind: 'net', side: 'left' },
  contact: { kind: 'scatter', side: 'right' },
} as const;
const sketch = sketches[id as keyof typeof sketches];
---

<header class="section-heading">
  <p class="kicker">
    <span class="num">Nº {numbers[id] ?? '00'}</span> <span class="what">{kickers[id] ?? id}</span>
    {sketch && <MarginDoodle kind={sketch.kind} side={sketch.side} />}
  </p>
  <h2 id={`${id}-title`}>
    <slot />{doodle && <Doodle kind={doodle} />}
  </h2>
  {note && <p class="note aside">{note}</p>}
</header>

<style>
  .section-heading {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2) var(--space-8);
    margin-bottom: var(--space-7);
  }

  @media (min-width: 64rem) {
    .section-heading {
      grid-template-columns: minmax(0, 1fr) var(--width-margin);
      align-items: end;
    }

    .kicker,
    h2 {
      grid-column: 1;
    }

    .aside {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: end;
      padding-left: var(--space-5);
      border-left: 1px dashed var(--color-rule-strong);
    }
  }

  .kicker {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  /* The section number is a ribbon bookmark tucked into the page; it tugs down a little on hover. */
  .num {
    align-self: flex-start;
    padding: 0.4em 0.65em 0.75em;
    background: var(--pen-ink);
    color: var(--color-on-accent);
    font-weight: 500;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 80%, 0 100%);
    transform: translateY(-0.35em);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .section-heading:hover .num {
    transform: translateY(0);
  }

  .what::before {
    content: '/ ';
    color: var(--color-rule-strong);
  }

  h2 {
    font-size: var(--text-3xl);
    font-weight: 450;
    line-height: 1.02;
    letter-spacing: -0.025em;
  }

  h2 :global(em) {
    font-weight: 400;
  }

  /* The doodle gives one small wiggle when you point at the heading. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    h2:hover :global(.pen-doodle) {
      animation: wiggle 500ms var(--ease-out);
    }
  }

  @keyframes wiggle {
    30% {
      transform: rotate(-20deg) scale(1.15);
    }

    65% {
      transform: rotate(4deg);
    }
  }
</style>
