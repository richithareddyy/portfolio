---
interface Props {
  id: string;
  lede?: string;
}

const { id, lede } = Astro.props;
const sections: Record<string, string> = { work: '01 / SELECTED SYSTEMS', experience: '02 / EXPERIENCE', skills: '03 / TOOL → EVIDENCE', about: '04 / ABOUT', contact: '05 / CONTACT' };
---

<header class="section-heading" data-reveal>
  <p class="lab-label">{sections[id] ?? 'RESEARCH NOTES'}</p>
  <h2 id={`${id}-title`}>
    <slot />
  </h2>
  {lede && <p class="lede">{lede}</p>}
</header>

<style>
  .section-heading {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: var(--border-ink);
    margin-bottom: var(--space-6);
  }

  h2 {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-2xl);
  }


  .lede {
    max-width: var(--width-prose);
    color: var(--color-muted);
    font-size: var(--text-md);
  }
</style>
