---
interface Props {
  id: string;
  lede?: string;
}

const { id, lede } = Astro.props;
---

<header class="section-heading">
  <h2 id={`${id}-title`}>
    <svg class="reticle" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
      <circle cx="10" cy="10" r="6" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
      <path d="M10 0v5M10 15v5M0 10h5M15 10h5" stroke="currentColor" stroke-width="1.4"></path>
    </svg>
    <slot />
  </h2>
  {lede && <p class="lede">{lede}</p>}
</header>

<style>
  .section-heading {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: var(--border-ink);
    margin-bottom: var(--space-6);
  }

  h2 {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-2xl);
  }

  .reticle {
    flex: none;
    width: 0.6em;
    height: 0.6em;
    color: var(--color-accent);
  }

  .lede {
    max-width: var(--width-prose);
    color: var(--color-muted);
    font-size: var(--text-md);
  }
</style>
