---
import Doodle from './Doodle.astro';

interface Props {
  id: string;
  note?: string;
}

const { id, note } = Astro.props;
const numbers: Record<string, string> = { work: '01', experience: '02', skills: '03', about: '04', contact: '05' };
const kickers: Record<string, string> = { work: 'the work', experience: 'where I’ve been', skills: 'toolbox', about: 'about me', contact: 'say hello' };
const doodles = { work: 'star', experience: 'trail', skills: 'pencil', about: 'heart', contact: 'plane' } as const;
const doodle = doodles[id as keyof typeof doodles];
---

<header class="section-heading">
  <p class="kicker"><span class="num">Nº {numbers[id] ?? '00'}</span> <span class="what">{kickers[id] ?? id}</span></p>
  <h2 id={`${id}-title`}>
    <slot />{doodle && <Doodle kind={doodle} />}
  </h2>
  {note && <p class="note aside">{note}</p>}
</header>

<style>
  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2) var(--space-8);
    margin-bottom: var(--space-7);
  }

  @media (min-width: 64rem) {
    .section-heading {
      grid-template-columns: minmax(0, 1fr) var(--width-margin);
      align-items: end;
    }

    .kicker,
    h2 {
      grid-column: 1;
    }

    .aside {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: end;
      padding-left: var(--space-5);
      border-left: 1px dashed var(--color-rule-strong);
    }
  }

  .kicker {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .num {
    color: var(--pen-ink);
  }

  .what::before {
    content: '/ ';
    color: var(--color-rule-strong);
  }

  h2 {
    font-size: var(--text-3xl);
    font-weight: 450;
    line-height: 1.02;
    letter-spacing: -0.025em;
  }

  h2 :global(em) {
    font-weight: 400;
  }
</style>
