---
import { zoomLens } from '../data/projects';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const { privacy } = zoomLens;
---

<div class:list={['privacy', { compact }]}>
  <div class="copy">
    <p>{privacy.intro}</p>
    <p class="strong">{privacy.whyServer}</p>
  </div>

  <figure class="flow" aria-labelledby="privacy-flow-caption">
    <ol class="lanes">
      <li class="node">
        <span class="label">1 · Request</span>
        <strong>Your panel</strong>
        <span class="note">Describe, Explain, or Follow-up</span>
      </li>
      <li class="node server">
        <span class="label">2 · Server checks</span>
        <strong>Zoom Lens server</strong>
        <ul class="checks">
          {privacy.rules.map((rule) => <li>{rule.title}</li>)}
        </ul>
      </li>
      <li class="node">
        <span class="label">3 · Reply</span>
        <strong>Your panel only</strong>
        <span class="note">Addressed to exactly one recipient</span>
      </li>
    </ol>
    <p class="nobody">
      <span class="label">Everyone else</span>
      Other participants and the presenter receive nothing, and nothing appears in the meeting.
    </p>
    <figcaption id="privacy-flow-caption" class="visually-hidden">
      Request flow: a request from your panel goes to the Zoom Lens server, which enforces single-recipient messages, has no
      broadcast path, and refuses replies that do not match a request from your session. The reply returns only to your panel.
    </figcaption>
  </figure>

  {
    !compact && (
      <dl class="rules">
        {privacy.rules.map((rule) => (
          <div>
            <dt>{rule.title}</dt>
            <dd>{rule.body}</dd>
          </div>
        ))}
      </dl>
    )
  }
</div>

<style>
  .privacy {
    display: grid;
    gap: var(--space-6);
  }

  .copy {
    display: grid;
    gap: var(--space-3);
    max-width: var(--width-prose);
    color: var(--color-ink-soft);
  }

  .strong {
    color: var(--color-ink);
    font-weight: 500;
  }

  .flow {
    margin: 0;
  }

  .lanes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    list-style: none;
    counter-reset: lane;
  }

  @media (min-width: 48rem) {
    .lanes {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr) minmax(0, 1fr);
      gap: var(--space-6);
    }
  }

  .node {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-1);
    padding: var(--space-4);
    background: var(--color-bg);
    border: var(--border-strong);
    border-radius: var(--radius-sm);
  }

  .node strong {
    font-weight: 500;
  }

  /* Connectors between nodes */
  .node:not(:last-child)::after {
    content: '';
    position: absolute;
    background: var(--color-ink);
  }

  .node:not(:last-child)::before {
    content: '';
    position: absolute;
    width: 0;
    height: 0;
    border: 5px solid transparent;
  }

  @media (max-width: 47.99rem) {
    .node:not(:last-child)::after {
      left: 1.5rem;
      top: 100%;
      width: 1px;
      height: var(--space-5);
    }
    .node:not(:last-child)::before {
      left: calc(1.5rem - 4.5px);
      top: calc(100% + var(--space-5) - 5px);
      border-top-color: var(--color-ink);
    }
  }

  @media (min-width: 48rem) {
    .node:not(:last-child)::after {
      top: 50%;
      left: 100%;
      width: var(--space-6);
      height: 1px;
    }
    .node:not(:last-child)::before {
      top: calc(50% - 4.5px);
      left: calc(100% + var(--space-6) - 5px);
      border-left-color: var(--color-ink);
    }
  }

  .server {
    border-color: var(--color-ink);
    background: var(--color-surface);
  }

  .note {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .checks {
    display: grid;
    gap: 2px;
    margin-top: var(--space-1);
    list-style: none;
    font-size: var(--text-sm);
  }

  .checks li::before {
    content: '✓';
    display: inline-block;
    width: 1.25em;
    color: var(--color-positive);
    font-weight: 600;
  }

  .nobody {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px dashed var(--color-rule-strong);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .rules {
    display: grid;
    gap: 0;
    margin: 0;
    border-top: var(--border-hairline);
  }

  .rules > div {
    display: grid;
    gap: var(--space-1) var(--space-6);
    padding-block: var(--space-3);
    border-bottom: var(--border-hairline);
  }

  @media (min-width: 48rem) {
    .rules > div {
      grid-template-columns: 16rem minmax(0, 1fr);
    }
  }

  .rules dt {
    font-weight: 500;
  }

  .rules dd {
    margin: 0;
    color: var(--color-muted);
  }
</style>
