---
import { Image } from 'astro:assets';
import type { Visual } from '../data/projects';
import EtlDiagram from './visuals/EtlDiagram.astro';
import LoadTestOutput from './visuals/LoadTestOutput.astro';

interface Props {
  visual: Visual;
  /** card: fixed 16:10 frame; feature: larger frame; full: natural height on case studies. */
  size?: 'card' | 'feature' | 'full';
  eager?: boolean;
  /** Makes the frame a mouse shortcut to this URL (kept out of the tab order; the title link is the accessible one). */
  href?: string;
}

const { visual, size = 'card', eager = false, href } = Astro.props;

const widths = size === 'card' ? [400, 640, 800] : [640, 960, 1280, 1600];
const sizes =
  size === 'card'
    ? '(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, 92vw'
    : '(min-width: 64rem) 40rem, 92vw';
const kindLabel = visual.kind === 'image' ? null : visual.kind === 'diagram' ? 'Diagram' : 'Sample output';
---

<figure class:list={['visual', size, visual.kind]}>
  <div class:list={['frame', { linked: !!href }]}>
    {
      visual.kind === 'image' && (
        <Image
          src={visual.src}
          alt={visual.alt}
          widths={widths}
          sizes={sizes}
          loading={eager ? 'eager' : 'lazy'}
          class:list={[{ contain: visual.src.height > visual.src.width * 0.8 }]}
        />
      )
    }
    {visual.kind === 'diagram' && visual.id === 'etl' && <EtlDiagram />}
    {visual.kind === 'output' && <LoadTestOutput />}
    {href && <a class="cover" href={href} tabindex="-1" aria-hidden="true"></a>}
  </div>
  <figcaption>
    {kindLabel && <span class="kind">{kindLabel}.</span>}
    {visual.caption}
  </figcaption>
</figure>

<style>
  .visual {
    margin: 0;
    min-width: 0;
  }

  .frame {
    position: relative;
    background: var(--color-surface);
    border: var(--border-hairline);
    border-radius: var(--radius-md);
  }

  .card .frame {
    aspect-ratio: 16 / 10;
  }

  .feature .frame {
    aspect-ratio: 16 / 10;
  }

  .full.diagram .frame,
  .full.output .frame {
    aspect-ratio: 16 / 9;
    max-height: 30rem;
  }

  .image .frame {
    overflow: clip;
  }

  .linked {
    transition: border-color var(--duration-base) var(--ease-out);
  }

  .cover {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .linked:hover {
    border-color: var(--color-rule-strong);
  }


  .linked :global(img) {
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .linked:hover :global(img) {
    transform: scale(1.02);
  }

  .output .frame {
    overflow: clip;
    border-radius: var(--radius-md);
  }

  .frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }

  .frame :global(img.contain) {
    object-fit: contain;
    background: #fff;
  }

  .full .frame :global(img) {
    height: auto;
  }

  figcaption {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    line-height: 1.45;
    color: var(--color-muted);
  }

  .card figcaption {
    min-height: calc(2 * 1.45em);
  }

  .kind {
    font-weight: 600;
    color: var(--color-ink-soft);
    margin-right: 0.25em;
  }

  @media (max-width: 30rem) {
    .full.diagram .frame,
    .full.output .frame {
      aspect-ratio: auto;
      min-height: 16rem;
    }
  }
</style>
