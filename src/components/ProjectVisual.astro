---
import { Image } from 'astro:assets';
import type { Visual } from '../data/projects';

interface Props {
  visual: Visual;
  /** feature: fixed 16:10 frame on the homepage; full: natural height on case studies. */
  size?: 'feature' | 'full';
  eager?: boolean;
  /** Makes the frame a mouse shortcut. It stays out of the tab order since the title link is the accessible one. */
  href?: string;
}

const { visual, size = 'feature', eager = false, href } = Astro.props;
---

<figure class:list={['visual', size]}>
  <div class:list={['frame', { linked: !!href }]}>
    <Image
      src={visual.src}
      alt={visual.alt}
      widths={[640, 960, 1280, 1600]}
      sizes="(min-width: 64rem) 40rem, 92vw"
      loading={eager ? 'eager' : 'lazy'}
      class:list={[{ contain: visual.src.height > visual.src.width * 0.8 }]}
    />
    {href && <a class="cover" href={href} tabindex="-1" aria-hidden="true"></a>}
  </div>
  <figcaption>{visual.caption}</figcaption>
</figure>

<style>
  .visual {
    margin: 0;
    min-width: 0;
  }

  .feature .frame {
    aspect-ratio: 16 / 10;
  }

  .frame {
    position: relative;
    background: var(--color-surface);
    border: var(--border-hairline);
    border-radius: var(--radius-md);
    overflow: clip;
  }

  .linked {
    transition: border-color var(--duration-base) var(--ease-out);
  }

  .cover {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .linked:hover {
    border-color: var(--color-rule-strong);
  }

  .linked :global(img) {
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .linked:hover :global(img) {
    transform: scale(1.02);
  }

  .frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }

  .frame :global(img.contain) {
    object-fit: contain;
    background: #fff;
  }

  .full .frame :global(img) {
    height: auto;
  }

  figcaption {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    line-height: 1.45;
    color: var(--color-muted);
  }
</style>
