---
/* A small margin doodle in the pen color. It draws in like the other pen marks. Decorative only. */
interface Props {
  kind: 'star' | 'heart' | 'plane' | 'trail' | 'pencil';
  class?: string;
}
const { kind, class: className } = Astro.props;

const paths = {
  star: ['M20 4 L24.5 15 L36 15.5 L27 23 L30 34.5 L20 28 L10 34.5 L13 23 L4 15.5 L15.5 15 Z'],
  heart: ['M20 33 C9 25 4 19 6 13 C8 7 16 6 20 13 C24 6 32 7 34 13 C36 19 31 25 20 33 Z'],
  plane: ['M4 19 L36 6 L28 33 L19 23 Z', 'M19 23 L36 6', 'M19 23 L17 31 L22 26'],
  trail: ['M3 32 C9 14 18 36 24 20 C27 12 31 9 36 8', 'M30 5 L36 8 L33 14'],
  pencil: ['M8 32 L10 24 L27 7 L33 13 L16 30 Z', 'M23 11 L29 17', 'M10 24 L16 30'],
};
---

<span class:list={['mk', 'pen-doodle', className]} aria-hidden="true"
  ><svg viewBox="0 0 40 40" focusable="false">{paths[kind].map((d) => <path d={d} pathLength="1" />)}</svg></span
>
