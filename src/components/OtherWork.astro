---
import { otherWork } from '../data/projects';
---

<section class="other" aria-labelledby="other-title">
  <h3 id="other-title" class="title">Smaller projects</h3>
  <ul class="rows">
    {
      otherWork.map((p) => (
        <li class="row">
          <h4>{p.title}</h4>
          <p class="sum">{p.summary}</p>
          <p class="tech">{p.stack.join(' · ')}</p>
          <p class="links">
            {p.links.map((l) => (
              <a class="text-link" href={l.href} target="_blank" rel="noopener">
                {l.label}
                <span class="visually-hidden"> for {p.title} (opens in a new tab)</span>
              </a>
            ))}
          </p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .other {
    padding-top: var(--space-7);
  }

  .title {
    font-size: var(--text-lg);
  }

  .rows {
    list-style: none;
    margin-top: var(--space-3);
    border-top: var(--border-hairline);
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-1) var(--space-6);
    padding-block: var(--space-4);
    border-bottom: var(--border-hairline);
    transition: background var(--duration-fast) var(--ease-out);
  }

  @media (min-width: 56rem) {
    .row {
      grid-template-columns: 14rem minmax(0, 1fr) 12rem 9rem;
      align-items: baseline;
    }
  }

  h4 {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 500;
    letter-spacing: 0;
  }

  .sum {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .tech {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    font-size: var(--text-sm);
  }

  @media (min-width: 56rem) {
    .links {
      justify-content: flex-end;
    }
  }
</style>
