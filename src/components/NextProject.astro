---
import { neighbors } from '../data/order';

interface Props {
  slug: string;
}
const { prev, next } = neighbors(Astro.props.slug);
---

<nav class="next wrap" aria-label="More projects">
  <a class="prev" href={`/work/${prev.slug}`}>
    <span class="label">Previous</span>
    <span class="title"><span aria-hidden="true">← </span>{prev.title}</span>
  </a>
  <a class="nxt" href={`/work/${next.slug}`}>
    <span class="label">Next</span>
    <span class="title">{next.title}<span aria-hidden="true"> →</span></span>
  </a>
</nav>

<style>
  .next {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    padding-block: var(--space-7) var(--space-9);
  }

  a {
    display: grid;
    gap: var(--space-1);
    padding-top: var(--space-4);
    border-top: var(--border-ink);
    text-decoration: none;
  }

  .nxt {
    text-align: right;
  }

  .title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    transition: color var(--duration-fast) var(--ease-out);
  }

  a:hover .title {
    color: var(--color-accent-ink);
  }
</style>
