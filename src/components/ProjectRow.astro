---
/* One line in the "also in the notebook" index. The whole row opens the project; hovering shows its screenshot. */
import { Image } from 'astro:assets';
import { projects, type Project } from '../data/projects';
import ProjectLinks from './ProjectLinks.astro';

interface Props {
  project: Project;
}
const { project } = Astro.props;
// The whole row opens its main destination: the case study, else the demo, else the source.
const href = project.caseStudy ? `/work/${project.slug}` : (project.demo ?? project.github)!;
const external = !project.caseStudy;
const v = project.visual;
const n = String(projects.findIndex((p) => p.slug === project.slug) + 1).padStart(2, '0');
---

<article class="row" id={`project-${project.slug}`} aria-labelledby={`${project.slug}-title`} data-project-id={`project:${project.slug}`}>
  <span class="n" aria-hidden="true">{n}</span>

  <div class="body">
    <h4 id={`${project.slug}-title`}>
      <a class="primary" href={href} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
        {project.title}
        {external && <span class="visually-hidden"> ({project.demo ? 'live demo' : 'source on GitHub'}, opens in a new tab)</span>}
      </a>
    </h4>
    <p class="summary">{project.summary}</p>
    <p class="stack-line">{project.tech.slice(0, 4).join(' · ')}</p>
  </div>

  <p class="result note">
    <span class="arrow" aria-hidden="true">→</span>
    {project.result.headline}
    {project.result.qualifier && <span class="q">{project.result.qualifier}</span>}
  </p>

  <div class="links-cell"><ProjectLinks project={project} /></div>

  {
    v.kind === 'image' && (
      <div class="peek" aria-hidden="true">
        <Image src={v.src} alt="" widths={[320, 640]} sizes="16rem" loading="lazy" />
      </div>
    )
  }
</article>

<style>
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-5);
    border-bottom: var(--border-hairline);
  }

  .result,
  .links-cell {
    grid-column: 2;
  }

  @media (min-width: 56rem) {
    .row {
      grid-template-columns: 2.25rem minmax(0, 1fr) 15rem;
      gap: var(--space-2) var(--space-6);
    }

    .result {
      grid-column: 3;
      grid-row: 1;
    }

    .links-cell {
      grid-column: 2;
    }
  }

  .n {
    padding-top: 0.45em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .body {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }

  h4 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 450;
    letter-spacing: -0.01em;
  }

  h4 a {
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  /* The title link stretches over the row; the secondary links sit above it, so nothing is nested. */
  .primary::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .primary:focus-visible {
    outline: none;
  }

  .row:has(.primary:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .links-cell {
    position: relative;
    z-index: 2;
  }

  .summary {
    max-width: 52ch;
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .stack-line {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-muted);
  }

  .result {
    align-self: start;
    padding-top: 0.35em;
    font-size: var(--text-xs);
  }

  .arrow {
    margin-right: 0.25em;
  }

  .q {
    display: block;
    color: var(--color-muted);
  }

  .row:hover h4 a {
    color: var(--pen-ink);
  }

  /* Hover peek: the screenshot slides in tilted, like a photo tucked into the page. Fine pointers only. */
  .peek {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 64rem) {
    .peek {
      display: block;
      position: absolute;
      right: calc(15rem + var(--space-7));
      top: 50%;
      z-index: 0;
      width: 15rem;
      padding: 6px 6px 18px;
      background: var(--color-surface);
      box-shadow: var(--shadow-md);
      opacity: 0;
      pointer-events: none;
      transform: translateY(-50%) rotate(-4deg) translateX(12px);
      transition: opacity var(--duration-base) var(--ease-out), transform var(--duration-base) var(--ease-out);
    }

    .peek :global(img) {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 10;
      object-fit: cover;
      object-position: top left;
    }

    .row:hover .peek {
      opacity: 1;
      transform: translateY(-50%) rotate(-3deg) translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .peek {
      transition: none;
    }
  }
</style>
