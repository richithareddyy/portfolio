---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
import ProjectLinks from './ProjectLinks.astro';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const href = project.caseStudy ? `/work/${project.slug}` : (project.demo ?? project.github);
const external = !project.caseStudy;
const v = project.visual;
---

<article
  class="card"
  id={`project-${project.slug}`}
  aria-labelledby={`${project.slug}-title`}
  data-project-id={`project:${project.slug}`}
>
  {
    v.kind === 'image' && (
      <a class="thumb" href={href} tabindex="-1" aria-hidden="true" {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
        <Image src={v.src} alt="" widths={[224, 448]} sizes="7rem" loading="lazy" />
      </a>
    )
  }

  <div class="body">
    <h4 id={`${project.slug}-title`}>
      {project.caseStudy ? <a href={`/work/${project.slug}`} transition:name={`title-${project.slug}`}>{project.title}</a> : project.title}
    </h4>
    <p class="summary">{project.summary}</p>
    <p class="result">
      <strong>{project.result.headline}</strong>
      {project.result.qualifier && <span>{project.result.qualifier}</span>}
    </p>
    <ul class="stack" aria-label={`${project.title} technologies`}>
      {project.tech.slice(0, 4).map((t) => <li>{t}</li>)}
    </ul>
    <ProjectLinks project={project} />
  </div>
</article>

<style>
  .card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-top: var(--border-hairline);
  }

  @media (min-width: 30rem) {
    .card {
      grid-template-columns: 7rem minmax(0, 1fr);
    }
  }

  .thumb {
    display: none;
    align-self: start;
    aspect-ratio: 16 / 10;
    overflow: clip;
    border: var(--border-hairline);
    border-radius: var(--radius-sm);
    background: var(--color-panel);
  }

  @media (min-width: 30rem) {
    .thumb {
      display: block;
    }
  }

  .thumb :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }

  /* Cards without a screenshot keep the text aligned with the others. */
  .card:not(:has(.thumb)) .body {
    grid-column: 1 / -1;
  }

  @media (min-width: 30rem) {
    .card:not(:has(.thumb)) .body {
      grid-column: 2;
    }
  }

  .body {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    justify-items: start;
    min-width: 0;
  }

  h4 {
    font-size: var(--text-lg);
    font-weight: 500;
  }

  h4 a {
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  h4 a:hover {
    color: var(--color-accent-ink);
  }

  .summary {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .result {
    font-size: var(--text-sm);
  }

  .result strong {
    font-weight: 600;
  }

  .result span {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .stack {
    font-size: var(--text-xs);
  }
</style>
