---
import type { Project } from '../data/projects';
import ProjectLinks from './ProjectLinks.astro';

interface Props {
  project: Project;
}
const { project } = Astro.props;
// The row links to the case study if there is one, else the demo, else the repo.
const href = project.caseStudy ? `/work/${project.slug}` : (project.demo ?? project.github)!;
const external = !project.caseStudy;
---

<article class="row" id={`project-${project.slug}`} aria-labelledby={`${project.slug}-title`} data-project-id={`project:${project.slug}`}>
  <div class="body">
    <h4 id={`${project.slug}-title`}>
      <a class="primary" href={href} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
        {project.title}
        {external && <span class="visually-hidden"> ({project.demo ? 'live demo' : 'source on GitHub'}, opens in a new tab)</span>}
      </a>
    </h4>
    <p class="summary">{project.summary}</p>
    <p class="stack-line">{project.tech.slice(0, 4).join(' · ')}</p>
  </div>

  <p class="result note">
    <span class="arrow" aria-hidden="true">→</span>
    {project.result.headline}
    {project.result.qualifier && <span class="q">{project.result.qualifier}</span>}
  </p>

  <div class="links-cell"><ProjectLinks project={project} /></div>

</article>

<style>
  .row {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-5);
    border-bottom: var(--border-hairline);
  }

  @media (min-width: 56rem) {
    .row {
      grid-template-columns: minmax(0, 1fr) 15rem;
      gap: var(--space-2) var(--space-6);
    }

    .result {
      grid-column: 2;
      grid-row: 1;
    }

    .links-cell {
      grid-column: 1;
    }
  }

  /* A pen-wash highlight that sweeps in behind the hovered row. */
  .row::before {
    content: '';
    position: absolute;
    inset: 0 calc(var(--space-3) * -1);
    z-index: -1;
    border-radius: var(--radius-sm);
    background: var(--pen-wash);
    opacity: 0;
    transform: scaleX(0.6);
    transform-origin: left;
    transition: opacity var(--duration-base) var(--ease-out), transform var(--duration-slow) var(--ease-out);
  }

  /* Like a page lifting off the desk: on hover, and when keyboard focus is inside the row. */
  .row {
    transition: transform var(--duration-base) var(--ease-out);
  }

  .row:hover,
  .row:focus-within {
    z-index: 1;
    transform: translateY(-2px);
  }

  .row:hover::before,
  .row:focus-within::before {
    opacity: 0.45;
    transform: none;
    box-shadow: 0 10px 20px -14px rgb(25 25 21 / 0.35);
  }

  @media (prefers-reduced-motion: reduce) {
    .row:hover,
    .row:focus-within {
      transform: none;
    }
  }

  .body {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }

  h4 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 450;
    letter-spacing: -0.01em;
  }

  h4 a {
    text-decoration: none;
    background-image: linear-gradient(var(--pen), var(--pen));
    background-size: 0 2px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition: color var(--duration-fast) var(--ease-out), background-size var(--duration-base) var(--ease-out);
  }

  .row:hover h4 a {
    background-size: 100% 2px;
  }

  /* The title link stretches over the row; the secondary links sit above it, so nothing is nested. */
  .primary::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .primary:focus-visible {
    outline: none;
  }

  .row:has(.primary:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .links-cell {
    position: relative;
    z-index: 2;
  }

  .summary {
    max-width: 52ch;
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .stack-line {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-muted);
  }

  .result {
    align-self: start;
    padding-top: 0.35em;
    font-size: var(--text-xs);
  }

  .arrow {
    display: inline-block;
    margin-right: 0.25em;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .row:hover .arrow {
    transform: translateX(3px);
  }

  .q {
    display: block;
    color: var(--color-muted);
  }

  .row:hover h4 a {
    color: var(--pen-ink);
  }
</style>
