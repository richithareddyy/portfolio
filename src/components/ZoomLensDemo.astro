---
/*
  An illustration of the Zoom Lens side panel. The chart and the responses are
  example content written for this page; they are not captured output.
*/
const bars = [
  { q: 'Q1', v: 1240 },
  { q: 'Q2', v: 1580 },
  { q: 'Q3', v: 2110 },
  { q: 'Q4', v: 1960 },
];
const max = 2500;

const responses = {
  describe: {
    label: 'Describe',
    timing: '≈ 6 s in the app',
    text: 'A bar chart titled “Sign-ups by quarter.” Four bars: Q1 1,240 · Q2 1,580 · Q3 2,110 · Q4 1,960. The y-axis runs from 0 to 2,500.',
  },
  explain: {
    label: 'Explain',
    timing: '≈ 10 s in the app',
    text: 'Growth sped up between Q2 and Q3 (+34%), then eased in Q4 (−7%). The chart’s point is that Q3 was the peak — not that growth stopped.',
  },
  followup: {
    label: 'Follow-up',
    timing: 'one question about the last answer',
    question: 'Is the Q4 drop a big deal?',
    text: 'Not relative to the year: Q4 is still the second-highest quarter, about 58% above Q1.',
  },
} as const;
---

<figure class="demo" data-zl-demo>
  <div class="window" role="group" aria-label="Illustration of a Zoom meeting with the Zoom Lens panel open">
    <div class="titlebar" aria-hidden="true">
      <span class="dots"><i></i><i></i><i></i></span>
      <span class="title">Weekly review · Maya is sharing</span>
    </div>

    <div class="body">
      <div class="share" aria-hidden="true">
        <p class="share-title">Sign-ups by quarter</p>
        <div class="chart">
          <div class="axis">
            <span>2,500</span><span>1,250</span><span>0</span>
          </div>
          <div class="bars">
            {
              bars.map((b) => (
                <div class="bar-col">
                  <div class="bar" style={`--h:${(b.v / max) * 100}%`} />
                  <span>{b.q}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <aside class="panel" aria-label="Zoom Lens panel">
        <p class="panel-name">Zoom Lens</p>
        <div class="modes" role="group" aria-label="Choose an action">
          {
            (Object.keys(responses) as (keyof typeof responses)[]).map((key, i) => (
              <button type="button" class="mode" data-mode={key} aria-pressed={i === 0 ? 'true' : 'false'}>
                {responses[key].label}
              </button>
            ))
          }
        </div>

        <div class="answer" aria-live="polite">
          {
            (Object.keys(responses) as (keyof typeof responses)[]).map((key, i) => {
              const r = responses[key];
              return (
                <div class="answer-body" data-answer={key} hidden={i !== 0}>
                  {'question' in r && <p class="q">“{r.question}”</p>}
                  <p class="a">{r.text}</p>
                  <p class="timing">{r.timing}</p>
                </div>
              );
            })
          }
          <div class="thinking" aria-hidden="true"><i></i><i></i><i></i></div>
        </div>

        <p class="private">
          <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
            <rect x="3" y="7" width="10" height="7" rx="1" fill="none" stroke="currentColor" stroke-width="1.4"></rect>
            <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" fill="none" stroke="currentColor" stroke-width="1.4"></path>
          </svg>
          Visible only to you
        </p>
      </aside>
    </div>
  </div>
  <figcaption>
    Illustration of the interaction. The chart and responses are examples written for this page, not captured output.
  </figcaption>
</figure>

<script>
  function setupDemo() {
    document.querySelectorAll<HTMLElement>('[data-zl-demo]:not([data-ready])').forEach((demo) => {
      demo.dataset.ready = 'true';
      const buttons = demo.querySelectorAll<HTMLButtonElement>('[data-mode]');
      const answers = demo.querySelectorAll<HTMLElement>('[data-answer]');
      const answerBox = demo.querySelector<HTMLElement>('.answer');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let timer: number | undefined;

      const show = (mode: string) => {
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === mode)));
        window.clearTimeout(timer);
        const reveal = () => {
          answerBox?.classList.remove('is-thinking');
          answers.forEach((a) => (a.hidden = a.dataset.answer !== mode));
        };
        if (reduce) return reveal();
        answers.forEach((a) => (a.hidden = true));
        answerBox?.classList.add('is-thinking');
        timer = window.setTimeout(reveal, 650);
      };

      buttons.forEach((button) => {
        button.addEventListener('click', () => show(button.dataset.mode ?? 'describe'));
      });
    });
  }
  document.addEventListener('astro:page-load', setupDemo);
</script>

<style>
  .demo {
    margin: 0;
  }

  .window {
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--illus-frame);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--illus-frame-edge);
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    color: var(--illus-ink-muted);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    border-bottom: 1px solid var(--illus-frame-edge);
  }

  .dots {
    display: inline-flex;
    gap: 5px;
  }

  .dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--illus-dot);
  }

  .title {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(9.5rem, 38%);
    min-height: 17rem;
  }

  .share {
    display: flex;
    flex-direction: column;
    margin: var(--space-3);
    padding: var(--space-4);
    background: var(--illus-screen);
    color: var(--illus-screen-ink);
    border-radius: var(--radius-xs);
  }

  .share-title {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    font-weight: 500;
    margin-bottom: var(--space-3);
  }

  .chart {
    flex: 1;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2);
    min-height: 9rem;
  }

  .axis {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-bottom: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--illus-screen-muted);
    text-align: right;
  }

  .bars {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
    border-left: 1px solid var(--illus-screen-rule);
    border-bottom: 1px solid var(--illus-screen-rule);
    padding: 0 var(--space-2);
    margin-bottom: 1.25rem;
    position: relative;
  }

  .bar-col {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .bar {
    width: 100%;
    max-width: 2.25rem;
    height: var(--h);
    background: var(--illus-bar);
    border-radius: 1px 1px 0 0;
  }

  .bar-col:nth-child(3) .bar {
    background: var(--color-accent);
  }

  .bar-col span {
    position: absolute;
    bottom: -1.25rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--illus-screen-muted);
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--illus-panel);
    border-left: 1px solid var(--illus-frame-edge);
    color: var(--illus-ink);
  }

  .panel-name {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--illus-ink-muted);
  }

  .modes {
    display: grid;
    gap: var(--space-1);
  }

  .mode {
    min-height: 2.25rem;
    padding: var(--space-1) var(--space-3);
    text-align: left;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--illus-ink);
    background: transparent;
    border: 1px solid var(--illus-control);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out);
  }

  .mode:hover {
    border-color: var(--illus-control-hover);
  }

  .mode[aria-pressed='true'] {
    background: var(--illus-ink);
    color: var(--illus-screen-ink);
    border-color: var(--illus-ink);
  }

  .mode:focus-visible {
    outline-color: var(--illus-focus);
  }

  .answer {
    position: relative;
    flex: 1;
    min-height: 7.5rem;
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .answer-body {
    animation: fade-in var(--duration-base) var(--ease-out);
  }

  .q {
    color: var(--illus-ink-muted);
    font-style: italic;
    margin-bottom: var(--space-1);
  }

  .a {
    color: var(--illus-ink);
  }

  .timing {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--illus-ink-faint);
  }

  .thinking {
    display: none;
    gap: 4px;
    padding-top: var(--space-1);
  }

  .is-thinking .thinking {
    display: flex;
  }

  .thinking i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--illus-ink-muted);
    animation: pulse 900ms var(--ease-out) infinite;
  }

  .thinking i:nth-child(2) {
    animation-delay: 150ms;
  }

  .thinking i:nth-child(3) {
    animation-delay: 300ms;
  }

  .private {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: 0.6875rem;
    color: var(--illus-ink-faint);
    border-top: 1px solid var(--illus-line);
    padding-top: var(--space-2);
  }

  figcaption {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 0.25;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 30rem) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }

    .panel {
      border-left: 0;
      border-top: 1px solid var(--illus-frame-edge);
    }

    .modes {
      grid-template-columns: repeat(3, 1fr);
    }

    .mode {
      text-align: center;
      padding-inline: var(--space-1);
      font-size: var(--text-xs);
    }

    .answer {
      min-height: 6rem;
    }
  }
</style>
