---
import { profile } from '../data/profile';
import Doodle from './Doodle.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <p class="wrap fin">Thanks for reading<Doodle kind="heart" class="is-drawn" /></p>
  <div class="wrap row">
    <p>© {year} {profile.name} <span class="aside">· <a href="#top">back to the top ↑</a></span></p>
    <ul>
      <li><a href={`mailto:${profile.email}`}>Email</a></li>
      <li><a href={profile.links.github} rel="me noopener" target="_blank">GitHub</a></li>
      <li><a href={profile.links.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
      <li><a href={profile.links.resume} target="_blank" rel="noopener">Résumé</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--border-hairline);
    padding-block: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .fin {
    margin-bottom: var(--space-5);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lg);
    color: var(--color-ink-soft);
    text-align: center;
  }

  .fin :global(.pen-doodle) {
    width: 1em;
    height: 1em;
    margin-left: 0.3em;
    vertical-align: -0.15em;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    justify-content: space-between;
    align-items: center;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    list-style: none;
  }

  a {
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  a:hover {
    color: var(--color-ink);
    text-decoration: underline;
  }
</style>
