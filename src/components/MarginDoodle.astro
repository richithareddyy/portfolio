---
/*
  A pencil sketch that sits in the page margin beside a section heading. It wakes up in the pen color when the
  pointer comes near, or for a few seconds after a tap on touch screens. Decorative only.
*/
interface Props {
  kind: 'bell' | 'net' | 'mug' | 'scatter';
  side?: 'left' | 'right';
}
const { kind, side = 'left' } = Astro.props;
const filter = `pencil-${kind}`;
---

<span class:list={['margin-doodle', `md-${kind}`, `md-${side}`]} aria-hidden="true" data-margin-doodle>
  <svg viewBox="0 0 80 64" focusable="false">
    <defs>
      <filter id={filter} x="-10%" y="-10%" width="120%" height="120%">
        <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="2" seed="3" result="grain" />
        <feDisplacementMap in="SourceGraphic" in2="grain" scale="1.4" />
      </filter>
    </defs>
    <g filter={`url(#${filter})`}>
      {
        kind === 'bell' && (
          <>
            <path class="area" d="M8 54 C22 54 26 12 40 12 C54 12 58 54 72 54 Z" />
            <path class="axis" d="M4 54.5 H76" />
            <path class="line draw" pathLength="1" d="M8 54 C22 54 26 12 40 12 C54 12 58 54 72 54" />
            <path class="axis mean" d="M40 14 V54" />
            <path class="tick" d="M25 52 V56 M55 52 V56" />
          </>
        )
      }
      {
        kind === 'net' && (
          <>
            <path class="edge" d="M14 18 L40 12 M14 18 L40 32 M14 18 L40 52 M14 46 L40 12 M14 46 L40 32 M14 46 L40 52 M40 12 L66 32 M40 32 L66 32 M40 52 L66 32" />
            <circle class="node n1" cx="14" cy="18" r="5" />
            <circle class="node n1" cx="14" cy="46" r="5" />
            <circle class="node n2" cx="40" cy="12" r="5" />
            <circle class="node n2" cx="40" cy="32" r="5" />
            <circle class="node n2" cx="40" cy="52" r="5" />
            <circle class="node n3" cx="66" cy="32" r="5.5" />
          </>
        )
      }
      {
        kind === 'mug' && (
          <>
            <path class="steam s1" d="M30 24 C26 19 34 16 30 10" />
            <path class="steam s2" d="M38 24 C34 18 42 15 38 8" />
            <path class="steam s3" d="M46 24 C42 19 50 16 46 10" />
            <path class="line" d="M22 28 H56 V48 C56 54 51 58 45 58 H33 C27 58 22 54 22 48 Z" />
            <path class="line" d="M56 33 C64 33 66 37 66 40 C66 45 62 48 56 47" />
            <path class="axis" d="M16 60.5 H70" />
          </>
        )
      }
      {
        kind === 'scatter' && (
          <>
            <path class="axis" d="M10 8 V56 H74" />
            <path class="line fit draw" pathLength="1" d="M14 52 C30 44 48 30 70 14" />
            <circle class="dot d1" cx="18" cy="47" r="2.4" />
            <circle class="dot d2" cx="27" cy="45" r="2.4" />
            <circle class="dot d3" cx="34" cy="36" r="2.4" />
            <circle class="dot d4" cx="44" cy="36" r="2.4" />
            <circle class="dot d5" cx="52" cy="24" r="2.4" />
            <circle class="dot d6" cx="63" cy="22" r="2.4" />
          </>
        )
      }
    </g>
  </svg>
</span>

<script>
  // Touch screens have no hover, so a tap plays the sketch for a moment instead.
  for (const doodle of document.querySelectorAll<HTMLElement>('[data-margin-doodle]')) {
    let timer: number | undefined;
    doodle.addEventListener('click', () => {
      doodle.classList.remove('is-playing');
      void doodle.offsetWidth;
      doodle.classList.add('is-playing');
      clearTimeout(timer);
      timer = window.setTimeout(() => doodle.classList.remove('is-playing'), 2800);
    });
  }
</script>

<style>
  /* Inline at the end of the section label on smaller screens; out in the page margin on wide ones. */
  .margin-doodle {
    flex: none;
    align-self: center;
    display: block;
    width: 3.25rem;
    margin: -0.75rem -0.75rem -0.75rem auto;
    padding: 0.75rem;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  @media (min-width: 48rem) {
    .margin-doodle {
      width: 4.25rem;
    }
  }

  @media (min-width: 87.5rem) {
    .margin-doodle {
      position: absolute;
      top: -1.25rem;
      width: 6.5rem;
      margin: 0;
      padding: 1.25rem;
    }

    .md-left {
      right: calc(100% + 0.5rem);
    }

    .md-right {
      left: calc(100% + 0.5rem);
    }
  }

  svg {
    display: block;
    width: 100%;
    overflow: visible;
    fill: none;
    stroke: var(--color-faint);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.7;
    transform: rotate(-4deg);
    transition: opacity var(--duration-base) var(--ease-out), stroke var(--duration-base) var(--ease-out);
  }

  .md-right svg {
    transform: rotate(4deg);
  }

  .axis {
    stroke-width: 1;
  }

  .mean {
    stroke-dasharray: 2 3;
  }

  .area {
    stroke: none;
    fill: var(--pen-wash);
    opacity: 0;
    transition: opacity var(--duration-slow) var(--ease-out);
  }

  .node,
  .dot {
    fill: var(--color-bg);
    transform-box: fill-box;
    transform-origin: center;
  }

  .dot {
    fill: var(--color-faint);
    stroke: none;
  }

  /* Awake: the pointer is near, or a tap just happened. */
  .margin-doodle:hover svg,
  .is-playing svg {
    opacity: 1;
    stroke: var(--pen);
  }

  .margin-doodle:hover .dot,
  .is-playing .dot {
    fill: var(--pen);
  }

  .margin-doodle:hover .area,
  .is-playing .area {
    opacity: 0.9;
  }

  @media (prefers-reduced-motion: no-preference) {
    .draw {
      stroke-dasharray: 1;
      stroke-dashoffset: 0;
    }

    /* Bell curve: redrawn left to right, then the spread ticks nod. */
    .md-bell.is-playing .draw,
    .md-bell:hover .draw {
      animation: redraw 1.2s var(--ease-out) both;
    }

    .md-bell:hover .tick,
    .md-bell.is-playing .tick {
      animation: nod 1.2s var(--ease-out) 0.6s infinite alternate;
    }

    /* Neural net: a signal flows along the edges while each layer pulses in turn. */
    .md-net:hover .edge,
    .md-net.is-playing .edge {
      stroke-dasharray: 3 3;
      animation: flow 0.9s linear infinite;
    }

    .md-net:hover .node,
    .md-net.is-playing .node {
      animation: pulse 1.5s var(--ease-out) infinite;
    }

    .md-net:hover .n2,
    .md-net.is-playing .n2 {
      animation-delay: 0.25s;
    }

    .md-net:hover .n3,
    .md-net.is-playing .n3 {
      animation-delay: 0.5s;
    }

    /* Coffee mug: steam drifts up and fades, one wisp after another. */
    .steam {
      opacity: 0.55;
    }

    .md-mug:hover .steam,
    .md-mug.is-playing .steam {
      animation: steam 1.8s ease-in-out infinite;
    }

    .md-mug:hover .s2,
    .md-mug.is-playing .s2 {
      animation-delay: 0.45s;
    }

    .md-mug:hover .s3,
    .md-mug.is-playing .s3 {
      animation-delay: 0.9s;
    }

    /* Scatter plot: the points land, then the fit line is drawn through them. */
    .md-scatter:hover .dot,
    .md-scatter.is-playing .dot {
      animation: land 0.45s var(--ease-out) both;
    }

    .md-scatter .d2 { animation-delay: 0.06s; }
    .md-scatter .d3 { animation-delay: 0.12s; }
    .md-scatter .d4 { animation-delay: 0.18s; }
    .md-scatter .d5 { animation-delay: 0.24s; }
    .md-scatter .d6 { animation-delay: 0.3s; }

    .md-scatter:hover .draw,
    .md-scatter.is-playing .draw {
      animation: redraw 0.9s var(--ease-out) 0.35s both;
    }
  }

  @keyframes redraw {
    from {
      stroke-dashoffset: 1;
    }

    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes nod {
    to {
      transform: translateY(-1.5px);
    }
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -6;
    }
  }

  @keyframes pulse {
    0%,
    100% {
      transform: scale(1);
      fill: var(--color-bg);
    }

    40% {
      transform: scale(1.3);
      fill: var(--pen-wash);
    }
  }

  @keyframes steam {
    0% {
      opacity: 0;
      transform: translateY(3px);
    }

    35% {
      opacity: 0.9;
    }

    100% {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @keyframes land {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.6);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
